<%= render layout: 'shared/payment_index_header',
           locals: { title: 'Recharge payments', count: @payment_count, total_amount: @total_amount } do %>
  <% if can?(:'payments.sync') %>
    <%= button_to 'Sync now', sync_recharge_payments_path, method: :post,
                  class: 'btn btn-primary btn-sm', data: { turbo: false } %>
  <% end %>
  <% if can?(:'payments.import_export') || current_user_admin? %>
    <div class="dropdown">
      <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="dropdown"
              aria-expanded="false" aria-label="More actions">&hellip;</button>
      <ul class="dropdown-menu dropdown-menu-end">
        <% if can?(:'payments.import_export') %>
          <li><%= link_to 'Export JSON', export_recharge_payments_path, class: 'dropdown-item', data: { turbo: false } %></li>
          <li>
            <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#importModal">
              Import JSON
            </button>
          </li>
        <% end %>
        <% if current_user_admin? %>
          <li><%= link_to 'Test', test_recharge_payments_path, class: 'dropdown-item' %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
<% end %>

<% if @filter_active %>
  <% filter_label = { 'yes' => 'Linked', 'no' => 'Unlinked', 'dont_link' => "Don't link" }[params[:linked]] %>
  <%= render 'shared/payment_filter_banner', label: "#{filter_label || 'Searched'} payments",
             shown: @payment_count, total: @total_count, clear_path: recharge_payments_path %>
<% end %>

<%= render 'shared/payment_filter_tiles', tiles: [
      { label: 'All', count: @total_count, path: recharge_payments_path, active: params[:linked].blank? },
      { label: 'Linked', count: @linked_count, path: recharge_payments_path(linked: 'yes'),
        active: params[:linked] == 'yes' },
      { label: 'Unlinked', count: @unlinked_count, path: recharge_payments_path(linked: 'no'),
        active: params[:linked] == 'no', variant: 'warning' },
      { label: "Don't link", count: @dont_link_count, path: recharge_payments_path(linked: 'dont_link'),
        active: params[:linked] == 'dont_link' }
    ] %>

<!-- Import Modal -->
<div class="modal fade" id="importModal" tabindex="-1" aria-labelledby="importModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="importModalLabel">Import Recharge Payments from JSON</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <%= form_with url: import_recharge_payments_path, method: :post, multipart: true, local: true do |f| %>
        <div class="modal-body">
          <p class="text-muted">Select a JSON backup file to import. This will update existing payments and create new ones based on <code>recharge_id</code>.</p>
          <div class="mb-3">
            <%= f.file_field :file, accept: 'application/json', class: "form-control", required: true %>
          </div>
          <div class="alert alert-warning mb-0">
            <strong>Warning:</strong> This operation will modify the database. Existing payments with matching <code>recharge_id</code> will be updated.
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <%= f.submit "Import", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<%= render 'shared/payment_search', url: recharge_payments_path, frame: 'recharge_payments_results',
           placeholder: 'Search by charge ID, customer name, full email, or status…' %>

<%= turbo_frame_tag 'recharge_payments_results' do %>
  <% if @payments.any? %>
    <%= render layout: 'shared/payment_table',
               locals: { body_id: 'recharge_payments_table_body',
                         headers: ['Charge', 'Status', ['Amount', 'num'], 'Member', 'Processed'] } do %>
      <% @payments.each do |payment| %>
        <% unlinked = payment.user.blank? && !payment.dont_link? %>
        <tr class="recharge-payment-row <%= 'row-attention' if unlinked %>"
            data-live-filter-target="item"
            data-search-text="<%= [
              payment.recharge_id,
              payment.customer_name,
              payment.status.presence || 'unknown',
              payment.amount_with_currency,
              payment.user&.display_name,
              payment.user_id.present? ? 'linked' : 'unlinked'
            ].compact.join(' ').downcase %>">
          <td>
            <%= link_to payment.recharge_id, recharge_payment_path(payment),
                        class: 'fw-medium text-decoration-none', data: { turbo_frame: '_top' } %>
          </td>
          <td><%= payment_status_cell(payment.status) %></td>
          <td class="num"><%= payment_money_tag(payment.amount, payment.currency) %></td>
          <td class="recharge-payment-member">
            <%= render 'shared/payment_member_cell', payment: payment, name: payment.customer_name,
                       link_path: recharge_payment_path(payment), unlinked: unlinked,
                       empty_label: 'Unnamed customer' %>
          </td>
          <td><%= payment_time_tag(payment.processed_at) %></td>
        </tr>
      <% end %>
    <% end %>
  <% else %>
    <%= render 'shared/payment_empty', icon: 'arrow-repeat',
               message: 'No Recharge payments match these filters.' %>
  <% end %>
  <%= render 'shared/pagination', pagy: @pagy %>
<% end %>
