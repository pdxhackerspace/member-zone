<div class="d-flex align-items-end justify-content-between mb-3">
  <div>
    <h1 class="h-page-title mb-0">Reminders</h1>
    <div class="text-13 text-secondary mt-1">
      <span class="text-body"><%= @reminder_settings.size %></span> configured
    </div>
  </div>
  <div>
    <%= link_to "Back to Settings", settings_path, class: "btn btn-outline-secondary btn-sm" %>
  </div>
</div>

<% unless @slack_source_enabled %>
  <div class="alert alert-secondary text-13 py-2 mb-3">
    Slack member source is disabled. Preview counts still reflect members who would be eligible if Slack were enabled.
  </div>
<% end %>

<% unless @building_access_topic %>
  <div class="alert alert-warning text-13 py-2 mb-3">
    No building access training topic is set, so orientation is judged on membership state alone.
    <%= link_to "Set one in Membership settings", membership_settings_path, class: "alert-link" %>.
  </div>
<% end %>

<% @reminder_settings.each do |reminder| %>
  <% case reminder.key %>
  <% when 'slack_signup' %>
    <%= render layout: 'reminder_card', locals: { reminder: reminder, email_template: @slack_email_template } do %>
      <div class="text-13">
        <span class="fw-medium text-body"><%= @slack_due_count %></span>
        <span class="text-secondary">would be emailed today ·</span>
        <span class="text-secondary"><%= @slack_without_slack_count %> active without Slack</span>
      </div>
      <div class="text-12 text-secondary mt-1">
        Timing:
        <%= @membership_setting.slack_signup_reminder_initial_delay_days %> days after approval,
        every <%= @membership_setting.slack_signup_reminder_repeat_delay_days %> days,
        members who joined within <%= @membership_setting.slack_signup_reminder_max_account_age_months %> <%= 'month'.pluralize(@membership_setting.slack_signup_reminder_max_account_age_months) %>
        · <%= link_to "Edit in Membership settings", membership_settings_path, class: "text-secondary" %>
      </div>
    <% end %>
  <% when 'application_link' %>
    <%= render layout: 'reminder_card', locals: { reminder: reminder, email_template: @application_link_email_template } do %>
      <div class="text-13">
        <span class="fw-medium text-body"><%= @application_link_due_count %></span>
        <span class="text-secondary">would be emailed today ·</span>
        <span class="text-secondary"><%= @application_link_awaiting_count %> awaiting application</span>
      </div>
      <div class="text-12 text-secondary mt-1">
        Timing:
        every <%= @membership_setting.application_link_reminder_delay_days %> days,
        up to <%= @membership_setting.application_link_reminder_max_count %> reminders
        · <%= link_to "Edit in Membership settings", membership_settings_path, class: "text-secondary" %>
      </div>
    <% end %>
  <% when 'payment_overdue' %>
    <%= render layout: 'reminder_card', locals: { reminder: reminder, email_template: @payment_overdue_email_template } do %>
      <div class="text-13">
        <span class="fw-medium text-body"><%= @payment_overdue_due_count %></span>
        <span class="text-secondary">would be emailed today ·</span>
        <span class="text-secondary"><%= @payment_overdue_total_count %> overdue</span>
      </div>
      <div class="text-12 text-secondary mt-1">
        Timing:
        every <%= @membership_setting.payment_overdue_reminder_repeat_days %> days while overdue,
        stopping after <%= @membership_setting.overdue_grace_period_days %> days when they become inactive
        · <%= link_to "Edit in Membership settings", membership_settings_path, class: "text-secondary" %>
      </div>
    <% end %>
  <% when 'orientation' %>
    <%= render layout: 'reminder_card', locals: { reminder: reminder, email_template: @orientation_email_template } do %>
      <div class="text-13">
        <span class="fw-medium text-body"><%= @orientation_due_count %></span>
        <span class="text-secondary">would be emailed today ·</span>
        <span class="text-secondary"><%= @orientation_awaiting_count %> awaiting orientation</span>
      </div>
      <div class="text-12 text-secondary mt-1">
        Timing:
        every <%= @membership_setting.orientation_reminder_repeat_days %> days after approval,
        stopping after <%= @membership_setting.new_member_expiry_days %> days when they become inactive
        · <%= link_to "Edit in Membership settings", membership_settings_path, class: "text-secondary" %>
      </div>
    <% end %>
  <% when 'parking_notices' %>
    <%= render layout: 'reminder_card', locals: { reminder: reminder, email_template: @parking_expiring_soon_template } do %>
      <div class="text-13">
        <span class="fw-medium text-body"><%= @parking_due_count %></span>
        <span class="text-secondary">would be emailed today ·</span>
        <span class="text-secondary"><%= @parking_awaiting_count %> active or expired, not cleared</span>
      </div>
      <div class="text-12 text-secondary mt-1">
        Timing:
        <%= @membership_setting.parking_notice_reminder_days_before_expiration %> days before expiration,
        at expiration,
        every <%= @membership_setting.parking_notice_expired_reminder_repeat_days %> days after,
        final at <%= @membership_setting.parking_notice_final_reminder_days_after_expiration %> days
        · <%= link_to "Edit in Membership settings", membership_settings_path, class: "text-secondary" %>
      </div>
      <div class="text-12 text-secondary mt-1">
        Issued emails on creation are always sent and are not controlled by this toggle.
      </div>
    <% end %>
  <% end %>
<% end %>
