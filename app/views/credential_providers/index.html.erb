<div class="d-flex align-items-end justify-content-between mb-3">
  <div>
    <h1 class="h-page-title mb-0">Credential providers</h1>
    <div class="text-13 text-secondary mt-1">
      Programs that issue API keys, app passwords and other credentials to members.
    </div>
  </div>
  <div class="d-flex gap-2">
    <%= link_to "New provider", new_credential_provider_path, class: "btn btn-primary btn-sm" %>
    <% if can?(:'credentials.view_all') %>
      <%= link_to "Issued credentials", issued_credentials_path, class: "btn btn-outline-secondary btn-sm" %>
    <% end %>
    <%= link_to "Settings", settings_path, class: "btn btn-outline-secondary btn-sm" %>
  </div>
</div>

<% if @providers.any? %>
  <div class="card shadow-sm border-0">
    <div class="table-responsive">
      <table class="table table-compact mb-0 align-middle">
        <thead>
          <tr>
            <th scope="col">Name</th>
            <th scope="col">Program</th>
            <th scope="col">Health</th>
            <th scope="col">Last checked</th>
            <th scope="col" class="num">Live credentials</th>
            <th scope="col" class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @providers.each do |provider| %>
            <tr class="<%= 'text-secondary' unless provider.enabled? %>">
              <td>
                <%= link_to provider.name, credential_provider_path(provider), class: "fw-medium text-decoration-none" %>
                <% unless provider.enabled? %><span class="badge text-bg-secondary-subtle ms-1">Disabled</span><% end %>
                <% unless provider.self_service? %>
                  <div class="text-12 text-secondary">Issued by administrators only</div>
                <% end %>
              </td>
              <td><code><%= File.basename(provider.script_path) %></code></td>
              <td>
                <span class="status-dot status-<%= provider.health_dot_class %>"></span>
                <%= provider.health_label %>
              </td>
              <td class="text-secondary">
                <%= provider.last_health_check_at ? l(provider.last_health_check_at, format: :short) : 'Never' %>
              </td>
              <td class="num <%= 'text-secondary' if @live_counts.fetch(provider.id, 0).zero? %>">
                <%= @live_counts.fetch(provider.id, 0) %>
              </td>
              <td class="text-end">
                <%= link_to "Edit", edit_credential_provider_path(provider), class: "btn btn-outline-secondary btn-sm" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% else %>
  <div class="card shadow-sm border-0">
    <div class="card-body text-center py-5 text-secondary">
      No providers yet. A provider is an executable program in <code>scripts/credentials</code> (or a directory named
      by <code>CREDENTIAL_SCRIPTS_DIR</code>) that issues credentials from one external system.
      <div class="mt-3"><%= link_to "Add a provider", new_credential_provider_path, class: "btn btn-primary btn-sm" %></div>
    </div>
  </div>
<% end %>
