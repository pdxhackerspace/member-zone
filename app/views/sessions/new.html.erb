<% default_settings = DefaultSetting.instance %>
<% login_message = TextFragment.content_for('login_screen_message') %>
<% keyfob_enabled = default_settings.login_keyfob_sign_in_enabled? %>
<% background_image_style = if default_settings.login_background_image.attached?
                              "background-image: url(#{url_for(default_settings.login_background_image)}); background-size: cover; background-position: center;"
                            end %>

<div class="row justify-content-center py-5 rounded-3" style="<%= background_image_style %>">
  <div class="col-12 col-md-7 col-lg-5">
    <div class="card shadow-sm border-0">
      <div class="card-body p-4">
        <% if default_settings.login_branding_image.attached? %>
          <div class="text-center mb-3">
            <%= image_tag default_settings.login_branding_image, alt: "Organization branding", class: "img-fluid", style: "max-height: 88px;" %>
          </div>
        <% end %>

        <div class="text-center mb-4">
          <%= link_to "Apply for Membership", apply_path, class: "btn btn-success btn-lg w-100" %>
        </div>

        <h1 class="h4 mb-3 text-center">Existing Members Sign In</h1>

        <% if login_message.present? %>
          <div class="alert alert-secondary mb-4">
            <%= sanitize(login_message) %>
          </div>
        <% end %>

        <hr class="my-4">
        <p class="text-muted text-center mb-3">Continue with sign-in options</p>

        <% if local_auth_enabled? %>
          <% if @login_error.present? %>
            <div class="alert alert-danger py-2 px-3 mb-3" role="alert">
              <%= @login_error %>
            </div>
          <% end %>

          <%= form_with url: local_login_path, scope: :session, data: { turbo: false }, class: "mb-4" do |form| %>
            <div class="mb-3">
              <%= form.label :email, class: "form-label" %>
              <%= form.email_field :email, value: params.dig(:session, :email), class: "form-control", autofocus: true, required: true %>
            </div>
            <div class="mb-3">
              <div class="d-flex justify-content-between">
                <%= form.label :password, class: "form-label" %>
                <span class="text-muted small">Test accounts only</span>
              </div>
              <%= form.password_field :password, class: "form-control", required: true %>
            </div>
            <%= form.submit "Sign in locally", class: "btn btn-primary w-100" %>
          <% end %>
        <% end %>

        <% if authentik_enabled? %>
          <div class="text-center">
            <p class="text-muted mb-2">or</p>
            <%= link_to "Continue with Authentik", "/auth/authentik", class: "btn btn-outline-secondary w-100" %>
          </div>
        <% elsif !local_auth_enabled? %>
          <p class="text-danger text-center mb-0">
            No authentication methods are currently configured.
          </p>
        <% end %>

        <hr class="my-4">

        <div class="mb-4">
          <p class="text-muted text-center mb-2">Sign in via email link</p>
          <%= form_with url: request_login_link_path, method: :post, local: true do |f| %>
            <div class="mb-2">
              <input type="text" name="identifier" class="form-control"
                     placeholder="Email or username" required autocomplete="email">
            </div>
            <button type="submit" class="btn btn-outline-primary w-100">
              <i class="bi bi-envelope me-1"></i> Send Login Link
            </button>
          <% end %>
        </div>

        <% if keyfob_enabled %>
          <hr class="my-4">
          <div class="text-center">
            <%= button_to "Sign In with Keyfob", rfid_login_path, method: :post, class: "btn btn-outline-primary w-100", data: { turbo: false } %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

