<% navigation_view = @user == current_user ? :self : params[:view_as] %>

<ul class="nav nav-tabs mb-3 small" role="tablist">
  <li class="nav-item" role="presentation">
    <%= link_to user_path(@user, tab: :dashboard, view_as: navigation_view),
        class: "nav-link #{'active' if @active_tab == :dashboard}",
        role: "tab" do %>
      Dashboard
    <% end %>
  </li>
  <li class="nav-item" role="presentation">
    <%= link_to user_path(@user, tab: :profile, view_as: navigation_view),
        class: "nav-link #{'active' if @active_tab == :profile}",
        role: "tab" do %>
      Profile
    <% end %>
  </li>
  <li class="nav-item" role="presentation">
    <%= link_to user_path(@user, tab: :payments, view_as: navigation_view),
        class: "nav-link #{'active' if @active_tab == :payments}",
        role: "tab" do %>
      Payments
      <% if @payments_count.to_i > 0 %>
        <span class="text-secondary small ms-1"><%= @payments_count %></span>
      <% end %>
    <% end %>
  </li>
  <% if @parking_notices_count.to_i > 0 %>
    <li class="nav-item" role="presentation">
      <%= link_to user_path(@user, tab: :parking, view_as: navigation_view),
          class: "nav-link #{'active' if @active_tab == :parking}",
          role: "tab" do %>
        Parking <span class="text-secondary small ms-1"><%= @parking_notices_count %></span>
      <% end %>
    </li>
  <% end %>
  <li class="nav-item" role="presentation">
    <%= link_to user_path(@user, tab: :training_history, view_as: navigation_view),
        class: "nav-link #{'active' if @active_tab == :training_history}",
        role: "tab" do %>
      Training
      <% if @completed_training_requests.to_a.any? %>
        <span class="text-secondary small ms-1"><%= @completed_training_requests.size %></span>
      <% end %>
    <% end %>
  </li>
  <li class="nav-item" role="presentation">
    <%= link_to (@user == current_user ? messages_path(folder: :unread) : user_path(@user, tab: :messages, view_as: navigation_view)),
        class: "nav-link #{'active' if @active_tab == :messages}",
        role: "tab" do %>
      Messages
      <% if @unread_messages_count.to_i > 0 %>
        <span class="text-warning small ms-1"><%= @unread_messages_count %></span>
      <% end %>
    <% end %>
  </li>
  <% if @user == current_user %>
    <li class="nav-item" role="presentation">
      <%= link_to user_path(@user, tab: :notifications, view_as: navigation_view),
          class: "nav-link #{'active' if @active_tab == :notifications}",
          role: "tab" do %>
        Notifications
      <% end %>
    </li>
  <% end %>
</ul>
