<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0"><%= current_user_admin? ? "Edit" : "Manage" %> Training Topic: <%= @training_topic.name %></h1>
  <% if current_user_admin? %>
    <%= link_to "&larr; Back to Training Topics".html_safe, training_topics_path, class: "text-decoration-none" %>
  <% else %>
    <%= link_to "&larr; Back to Train".html_safe, train_member_path, class: "text-decoration-none" %>
  <% end %>
</div>

<% can_manage_topic = can?(:'training.topics.manage') %>
<%# A role on the parent carries rename and delete over its subtopics; may_manage_subtopic? %>
<%# already covers holders of the global privilege. %>
<% can_delete_topic = true_user&.may_manage_subtopic?(@training_topic) || false %>
<% can_edit_details = can_manage_topic || can_delete_topic ||
                      can?(:'training.topics.edit_details', topic: @training_topic) %>

<% if @training_topic.parent.present? %>
  <div class="text-13 text-secondary mb-3">
    Subtopic of <%= link_to @training_topic.parent.name, edit_training_topic_path(@training_topic.parent), class: "text-decoration-none" %>
  </div>
<% end %>

<% if can_edit_details %>
  <div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
      <h2 class="h5 mb-3">Topic Settings</h2>
      <% if @training_topic.errors.any? %>
        <div class="alert alert-danger">
          <ul class="mb-0">
            <% @training_topic.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
      <%= form_with model: @training_topic, url: training_topic_path(@training_topic), local: true, class: "row g-3" do |f| %>
        <% if can_delete_topic %>
          <div class="col-md-6">
            <%= f.label :name, "Name", class: "form-label text-13" %>
            <%= f.text_field :name, class: "form-control #{'is-invalid' if @training_topic.errors.key?(:name)}", required: true %>
            <% if @training_topic.errors.key?(:name) %>
              <div class="invalid-feedback">
                <%= @training_topic.errors[:name].first %>
              </div>
            <% end %>
          </div>
        <% end %>
        <% if can_manage_topic %>
          <div class="col-md-6">
            <%= f.label :parent_id, "Parent topic", class: "form-label text-13" %>
            <%= f.collection_select :parent_id, @eligible_parents, :id, :name,
                  { include_blank: "No parent (top level)" },
                  class: "form-select #{'is-invalid' if @training_topic.errors.key?(:parent_id)}" %>
            <% if @training_topic.errors.key?(:parent_id) %>
              <div class="invalid-feedback">
                <%= @training_topic.errors[:parent_id].first %>
              </div>
            <% end %>
          </div>
        <% end %>
        <div class="col-12">
          <%= f.label :description, "Description", class: "form-label text-13" %>
          <%= f.text_area :description, rows: 3, class: "form-control", placeholder: "What this topic covers" %>
        </div>
        <% if can_manage_topic %>
          <div class="col-md-6 d-flex align-items-center">
            <div class="form-check mt-1">
              <%= f.check_box :offered_to_members, class: "form-check-input" %>
              <%= f.label :offered_to_members, "Offered to members", class: "form-check-label" %>
            </div>
          </div>
        <% end %>
        <div class="col-md-3">
          <%= f.submit "Update Topic", class: "btn btn-primary w-100" %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<% if @subtopics.any? || can?(:'training.subtopics.create', topic: @training_topic) %>
  <div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
      <h2 class="h5 mb-3"><i class="bi bi-diagram-3 me-2"></i>Subtopics</h2>
      <% if @subtopics.any? %>
        <ul class="list-group list-group-flush list-compact mb-3">
          <% @subtopics.each do |subtopic| %>
            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
              <%= link_to subtopic.name, edit_training_topic_path(subtopic), class: "text-decoration-none" %>
              <% unless subtopic.offered_to_members? %>
                <span class="text-12 text-secondary">Not offered to members</span>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-secondary text-13">No subtopics yet.</p>
      <% end %>

      <% if can?(:'training.subtopics.create', topic: @training_topic) %>
        <%= form_with model: TrainingTopic.new, url: training_topics_path, local: true, class: "row g-2 align-items-end" do |f| %>
          <%= f.hidden_field :parent_id, value: @training_topic.id %>
          <div class="col-md-8">
            <%= f.label :name, "Add a subtopic", class: "form-label text-13" %>
            <%= f.text_field :name, class: "form-control", placeholder: "Subtopic name", required: true %>
          </div>
          <div class="col-md-4">
            <%= f.submit "Add Subtopic", class: "btn btn-outline-secondary w-100" %>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>

<% if current_user_admin? %>
  <div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
      <h2 class="h5 mb-3"><i class="bi bi-shield-check me-2"></i>Roles</h2>
      <p class="text-13 text-secondary">
        Members who hold this topic receive the privileges in the roles below. "Trained in topic"
        confers to everyone with a training record; "can train topic" confers only to its trainers.
      </p>

      <% if @topic_roles.any? %>
        <div class="table-responsive mb-4">
          <table class="table table-compact align-middle mb-0">
            <thead>
              <tr>
                <th scope="col">Role</th>
                <th scope="col">Conferred to</th>
                <th scope="col">Privileges</th>
                <th scope="col" class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @topic_roles.each do |topic_role| %>
                <tr>
                  <td class="fw-medium">
                    <%= link_to topic_role.role.name, edit_role_path(topic_role.role),
                          class: 'text-body text-decoration-none' %>
                  </td>
                  <td class="text-12"><%= topic_role.member_source_label %></td>
                  <td class="text-12">
                    <% if topic_role.role.privileges.any? %>
                      <%= topic_role.role.privileges.sort_by(&:key).map(&:label).join(', ') %>
                    <% else %>
                      <span class="text-secondary">None yet</span>
                    <% end %>
                  </td>
                  <td class="text-end">
                    <%= button_to 'Remove', training_topic_topic_role_path(@training_topic, topic_role),
                          method: :delete,
                          class: 'btn btn-sm btn-outline-secondary',
                          form: { data: { turbo_confirm: "Stop conferring #{topic_role.role.name} from this topic?" } } %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="text-13 text-secondary mb-4">
          This topic confers no privileges. Attach a role below to change that.
        </p>
      <% end %>

      <h6 class="h-section-label mb-2">Attach a role</h6>
      <% if @available_roles.any? %>
        <%= form_with model: TrainingTopicRole.new, url: training_topic_topic_roles_path(@training_topic),
              local: true, class: 'row g-2 align-items-end' do |f| %>
          <div class="col-md-5">
            <%= f.label :role_id, 'Role', class: 'form-label text-13' %>
            <%= f.collection_select :role_id, @available_roles, :id, :name,
                  { prompt: 'Choose a role' }, { class: 'form-select form-select-sm', required: true } %>
          </div>
          <div class="col-md-4">
            <%= f.label :member_source, 'Conferred to', class: 'form-label text-13' %>
            <%= f.select :member_source,
                  [['Members trained in this topic', 'trained_in'], ['Members who can train it', 'can_train']],
                  {}, { class: 'form-select form-select-sm' } %>
          </div>
          <div class="col-md-3">
            <%= f.submit 'Attach role', class: 'btn btn-outline-secondary btn-sm w-100' %>
          </div>
        <% end %>
      <% else %>
        <p class="text-13 text-secondary mb-0">
          No roles defined yet. <%= link_to 'Create a role', new_role_path %> first.
        </p>
      <% end %>
    </div>
  </div>
<% end %>

<div class="card shadow-sm border-0 mb-4">
  <div class="card-body">
    <h2 class="h5 mb-3">Links</h2>
    
    <% if @training_topic.links.any? %>
      <div class="mb-4">
        <% @training_topic.links.order(:title).each do |link| %>
          <div class="border rounded p-3 mb-2" id="link-row-<%= link.id %>">
            <%# Display mode %>
            <div class="link-display-<%= link.id %> d-flex justify-content-between align-items-center">
              <div>
                <strong><%= link.title %></strong>
                <br>
                <%= link_to link.url, link.url, target: "_blank", rel: "noopener", class: "text-decoration-none small text-truncate d-inline-block", style: "max-width: 400px;" %>
              </div>
              <div class="d-flex gap-2">
                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="toggleEditLink(<%= link.id %>)">
                  <i class="bi bi-pencil"></i> Edit
                </button>
                <%= button_to training_topic_link_path(@training_topic, link), 
                    method: :delete, 
                    class: "btn btn-sm btn-outline-danger",
                    data: { turbo_confirm: "Remove this link?" } do %>
                  <i class="bi bi-trash"></i> Remove
                <% end %>
              </div>
            </div>
            
            <%# Edit mode %>
            <div class="link-edit-<%= link.id %>" style="display: none;">
              <%= form_with model: link, url: training_topic_link_path(@training_topic, link), local: true do |f| %>
                <div class="row g-2 align-items-end">
                  <div class="col-md-4">
                    <%= f.label :title, "Title", class: "form-label small" %>
                    <%= f.text_field :title, class: "form-control form-control-sm", required: true %>
                  </div>
                  <div class="col-md-5">
                    <%= f.label :url, "URL", class: "form-label small" %>
                    <%= f.url_field :url, class: "form-control form-control-sm", required: true %>
                  </div>
                  <div class="col-md-3 d-flex gap-2">
                    <%= f.submit "Save", class: "btn btn-sm btn-primary" %>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="toggleEditLink(<%= link.id %>)">Cancel</button>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-muted mb-4">No links added yet.</p>
    <% end %>

    <h6 class="text-muted mb-3">Add New Link</h6>
    <%= form_with model: TrainingTopicLink.new, url: training_topic_links_path(@training_topic), local: true, class: "row g-2 align-items-end" do |f| %>
      <div class="col-md-4">
        <%= f.label :title, "Title", class: "form-label small" %>
        <%= f.text_field :title, class: "form-control", placeholder: "e.g., Safety Guide", required: true %>
      </div>
      <div class="col-md-5">
        <%= f.label :url, "URL", class: "form-label small" %>
        <%= f.url_field :url, class: "form-control", placeholder: "https://...", required: true %>
      </div>
      <div class="col-md-3">
        <%= f.submit "Add Link", class: "btn btn-outline-secondary w-100" %>
      </div>
    <% end %>
  </div>
</div>

<script>
  function toggleEditLink(linkId) {
    const displayElements = document.querySelectorAll('.link-display-' + linkId);
    const editElements = document.querySelectorAll('.link-edit-' + linkId);
    
    displayElements.forEach(el => {
      el.style.display = el.style.display === 'none' ? '' : 'none';
    });
    editElements.forEach(el => {
      el.style.display = el.style.display === 'none' ? '' : 'none';
    });
  }
</script>

<div class="card shadow-sm border-0 mb-4">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h2 class="h5 mb-0"><i class="bi bi-file-earmark me-2"></i>Documents</h2>
      <%= link_to new_document_path(training_topic_id: @training_topic.id, return_to_topic: @training_topic.id), class: "btn btn-sm btn-outline-secondary" do %>
        <i class="bi bi-plus-lg"></i> Upload Document
      <% end %>
    </div>

    <% if @topic_documents.any? %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="bg-body-tertiary">
            <tr>
              <th>Title</th>
              <th>Filename</th>
              <th>Size</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @topic_documents.each do |doc| %>
              <tr>
                <td><%= doc.title %></td>
                <td class="text-muted small"><%= doc.filename %></td>
                <td class="text-muted small"><%= doc.file.attached? ? number_to_human_size(doc.file.byte_size) : 'N/A' %></td>
                <td class="text-end">
                  <div class="d-flex gap-1 justify-content-end">
                    <% if doc.file.attached? %>
                      <%= link_to download_document_path(doc), class: "btn btn-sm btn-outline-secondary", title: "Download" do %>
                        <i class="bi bi-download"></i>
                      <% end %>
                    <% end %>
                    <%= link_to edit_document_path(doc, return_to_topic: @training_topic.id), class: "btn btn-sm btn-outline-primary", title: "Edit" do %>
                      <i class="bi bi-pencil"></i>
                    <% end %>
                    <%= button_to document_path(doc, return_to_topic: @training_topic.id),
                        method: :delete,
                        class: "btn btn-sm btn-outline-danger",
                        title: "Delete",
                        data: { turbo_confirm: "Delete this document?" } do %>
                      <i class="bi bi-trash"></i>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-muted mb-0">No documents associated with this topic yet.</p>
    <% end %>
  </div>
</div>

<div class="card shadow-sm border-0 mb-4">
  <div class="card-body">
    <h2 class="h5 mb-3"><i class="bi bi-mortarboard me-2"></i>Train a Member in <%= @training_topic.name %></h2>
    
    <div class="row">
      <div class="col-md-6" data-controller="live-filter" data-live-filter-min-length-value="2">
        <input type="text" class="form-control"
               placeholder="Type to search by name, email, or username..." autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false"
               data-live-filter-target="input" data-action="input->live-filter#filter keyup->live-filter#filter">
        <div class="mt-2 d-none border rounded" style="max-height: 300px; overflow-y: auto;"
             data-live-filter-target="resultsContainer">
          <% trained_user_ids = @trained_users.pluck(:id) %>
          <% @users_for_search.each do |user| %>
            <% is_trained = trained_user_ids.include?(user.id) %>
            <div class="search-result-item d-none p-2 border-bottom d-flex justify-content-between align-items-center"
                 data-live-filter-target="item"
                 data-search-text="<%= [user.display_name, user.email, user.username].compact.join(' ').downcase %>">
              <div>
                <div class="fw-semibold small"><%= user.display_name %></div>
                <% if user.email.present? %>
                  <div class="text-muted" style="font-size: 0.75rem;"><%= user.email %></div>
                <% end %>
              </div>
              <div class="d-flex align-items-center gap-2">
                <% unless user.active? %>
                  <span class="badge text-bg-warning-subtle">Inactive</span>
                <% end %>
                <% if is_trained %>
                  <span class="badge text-bg-success-subtle"><i class="bi bi-check"></i> Trained</span>
                <% else %>
                  <%= button_to add_training_path(user_id: user.id, topic_id: @training_topic.id, return_to: 'topic'),
                      method: :post,
                      class: "btn btn-sm btn-outline-secondary",
                      title: "Add training",
                      form: { data: inactive_training_notice_data(user) } do %>
                    <i class="bi bi-plus-lg"></i> Train
                  <% end %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
        <div class="mt-2 p-3 text-center text-muted border rounded d-none"
             data-live-filter-target="noResults">
          No members found matching your search.
        </div>
      </div>
      <div class="col-md-6">
        <p class="text-muted small mb-0">
          Search for a member and click "Train" to mark them as trained in <strong><%= @training_topic.name %></strong>.
          Members already trained in this topic will show a green "Trained" badge.
        </p>
      </div>
    </div>
  </div>
</div>


<div class="row g-4">
  <div class="col-md-6">
    <div class="card shadow-sm border-0">
      <div class="card-body">
        <h2 class="h5 mb-3">Users Trained in This Topic</h2>
        <% if @trained_users.any? %>
          <ul class="list-unstyled mb-0">
            <% @trained_users.each do |user| %>
              <li class="mb-2 d-flex justify-content-between align-items-center">
                <%= link_to user.display_name, user_path(user), class: "text-decoration-none" %>
                <%= button_to "Revoke", revoke_training_training_topic_path(@training_topic, user_id: user.id), 
                    method: :delete, 
                    class: "btn btn-sm btn-outline-danger",
                    data: { confirm: "Are you sure you want to revoke training for #{user.display_name}?" } %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="text-muted mb-0">No users have been trained in this topic yet.</p>
        <% end %>
      </div>
    </div>
  </div>

  <% if current_user_admin? %>
    <div class="col-md-6">
      <div class="card shadow-sm border-0">
        <div class="card-body">
          <h2 class="h5 mb-3">Users Who Can Train This Topic</h2>
          <% if @trainer_users.any? %>
            <ul class="list-unstyled mb-0">
              <% @trainer_users.each do |user| %>
                <li class="mb-2 d-flex justify-content-between align-items-center">
                  <%= link_to user.display_name, user_path(user), class: "text-decoration-none" %>
                  <%= button_to "Revoke", revoke_trainer_capability_training_topic_path(@training_topic, user_id: user.id), 
                      method: :delete, 
                      class: "btn btn-sm btn-outline-danger",
                      data: { confirm: "Are you sure you want to revoke trainer capability for #{user.display_name}?" } %>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="text-muted mb-0">No users can train this topic yet.</p>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>

<% if can_delete_topic %>
  <div class="card shadow-sm border-0 mt-4">
    <div class="card-body">
      <h2 class="h5 mb-3 text-danger">Danger Zone</h2>
      <% if @training_topic.trainings.any? || @training_topic.trainer_capabilities.any? %>
        <p class="text-muted small">Cannot delete this topic because it has trainings or trainer capabilities.</p>
      <% else %>
        <%= button_to "Delete Topic", training_topic_path(@training_topic),
            method: :delete,
            class: "btn btn-danger",
            data: { turbo_confirm: "Are you sure you want to delete '#{@training_topic.name}'? This cannot be undone." } %>
      <% end %>
    </div>
  </div>
<% end %>
