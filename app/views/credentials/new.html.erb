<div class="mb-3">
  <h1 class="h-page-title mb-0">Request <%= @provider.schema_display_name %></h1>
  <div class="text-13 text-secondary mt-1">
    <% if @member == current_user %>
      <%= @provider.schema&.dig('description').presence || @provider.description %>
    <% else %>
      Issuing for <%= link_to @member.display_name, user_path(@member) %>. You will see the secret once, and need to
      give it to them yourself.
    <% end %>
  </div>
</div>

<div class="card shadow-sm border-0">
  <div class="card-body">
    <%# A full-page POST (not Turbo) so the response with the secret is a normal page the browser never caches. %>
    <%= form_with url: credentials_path, method: :post, data: { turbo: false } do %>
      <%= hidden_field_tag :provider_id, @provider.id %>
      <%= hidden_field_tag :user_id, @member.id if @member != current_user %>
      <%= hidden_field_tag :request_id, @request_id %>

      <div class="mb-3">
        <%= label_tag :label, "What is it for? (optional)", class: "form-label" %>
        <%= text_field_tag :label, nil, class: "form-control", maxlength: Credential::LABEL_LIMIT,
                           placeholder: "e.g., laptop CLI" %>
        <div class="form-text">A note for you, so you can tell your credentials apart later.</div>
      </div>

      <div class="alert alert-warning text-13">
        The secret is shown <strong>once</strong>, on the next page. Copy it somewhere safe before you leave. We keep
        only its first and last four characters.
      </div>

      <div class="d-flex gap-2">
        <%= submit_tag "Request credential", class: "btn btn-primary btn-sm", data: { disable_with: "Requesting..." } %>
        <%= link_to "Cancel", credentials_path, class: "btn btn-outline-secondary btn-sm" %>
      </div>
    <% end %>
  </div>
</div>
