<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="h3 mb-0"><i class="bi bi-mortarboard me-2"></i><%= @training_topic.name %></h1>
    <% unless @training_topic.offered_to_members? %>
      <span class="badge text-bg-secondary mt-2">Not currently offered to members</span>
    <% end %>
  </div>
  <div class="d-flex gap-2 align-items-center">
    <% if current_user.may_open_topic_page?(@training_topic) %>
      <%= link_to edit_training_topic_path(@training_topic), class: 'btn btn-outline-primary btn-sm' do %>
        <i class="bi bi-pencil me-1"></i> Edit
      <% end %>
    <% end %>
    <%= link_to "&larr; Back to Training".html_safe, training_catalog_path, class: 'text-decoration-none' %>
  </div>
</div>

<% if @training_topic.description.present? %>
  <div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
      <h2 class="h5 mb-2">About this topic</h2>
      <p class="mb-0"><%= simple_format(@training_topic.description) %></p>
    </div>
  </div>
<% end %>

<div class="card shadow-sm border-0 mb-4">
  <div class="card-body d-flex flex-wrap gap-2 align-items-center">
    <% if @requestable %>
      <%= link_to new_training_request_path(training_topic_id: @training_topic.id), class: 'btn btn-primary' do %>
        <i class="bi bi-mortarboard me-1"></i> Request Training
      <% end %>
      <span class="text-muted small">This topic is open for member training requests.</span>
    <% else %>
      <span class="text-muted small">
        <i class="bi bi-info-circle me-1"></i>
        This topic is not currently available for training requests
        (either there are no trainers yet, or it is not offered to members).
      </span>
    <% end %>
  </div>
</div>

<div class="row g-4">
  <div class="col-lg-6">
    <div class="card shadow-sm border-0 h-100">
      <div class="card-body">
        <h2 class="h5 mb-3"><i class="bi bi-person-badge me-2"></i>Trainers</h2>
        <% if @trainers.any? %>
          <ul class="list-unstyled mb-0">
            <% @trainers.each do |trainer| %>
              <li class="mb-2 d-flex align-items-center gap-2 flex-wrap">
                <%= training_roster_name(trainer, @roster) %>
                <% if current_user_admin? && !trainer.active? %>
                  <span class="badge text-bg-secondary-subtle small fw-normal">Inactive</span>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="text-muted mb-0">No trainers are currently listed for this topic.</p>
        <% end %>
      </div>
    </div>
  </div>

  <div class="col-lg-6">
    <div class="card shadow-sm border-0 h-100" id="trained-members">
      <div class="card-body">
        <h2 class="h5 mb-3"><i class="bi bi-people me-2"></i>Trained Members</h2>
        <% if @roster.list_visible? && @trainees.any? %>
          <ul class="list-unstyled mb-0">
            <% @trainees.each do |trainee| %>
              <li class="mb-2 d-flex align-items-center gap-2 flex-wrap">
                <%= training_roster_name(trainee, @roster) %>
                <% unless trainee.active? %>
                  <span class="badge text-bg-secondary-subtle small fw-normal">Inactive</span>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% elsif @roster.list_visible? || @roster.active_trained_count.zero? %>
          <p class="text-secondary text-13 mb-0">No members have been trained in this topic yet.</p>
        <% else %>
          <p class="text-secondary text-13 mb-0"><%= pluralize(@roster.active_trained_count, 'member') %> trained.</p>
        <% end %>
      </div>
    </div>
  </div>
</div>

<% if @contact_recipient_count.positive? %>
  <div class="card shadow-sm border-0 my-4" id="contact-trained-members">
    <div class="card-body">
      <h2 class="h5 mb-2">Message trained members</h2>
      <p class="text-13 text-secondary mb-3">
        This goes to <%= pluralize(@contact_recipient_count, 'member') %> trained in this topic.
        They can reply to you.
      </p>
      <%= form_with url: training_catalog_topic_contact_path(@training_topic), class: 'row g-3' do |f| %>
        <div class="col-12">
          <%= f.label :subject, 'Subject', class: 'form-label text-13' %>
          <%= f.text_field :subject, class: 'form-control', required: true, maxlength: TrainingTopicContact::MAX_SUBJECT %>
        </div>
        <div class="col-12">
          <%= f.label :body, 'Message', class: 'form-label text-13' %>
          <%= f.text_area :body, rows: 4, class: 'form-control', required: true, maxlength: TrainingTopicContact::MAX_BODY %>
        </div>
        <div class="col-12">
          <%= f.submit 'Send message', class: "btn btn-sm #{@requestable ? 'btn-outline-secondary' : 'btn-primary'}" %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<%= render 'training_catalog/resources' %>
