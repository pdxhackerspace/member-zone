<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="h-page-title mb-0">Training</h1>
    <div class="text-13 text-secondary mt-1">
      Browse topics, trainers, and requestable training. Ask in <strong>#help</strong> if you do not see what you need.
    </div>
  </div>
  <div class="d-flex gap-2">
    <% if @can_record_training %>
      <%= link_to record_training_path, class: 'btn btn-primary btn-sm' do %>
        <i class="bi bi-mortarboard me-1"></i> Record training
      <% end %>
    <% end %>
    <% if @requestable_topic_ids.any? %>
      <%= link_to new_training_request_path, class: "btn btn-sm #{@can_record_training ? 'btn-outline-secondary' : 'btn-primary'}" do %>
        <i class="bi bi-mortarboard me-1"></i> Request training
      <% end %>
    <% end %>
  </div>
</div>

<div class="d-flex flex-wrap gap-2 mb-3">
  <%= link_to training_catalog_path, class: "filter-chip text-decoration-none #{'active' if params[:training_filter].blank?}" do %>
    <%= '✓ ' if params[:training_filter].blank? %>All <span class="count"><%= @all_topic_count %></span>
  <% end %>
  <%= link_to training_catalog_path(training_filter: 'offered'), class: "filter-chip text-decoration-none #{'active' if params[:training_filter] == 'offered'}" do %>
    <%= '✓ ' if params[:training_filter] == 'offered' %>Offered <span class="count"><%= @offered_topic_count %></span>
  <% end %>
  <%= link_to training_catalog_path(training_filter: 'needs_trainers'), class: "filter-chip warning text-decoration-none #{'active' if params[:training_filter] == 'needs_trainers'} #{'muted' if @needs_trainers_count.zero?}" do %>
    <%= '✓ ' if params[:training_filter] == 'needs_trainers' %>Needs trainers <span class="count"><%= @needs_trainers_count %></span>
  <% end %>
</div>

<div data-controller="training-contact">
<% if @training_topics.any? %>
  <div class="card shadow-sm border-0">
      <div class="table-responsive">
        <table class="table table-compact table-hover align-middle mb-0">
          <thead>
            <tr>
              <th scope="col">Topic</th>
              <% if current_user_admin? %>
              <th scope="col" class="text-center">Offered</th>
              <% end %>
              <th scope="col" class="text-center">Trainers</th>
              <th scope="col" class="text-center">Trained</th>
              <th scope="col" class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @training_topics.each do |topic, depth| %>
              <% trainer_counts = @topic_trainer_counts[topic.id] || { total: 0, active: 0, inactive: 0 } %>
              <% trained_counts = @topic_trained_counts[topic.id] || { total: 0, active: 0, inactive: 0 } %>
              <% needs_trainers = topic.offered_to_members? && trainer_counts[:active].zero? %>
              <% linked = training_catalog_topic_linked?(topic) %>
              <tr
                <% if linked %>
                  data-href="<%= training_catalog_topic_path(topic) %>"
                  onclick="if (!event.target.closest('a, button')) window.location = this.dataset.href"
                <% end %>
              >
                <td>
                  <% nest_class = training_catalog_nest_class(topic, depth) %>
                  <div<% if nest_class %> class="<%= nest_class %>"<% end %>>
                    <strong>
                      <% if linked %>
                        <%= link_to topic.name, training_catalog_topic_path(topic), class: 'text-decoration-none' %>
                      <% else %>
                        <%= topic.name %>
                      <% end %>
                    </strong>
                    <% if topic.description.present? %>
                      <div class="text-muted small"><%= truncate(topic.description.to_s, length: 140) %></div>
                    <% end %>
                    <% roster_names = topic.trained_members_visible? ? Array(@roster_members[topic.id]) : [] %>
                    <% if roster_names.any? %>
                      <% roster = TrainingTopicRoster.new(topic: topic, viewer: current_user) %>
                      <div class="d-flex flex-wrap gap-2 mt-1">
                        <% roster_names.each do |member| %>
                          <span class="text-13"><%= training_roster_name(member, roster) %></span>
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                </td>
                <% if current_user_admin? %>
                  <td class="text-center">
                    <% if topic.offered_to_members? %>
                      <span class="text-success">✓</span>
                    <% else %>
                      <span class="text-secondary">—</span>
                    <% end %>
                  </td>
                <% end %>
                <% if current_user_admin? %>
                  <%= render 'training_catalog/member_status_counts', counts: trainer_counts, highlight: needs_trainers %>
                  <%= render 'training_catalog/member_status_counts',
                             counts: trained_counts,
                             highlight: false %>
                <% else %>
                  <td class="num <%= needs_trainers ? 'text-warning' : (trainer_counts[:active].zero? ? 'muted-num' : '') %>">
                    <%= trainer_counts[:active] %>
                  </td>
                  <td class="num <%= trained_counts[:total].zero? ? 'muted-num' : ('fw-medium' if trained_counts[:total] >= 50) %>">
                    <%= trained_counts[:total] %>
                  </td>
                <% end %>
                <td class="text-end">
                  <div class="d-flex gap-2 justify-content-end">
                    <% if needs_trainers %>
                      <span class="text-warning text-12">No trainers</span>
                    <% elsif @requestable_topic_ids.include?(topic.id) %>
                      <%= link_to new_training_request_path(training_topic_id: topic.id), class: 'btn btn-sm btn-outline-secondary' do %>
                        <i class="bi bi-mortarboard"></i> Request
                      <% end %>
                    <% elsif @contactable_topic_ids.include?(topic.id) %>
                      <% recipients = Array(@roster_members[topic.id]).reject { |member| member.id == current_user.id } %>
                      <button type="button" class="btn btn-sm btn-outline-secondary"
                              data-bs-toggle="modal" data-bs-target="#training-contact-modal"
                              data-action="training-contact#open"
                              data-contact-url="<%= training_catalog_topic_contact_path(topic) %>"
                              data-contact-topic="<%= topic.name %>"
                              data-contact-detail="<%= training_contact_detail(recipients) %>">
                        <i class="bi bi-chat"></i> Contact
                      </button>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
  </div>
<% else %>
  <div class="alert alert-secondary mb-0">
    No training topics are currently available.
  </div>
<% end %>

<div class="modal fade" id="training-contact-modal" tabindex="-1" aria-labelledby="training-contact-title" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <%= form_with url: training_catalog_path, method: :post, data: { training_contact_target: 'form' } do %>
        <%= hidden_field_tag :return_to, 'catalog' %>
        <div class="modal-header">
          <h2 class="modal-title h5" id="training-contact-title" data-training-contact-target="title">Message trained members</h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <p class="text-13 text-secondary" data-training-contact-target="detail"></p>
          <div class="mb-3">
            <%= label_tag :subject, 'Subject', class: 'form-label text-13' %>
            <%= text_field_tag :subject, nil, class: 'form-control', required: true, maxlength: TrainingTopicContact::MAX_SUBJECT %>
          </div>
          <div>
            <%= label_tag :body, 'Message', class: 'form-label text-13' %>
            <%= text_area_tag :body, nil, rows: 4, class: 'form-control', required: true, maxlength: TrainingTopicContact::MAX_BODY %>
          </div>
        </div>
        <div class="modal-footer">
          <%= submit_tag 'Send message', class: 'btn btn-primary btn-sm' %>
        </div>
      <% end %>
    </div>
  </div>
</div>
</div>
