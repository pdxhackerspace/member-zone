<%= render layout: 'shared/list_page_header',
           locals: { title: 'Slack users', count: @filtered_count || @total_count, noun: 'account' } do %>
  <% if MemberSource.enabled?('slack') %>
    <%= form_with url: sync_slack_users_path, method: :post, local: true,
                  class: 'd-flex align-items-center gap-3 mb-0' do %>
      <div class="form-check form-switch mb-0">
        <%= check_box_tag :update_members, '1', false, class: 'form-check-input', role: 'switch',
                          id: 'slack_sync_update_members' %>
        <%= label_tag :update_members, 'Update member accounts', class: 'form-check-label text-13 text-nowrap',
                      for: 'slack_sync_update_members' %>
      </div>
      <%= submit_tag 'Sync Slack users', class: 'btn btn-primary btn-sm', data: { turbo: false } %>
    <% end %>
    <div class="dropdown">
      <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="dropdown"
              aria-expanded="false" aria-label="More actions">&hellip;</button>
      <ul class="dropdown-menu dropdown-menu-end">
        <li>
          <button type="button" class="dropdown-item" data-bs-toggle="modal"
                  data-bs-target="#importSlackMembersModal">Import members</button>
        </li>
        <li>
          <button type="button" class="dropdown-item" data-bs-toggle="modal"
                  data-bs-target="#importSlackAnalyticsModal">Import analytics</button>
        </li>
      </ul>
    </div>
  <% else %>
    <button class="btn btn-outline-secondary btn-sm" disabled title="Slack source is disabled">
      Sync Slack users
    </button>
  <% end %>
<% end %>

<% if @filter_active %>
  <% labels = [{ 'yes' => 'Linked', 'no' => 'Unlinked', 'dont_link' => "Don't link" }[params[:linked]],
               ('Admins' if params[:is_admin] == 'yes'),
               ('Owners' if params[:is_owner] == 'yes'),
               ({ 'yes' => 'Bots', 'no' => 'Humans' }[params[:is_bot]]),
               params[:status]&.humanize].compact %>
  <%= render 'shared/list_filter_banner', label: "#{labels.join(' + ')} accounts",
             shown: @filtered_count, total: @total_count,
             clear_path: slack_users_path(sort: @sort_column, direction: @sort_direction) %>
<% end %>

<%= render 'shared/list_filter_tiles', tiles: [
      { label: 'All', count: @total_count, path: list_filter_path(:slack_users_path, :linked, nil),
        active: params[:linked].blank? },
      { label: 'Linked', count: @linked_count, path: list_filter_path(:slack_users_path, :linked, 'yes'),
        active: params[:linked] == 'yes' },
      { label: 'Unlinked', count: @unlinked_count, path: list_filter_path(:slack_users_path, :linked, 'no'),
        active: params[:linked] == 'no', variant: 'warning' },
      { label: "Don't link", count: @dont_link_count,
        path: list_filter_path(:slack_users_path, :linked, 'dont_link'),
        active: params[:linked] == 'dont_link' }
    ] %>

<%# Role, type and status are separate axes: each chip toggles its own and leaves the rest. %>
<div class="card shadow-sm border-0 mb-3">
  <div class="card-body py-2">
    <%= render 'shared/list_filter_chip_row', label: 'Role', chips: [
          { label: 'Admin', count: @admin_count, path: list_filter_path(:slack_users_path, :is_admin, 'yes'),
            active: params[:is_admin] == 'yes' },
          { label: 'Owner', count: @owner_count, path: list_filter_path(:slack_users_path, :is_owner, 'yes'),
            active: params[:is_owner] == 'yes' }
        ] %>
    <%= render 'shared/list_filter_chip_row', label: 'Type', chips: [
          { label: 'Human', count: @human_count, path: list_filter_path(:slack_users_path, :is_bot, 'no'),
            active: params[:is_bot] == 'no' },
          { label: 'Bot', count: @bot_count, path: list_filter_path(:slack_users_path, :is_bot, 'yes'),
            active: params[:is_bot] == 'yes' }
        ] %>
    <%= render 'shared/list_filter_chip_row', label: 'Status', chips: [
          { label: 'Active', count: @active_count, path: list_filter_path(:slack_users_path, :status, 'active'),
            active: params[:status] == 'active' },
          { label: 'Inactive', count: @inactive_count,
            path: list_filter_path(:slack_users_path, :status, 'inactive'),
            active: params[:status] == 'inactive', variant: 'warning' },
          { label: 'Deactivated', count: @deactivated_count,
            path: list_filter_path(:slack_users_path, :status, 'deactivated'),
            active: params[:status] == 'deactivated', variant: 'danger' }
        ] %>
  </div>
</div>

<%= render layout: 'shared/list_client_filter' do %>
  <%= render 'shared/list_search', server: false, placeholder: 'Search by name or linked member…' %>

  <% if @slack_users.any? %>
    <%= render layout: 'shared/list_table',
               locals: { body_id: 'slack_users_table_body',
                         headers: [['', 'avatar-col'],
                                   sortable_column('display_name', 'Name', @sort_column, @sort_direction),
                                   'Linked member',
                                   sortable_column('is_admin', 'Admin', @sort_column, @sort_direction),
                                   sortable_column('is_owner', 'Owner', @sort_column, @sort_direction),
                                   sortable_column('is_bot', 'Bot', @sort_column, @sort_direction),
                                   sortable_column('deleted', 'Status', @sort_column, @sort_direction),
                                   ['', 'text-end']] } do %>
      <% @slack_users.each do |slack_user| %>
        <% needs_linking = slack_user.user.blank? && !slack_user.is_bot? && !slack_user.dont_link? %>
        <tr class="slack-user-row <%= 'row-attention' if needs_linking %>"
            data-live-filter-target="item"
            data-search-text="<%= [
              slack_user.display_name,
              slack_user.user&.display_name,
              slack_user.is_admin? ? 'admin' : nil,
              slack_user.is_owner? ? 'owner' : nil,
              slack_user.is_bot? ? 'bot' : 'human',
              slack_user.deleted? ? 'deactivated' : (slack_user.inactive? ? 'inactive' : 'active'),
              slack_user.dont_link? ? 'dont link' : nil
            ].compact.join(' ').downcase %>">
          <td>
            <% image_url = slack_user.raw_attributes.dig('profile', 'image_32') %>
            <% if image_url.present? %>
              <%= link_to slack_user_path(slack_user, @list_params) do %>
                <img src="<%= image_url %>" alt="" class="list-avatar">
              <% end %>
            <% end %>
          </td>
          <td>
            <%= link_to slack_user.display_name, slack_user_path(slack_user, @list_params),
                        class: 'fw-medium text-decoration-none' %>
          </td>
          <td>
            <% if slack_user.user.present? %>
              <%= link_to slack_user.user.display_name, user_path(slack_user.user), class: 'text-decoration-none' %>
            <% elsif slack_user.dont_link? %>
              <span class="text-secondary">Don't link</span>
            <% else %>
              <span class="text-secondary fst-italic">Not linked</span>
            <% end %>
          </td>
          <td><%= slack_user.is_admin? ? tag.span('Admin', class: 'badge text-bg-info-subtle') : tag.span('—', class: 'text-secondary') %></td>
          <td><%= slack_user.is_owner? ? tag.span('Owner', class: 'badge text-bg-warning-subtle') : tag.span('—', class: 'text-secondary') %></td>
          <td><%= slack_user.is_bot? ? tag.span('Bot', class: 'badge text-bg-secondary-subtle') : tag.span('—', class: 'text-secondary') %></td>
          <td>
            <% if slack_user.deleted? %>
              <%= list_status_cell('Deactivated', tone: 'danger', success: false) %>
            <% elsif slack_user.inactive? %>
              <%= list_status_cell('Inactive', tone: 'warning', success: false) %>
            <% else %>
              <%= list_status_cell('Active', success: true) %>
            <% end %>
          </td>
          <td class="text-end text-nowrap">
            <% if needs_linking %>
              <div class="d-flex gap-1 justify-content-end">
                <button type="button" class="btn btn-sm btn-outline-warning"
                        data-bs-toggle="modal" data-bs-target="#slackLinkUserModal"
                        data-slack-user-id="<%= slack_user.id %>"
                        data-slack-user-name="<%= slack_user.display_name %>">Link member…</button>
                <div class="dropdown">
                  <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="dropdown"
                          aria-expanded="false" aria-label="More actions">&hellip;</button>
                  <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                      <%= button_to "Don't link", toggle_dont_link_slack_user_path(slack_user, from_index: 'true',
                                                                                   **@list_params),
                                    method: :post, class: 'dropdown-item', data: { turbo: false } %>
                    </li>
                    <li>
                      <%= button_to 'Create member', create_member_slack_user_path(slack_user, from_index: 'true',
                                                                                   **@list_params),
                                    method: :post, class: 'dropdown-item',
                                    data: { turbo: false,
                                            turbo_confirm: "Create a new member from '#{slack_user.display_name}'?" } %>
                    </li>
                  </ul>
                </div>
              </div>
            <% end %>
          </td>
        </tr>
      <% end %>
    <% end %>
  <% elsif @filter_active %>
    <%= render 'shared/list_empty', icon: 'slack', message: 'No Slack accounts match these filters.' %>
  <% else %>
    <%= render 'shared/list_empty', icon: 'slack', message: 'No Slack accounts have been synced yet.' %>
  <% end %>
<% end %>

<!-- Import Members Modal -->
<div class="modal fade" id="importSlackMembersModal" tabindex="-1" aria-labelledby="importSlackMembersModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="importSlackMembersModalLabel">Import Slack Members from CSV</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <%= form_with url: import_members_slack_users_path, method: :post, multipart: true, local: true do |f| %>
        <div class="modal-body">
          <p class="text-muted mb-2">Select the Slack CSV export for members. Expected columns:</p>
          <code class="d-block mb-3">username,email,status,billing-active,has-2fa,has-sso,userid,fullname,displayname,expiration-timestamp</code>
          <div class="mb-3">
            <%= f.file_field :file, accept: '.csv,text/csv', class: "form-control", required: true %>
          </div>
          <div class="alert alert-warning mb-0">
            <strong>Note:</strong> Users are matched by <code>userid</code>. Existing Slack users will be updated.
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <%= f.submit "Import CSV", class: "btn btn-success" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Import Analytics Modal -->
<div class="modal fade" id="importSlackAnalyticsModal" tabindex="-1" aria-labelledby="importSlackAnalyticsModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="importSlackAnalyticsModalLabel">Import Slack Analytics from CSV</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <%= form_with url: import_analytics_slack_users_path, method: :post, multipart: true, local: true do |f| %>
        <div class="modal-body">
          <p class="text-muted mb-2">Select the Slack analytics CSV export. Expected headers:</p>
          <code class="d-block mb-3">Name,What I Do,User ID,Username,Display name,Email,Account type,Account created (UTC),Days active,Days active (Desktop),Days active (Android),Days active (iOS),Messages posted,Last active (UTC),Last active (Desktop) (UTC),Last active (Android) (UTC),Last active (iOS) (UTC)</code>
          <div class="mb-3">
            <%= f.file_field :file, accept: '.csv,text/csv', class: "form-control", required: true %>
          </div>
          <div class="alert alert-warning mb-0">
            <strong>Note:</strong> Rows are matched by <code>User ID</code> or <code>Username</code>. <code>Last active (UTC)</code> is stored as midnight UTC for that date.
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <%= f.submit "Import CSV", class: "btn btn-success" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<% if @all_users.present? %>
<!-- Link User Modal -->
<div class="modal fade" id="slackLinkUserModal" tabindex="-1" aria-labelledby="slackLinkUserModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="slackLinkUserModalLabel">Link Slack User to Member</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="slackLinkUserForm" method="post">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
        <input type="hidden" name="from_index" value="true">
        <% @list_params.each do |key, value| %>
          <input type="hidden" name="<%= key %>" value="<%= value %>">
        <% end %>
        <div class="modal-body">
          <p class="mb-3">Link <strong id="slackLinkUserName"></strong> to an existing member.</p>
          <div class="mb-3">
            <label for="slack_user_search" class="form-label">Search Members</label>
            <input type="text" id="slack_user_search" class="form-control mb-2" placeholder="Type to search members…" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false">
          </div>
          <div class="mb-3">
            <label class="form-label">Select Member</label>
            <div id="slack_user_list" class="border rounded" style="max-height: 300px; overflow-y: auto;">
              <% @all_users.each do |user| %>
                <div class="slack-link-user-item p-2 border-bottom"
                     data-user-id="<%= user.id %>"
                     data-user-name="<%= user.display_name.downcase %>"
                     data-user-email="<%= user.email.to_s.downcase %>"
                     data-username="<%= user.username.to_s.downcase %>"
                     style="cursor: pointer;">
                  <input type="radio" name="user_id" id="slack_link_user_<%= user.id %>" value="<%= user.id %>" class="form-check-input me-2" required>
                  <label for="slack_link_user_<%= user.id %>" class="form-check-label mb-0" style="cursor: pointer;">
                    <%= user.display_name %>
                    <% if user.email.present? %>
                      <small class="text-muted">(<%= user.email %>)</small>
                    <% end %>
                  </label>
                </div>
              <% end %>
            </div>
            <div id="slack_no_results" class="text-muted text-center p-3" style="display: none;">
              No members found matching your search.
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Link Member</button>
        </div>
      </form>
    </div>
  </div>
</div>
<% end %>

<script>
  (function() {
    // Link User Modal functionality
    const linkModal = document.getElementById('slackLinkUserModal');
    if (linkModal) {
      linkModal.addEventListener('show.bs.modal', function(event) {
        const button = event.relatedTarget;
        const slackUserId = button.getAttribute('data-slack-user-id');
        const slackUserName = button.getAttribute('data-slack-user-name');

        // Update form action to point to the correct slack user
        const form = document.getElementById('slackLinkUserForm');
        form.action = '/slack_users/' + slackUserId + '/link_user';

        // Update display name
        document.getElementById('slackLinkUserName').textContent = slackUserName;

        // Reset search
        const userSearch = document.getElementById('slack_user_search');
        if (userSearch) userSearch.value = '';

        const userList = document.getElementById('slack_user_list');
        const noResults = document.getElementById('slack_no_results');
        if (userList) {
          userList.style.display = 'block';
          userList.querySelectorAll('.slack-link-user-item').forEach(function(item) {
            item.style.display = '';
          });
          // Uncheck all radios
          userList.querySelectorAll('input[type="radio"]').forEach(function(r) { r.checked = false; });
        }
        if (noResults) noResults.style.display = 'none';
      });

      // Search within modal
      const userSearch = document.getElementById('slack_user_search');
      if (userSearch) {
        userSearch.addEventListener('input', function() {
          const term = this.value.toLowerCase().trim();
          const userList = document.getElementById('slack_user_list');
          const noResults = document.getElementById('slack_no_results');
          const items = userList.querySelectorAll('.slack-link-user-item');
          let visible = 0;

          items.forEach(function(item) {
            const name = item.getAttribute('data-user-name') || '';
            const email = item.getAttribute('data-user-email') || '';
            const username = item.getAttribute('data-username') || '';
            const haystack = name + ' ' + email + ' ' + username;
            if (haystack.includes(term)) {
              item.style.display = '';
              visible++;
            } else {
              item.style.display = 'none';
            }
          });

          userList.style.display = visible > 0 ? 'block' : 'none';
          if (noResults) noResults.style.display = visible === 0 && term !== '' ? 'block' : 'none';
        });
      }

      // Click-to-select radio in modal
      const userList = document.getElementById('slack_user_list');
      if (userList) {
        userList.addEventListener('click', function(e) {
          const item = e.target.closest('.slack-link-user-item');
          if (item && e.target.type !== 'radio' && e.target.tagName !== 'LABEL') {
            const radio = item.querySelector('input[type="radio"]');
            if (radio) radio.checked = true;
          }
        });
      }
    }
  })();
</script>

