<div class="d-flex align-items-end justify-content-between mb-3">
  <div>
    <h1 class="h-page-title mb-0">Reminders</h1>
    <div class="text-13 text-secondary mt-1">
      <span class="text-body"><%= @reminder_settings.size %></span> configured
    </div>
  </div>
  <div>
    <%= link_to "Back to Settings", settings_path, class: "btn btn-outline-secondary btn-sm" %>
  </div>
</div>

<% unless @slack_source_enabled %>
  <div class="alert alert-secondary text-13 py-2 mb-3">
    Slack member source is disabled. Preview counts still reflect members who would be eligible if Slack were enabled.
  </div>
<% end %>

<% @reminder_settings.each do |reminder| %>
  <% if reminder.key == 'slack_signup' %>
    <div class="card shadow-sm border-0 mb-3">
      <div class="card-body">
        <div class="d-flex flex-wrap align-items-start justify-content-between gap-3">
          <div>
            <div class="d-flex align-items-center gap-2 mb-1">
              <span class="status-dot <%= reminder.enabled? ? 'status-success' : 'status-muted' %>"></span>
              <h2 class="h5 mb-0"><%= reminder.name %></h2>
            </div>
            <p class="text-13 text-secondary mb-2"><%= reminder.description %></p>
            <div class="text-13">
              <span class="fw-medium text-body"><%= @slack_due_count %></span>
              <span class="text-secondary">would be emailed today ·</span>
              <span class="text-secondary"><%= @slack_without_slack_count %> active without Slack</span>
            </div>
            <div class="text-12 text-secondary mt-1">
              Timing:
              <%= @membership_setting.slack_signup_reminder_initial_delay_days %> days after approval,
              every <%= @membership_setting.slack_signup_reminder_repeat_delay_days %> days,
              members who joined within <%= @membership_setting.slack_signup_reminder_max_account_age_months %> <%= 'month'.pluralize(@membership_setting.slack_signup_reminder_max_account_age_months) %>
              · <%= link_to "Edit in Membership settings", membership_settings_path, class: "text-secondary" %>
            </div>
          </div>
          <div class="d-flex flex-wrap align-items-center gap-2">
            <%= form_with model: reminder, url: reminder_setting_path(reminder.key), method: :patch, local: true, class: "d-flex align-items-center gap-2 mb-0" do |f| %>
              <div class="form-check form-switch mb-0">
                <%= f.check_box :enabled, class: 'form-check-input', role: 'switch', id: "reminder_enabled_#{reminder.key}" %>
                <%= f.label :enabled, reminder.enabled? ? 'Enabled' : 'Disabled', class: 'form-check-label text-13 text-nowrap', for: "reminder_enabled_#{reminder.key}" %>
              </div>
              <%= f.submit 'Save', class: 'btn btn-outline-secondary btn-sm', data: { turbo: false } %>
            <% end %>
            <%= link_to "View due list", reminder_setting_path(reminder.key), class: "btn btn-outline-secondary btn-sm" %>
            <% if @slack_email_template %>
              <%= link_to "Email template", email_template_path(@slack_email_template), class: "btn btn-outline-secondary btn-sm" %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% elsif reminder.key == 'application_link' %>
    <div class="card shadow-sm border-0 mb-3">
      <div class="card-body">
        <div class="d-flex flex-wrap align-items-start justify-content-between gap-3">
          <div>
            <div class="d-flex align-items-center gap-2 mb-1">
              <span class="status-dot <%= reminder.enabled? ? 'status-success' : 'status-muted' %>"></span>
              <h2 class="h5 mb-0"><%= reminder.name %></h2>
            </div>
            <p class="text-13 text-secondary mb-2"><%= reminder.description %></p>
            <div class="text-13">
              <span class="fw-medium text-body"><%= @application_link_due_count %></span>
              <span class="text-secondary">would be emailed today ·</span>
              <span class="text-secondary"><%= @application_link_awaiting_count %> awaiting application</span>
            </div>
            <div class="text-12 text-secondary mt-1">
              Timing:
              every <%= @membership_setting.application_link_reminder_delay_days %> days,
              up to <%= @membership_setting.application_link_reminder_max_count %> reminders
              · <%= link_to "Edit in Membership settings", membership_settings_path, class: "text-secondary" %>
            </div>
          </div>
          <div class="d-flex flex-wrap align-items-center gap-2">
            <%= form_with model: reminder, url: reminder_setting_path(reminder.key), method: :patch, local: true, class: "d-flex align-items-center gap-2 mb-0" do |f| %>
              <div class="form-check form-switch mb-0">
                <%= f.check_box :enabled, class: 'form-check-input', role: 'switch', id: "reminder_enabled_#{reminder.key}" %>
                <%= f.label :enabled, reminder.enabled? ? 'Enabled' : 'Disabled', class: 'form-check-label text-13 text-nowrap', for: "reminder_enabled_#{reminder.key}" %>
              </div>
              <%= f.submit 'Save', class: 'btn btn-outline-secondary btn-sm', data: { turbo: false } %>
            <% end %>
            <%= link_to "View due list", reminder_setting_path(reminder.key), class: "btn btn-outline-secondary btn-sm" %>
            <% if @application_link_email_template %>
              <%= link_to "Email template", email_template_path(@application_link_email_template), class: "btn btn-outline-secondary btn-sm" %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% elsif reminder.key == 'payment_overdue' %>
    <div class="card shadow-sm border-0 mb-3">
      <div class="card-body">
        <div class="d-flex flex-wrap align-items-start justify-content-between gap-3">
          <div>
            <div class="d-flex align-items-center gap-2 mb-1">
              <span class="status-dot <%= reminder.enabled? ? 'status-success' : 'status-muted' %>"></span>
              <h2 class="h5 mb-0"><%= reminder.name %></h2>
            </div>
            <p class="text-13 text-secondary mb-2"><%= reminder.description %></p>
            <div class="text-13">
              <span class="fw-medium text-body"><%= @payment_overdue_due_count %></span>
              <span class="text-secondary">would be emailed today ·</span>
              <span class="text-secondary"><%= @payment_overdue_total_count %> overdue</span>
            </div>
            <div class="text-12 text-secondary mt-1">
              Timing:
              every <%= @membership_setting.payment_overdue_reminder_repeat_days %> days while overdue,
              stopping after <%= @membership_setting.overdue_grace_period_days %> days when they become inactive
              · <%= link_to "Edit in Membership settings", membership_settings_path, class: "text-secondary" %>
            </div>
          </div>
          <div class="d-flex flex-wrap align-items-center gap-2">
            <%= form_with model: reminder, url: reminder_setting_path(reminder.key), method: :patch, local: true, class: "d-flex align-items-center gap-2 mb-0" do |f| %>
              <div class="form-check form-switch mb-0">
                <%= f.check_box :enabled, class: 'form-check-input', role: 'switch', id: "reminder_enabled_#{reminder.key}" %>
                <%= f.label :enabled, reminder.enabled? ? 'Enabled' : 'Disabled', class: 'form-check-label text-13 text-nowrap', for: "reminder_enabled_#{reminder.key}" %>
              </div>
              <%= f.submit 'Save', class: 'btn btn-outline-secondary btn-sm', data: { turbo: false } %>
            <% end %>
            <%= link_to "View due list", reminder_setting_path(reminder.key), class: "btn btn-outline-secondary btn-sm" %>
            <% if @payment_overdue_email_template %>
              <%= link_to "Email template", email_template_path(@payment_overdue_email_template), class: "btn btn-outline-secondary btn-sm" %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
<% end %>
