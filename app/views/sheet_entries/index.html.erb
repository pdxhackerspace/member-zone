<%= render layout: 'shared/list_page_header',
           locals: { title: 'Sheet entries', count: @sheet_entries.size, noun: 'entry' } do %>
  <% if MemberSource.enabled?('sheet') %>
    <%= button_to 'Sync now', sync_sheet_entries_path, method: :post,
                  class: 'btn btn-primary btn-sm', data: { turbo: false } %>
    <div class="dropdown">
      <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="dropdown"
              aria-expanded="false" aria-label="More actions">&hellip;</button>
      <ul class="dropdown-menu dropdown-menu-end">
        <li>
          <%= button_to 'Sync to members', sync_to_users_sheet_entries_path, method: :post,
                        class: 'dropdown-item', data: { turbo: false } %>
        </li>
        <li><%= link_to 'Test', test_sheet_entries_path, class: 'dropdown-item', data: { turbo: false } %></li>
      </ul>
    </div>
  <% else %>
    <button class="btn btn-outline-secondary btn-sm" disabled title="Google Sheet source is disabled">
      Sync now
    </button>
  <% end %>
<% end %>

<% if @filter_active %>
  <% label = { 'linked' => 'Linked', 'unlinked' => 'Unlinked', 'paying' => 'Paying',
               'sponsored' => 'Sponsored', 'inactive' => 'Inactive',
               'with_email' => 'With email' }[params[:filter]] %>
  <%= render 'shared/list_filter_banner', label: "#{label} entries", shown: @sheet_entries.size,
             total: @total_count, clear_path: sheet_entries_path %>
<% end %>

<%= render 'shared/list_filter_tiles', tiles: [
      { label: 'All', count: @total_count, path: sheet_entries_path, active: params[:filter].blank? },
      { label: 'Linked', count: @linked_count, path: sheet_entries_path(filter: 'linked'),
        active: params[:filter] == 'linked' },
      { label: 'Unlinked', count: @unlinked_count, path: sheet_entries_path(filter: 'unlinked'),
        active: params[:filter] == 'unlinked', variant: 'warning' }
    ] %>

<%# Paying, sponsored, inactive and having an email are facts about the roster row rather than
    the one bucket question above, so they read as chips. %>
<div class="card shadow-sm border-0 mb-3">
  <div class="card-body py-2">
    <%= render 'shared/list_filter_chip_row', label: 'Roster', chips: [
          { label: 'Paying', count: @paying_count, path: sheet_entries_path(filter: 'paying'),
            active: params[:filter] == 'paying' },
          { label: 'Sponsored', count: @sponsored_count, path: sheet_entries_path(filter: 'sponsored'),
            active: params[:filter] == 'sponsored' },
          { label: 'Inactive', count: @inactive_count, path: sheet_entries_path(filter: 'inactive'),
            active: params[:filter] == 'inactive' },
          { label: 'With email', count: @with_email_count, path: sheet_entries_path(filter: 'with_email'),
            active: params[:filter] == 'with_email' }
        ] %>
  </div>
</div>

<%= render 'shared/list_search', server: false,
           placeholder: 'Search by name, status, payment, or access…' %>

<% if @sheet_entries.any? %>
  <%= render layout: 'shared/list_table',
             locals: { body_id: 'sheet_entries_table_body',
                       headers: ['Name', 'Status', 'Payment', 'Access', 'Last synced'] } do %>
    <% @sheet_entries.each do |entry| %>
      <tr class="sheet-entry-row"
          data-live-filter-target="item"
          data-search-text="<%= [
            entry.name,
            entry.status.presence || 'inactive',
            entry.payment,
            entry.access_permissions.join(' ')
          ].compact.join(' ').downcase %>">
        <td><%= link_to entry.name, sheet_entry_path(entry), class: 'fw-medium text-decoration-none' %></td>
        <td>
          <%= list_status_cell(entry.status.presence || 'Inactive', tone: 'muted',
                               success: entry.status.to_s.casecmp('active').zero?) %>
        </td>
        <td><span class="text-secondary"><%= entry.payment.presence || '—' %></span></td>
        <td>
          <% if entry.access_permissions.any? %>
            <span class="text-secondary"><%= entry.access_permissions.join(', ') %></span>
          <% else %>
            <span class="text-secondary fst-italic">None recorded</span>
          <% end %>
        </td>
        <td><%= list_time_tag(entry.last_synced_at, empty: 'Never') %></td>
      </tr>
    <% end %>
  <% end %>
<% elsif @filter_active %>
  <%= render 'shared/list_empty', icon: 'table', message: 'No sheet entries match these filters.' %>
<% else %>
  <%= render 'shared/list_empty', icon: 'table', message: 'No sheet entries have been synced yet.' %>
<% end %>
