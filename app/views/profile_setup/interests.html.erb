<div class="py-4">
  <div class="row justify-content-center">
    <div class="col-lg-7">

      <%= render 'progress', current: 'interests' %>

      <!-- Member summary -->
      <div class="card shadow-sm border-0 mb-3">
        <div class="card-body py-2">
          <div class="d-flex align-items-center gap-3">
            <i class="bi bi-check-circle-fill text-success fs-4"></i>
            <div>
              <span class="fw-semibold"><%= @user.display_name %></span>
              <span class="text-muted ms-2"><%= @user.email %></span>
              <% if @user.username.present? %>
                <span class="text-muted ms-2">@<%= @user.username %></span>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <!-- Interests -->
      <div class="card shadow-sm border-0">
        <div class="card-header bg-body-tertiary">
          <h4 class="card-title mb-0"><i class="bi bi-tags me-2"></i>Interests</h4>
        </div>
        <div class="card-body"
             data-controller="interest-suggest"
             data-interest-suggest-interests-value="<%= @all_interests.to_json %>">
          <div class="alert alert-light border mb-4">
            <i class="bi bi-info-circle me-1"></i>
            This step is <strong>completely optional</strong>. Interests are visible to admins and, if your profile is visible to them, other members, and may be used to make automated recommendations about resources. Click an interest to select or deselect it — you can always change your interests later.
          </div>

          <% if @interests.any? %>
            <div data-controller="live-filter">
              <p class="text-muted small mb-2">Click any interest to add it to your profile:</p>

              <input type="search" class="form-control form-control-sm mb-3"
                     placeholder="Search interests…" autocomplete="off"
                     aria-label="Search interests"
                     data-live-filter-target="input"
                     data-action="input->live-filter#filter">

              <div class="d-flex flex-wrap gap-2 mb-2">
                <% @interests.each do |interest| %>
                  <%= render 'interest_pill', interest: interest,
                             selected: @user_interest_ids.include?(interest.id) %>
                <% end %>
              </div>

              <p class="text-muted fst-italic small mb-4 d-none" data-live-filter-target="noResults">
                No interests match your search — you can add it as a new interest below.
              </p>
            </div>

          <% else %>
            <p class="text-muted fst-italic mb-4">No interests have been added yet. An admin can add interests under Settings.</p>
          <% end %>

          <!-- Add new interest -->
          <div class="border-top pt-4 mt-2">
            <p class="text-muted small mb-2">Don't see your interest? Add it:</p>
            <%= form_with url: profile_setup_suggest_interest_path, method: :post, local: true,
                          class: "row g-2 align-items-end",
                          data: { interest_suggest_target: "form" } do %>
              <div class="col-md-8 position-relative">
                <input type="text" name="interest_name"
                       class="form-control form-control-sm"
                       placeholder="e.g., textile electronics, hydroponics…"
                       maxlength="80" autocomplete="off"
                       data-interest-suggest-target="input"
                       data-action="input->interest-suggest#filter
                                    blur->interest-suggest#hideSuggestions
                                    focus->interest-suggest#showSuggestionsIfPresent
                                    keydown->interest-suggest#inputKeydown">
                <div class="list-group shadow-sm position-absolute w-100 mt-1"
                     style="display:none; z-index:1000; max-height:220px; overflow-y:auto;"
                     data-interest-suggest-target="suggestions"
                     data-action="keydown->interest-suggest#suggestionsKeydown"></div>
              </div>
              <div class="col-md-4">
                <button type="submit" class="btn btn-outline-primary btn-sm w-100">Add New Interest</button>
              </div>
            <% end %>
          </div>

          <div class="d-flex justify-content-between mt-4">
            <%= link_to "Back", profile_setup_links_path, class: "btn btn-outline-secondary btn-lg" %>
            <div class="d-flex gap-2">
              <%= link_to "Skip", profile_setup_visibility_path, class: "btn btn-outline-secondary btn-lg" %>
              <%= link_to "Continue", profile_setup_visibility_path, class: "btn btn-primary btn-lg" %>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>
