# -----------------------------------------------------------------------------
# Staging — RAILS_ENV=staging (inherits production.rb + letter_opener_web).
#
# Outbound email is captured only; browse at https://YOUR_HOST/letter_opener
# (protect that path at your reverse proxy). SMTP settings below are optional
# and unused for delivery in staging.
# -----------------------------------------------------------------------------

RAILS_ENV=staging

# RAILS_MASTER_KEY=<from credentials or secrets manager>

# --- App URLs & branding ---
APP_BASE_URL=https://staging.example.com
MEMBER_ZONE_BASE_URL=https://staging.example.com
ORGANIZATION_NAME=Member Zone (staging)
GITHUB_REPOSITORY_URL=https://github.com/pdxhackerspace/member-manager
EMAIL_FROM_ADDRESS=noreply@staging.example.com
EMAIL_SUPPORT_ADDRESS=support@staging.example.com
TIMEZONE=UTC

# --- Database ---
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/member_manager_staging
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
# DB_PASSWORD=
# DATABASE_URL=

# --- Redis / Sidekiq / Action Cable ---
REDIS_URL=redis://localhost:6379/1

# --- Puma (same behavior as production) ---
# WEB_CONCURRENCY=2
# RAILS_MAX_THREADS=5
# RAILS_LOG_LEVEL=info

# --- Optional: SMTP (not used for delivery in staging; letter_opener_web captures mail) ---
# SMTP_ADDRESS=
# SMTP_PORT=587
# SMTP_DOMAIN=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_AUTHENTICATION=plain
# SMTP_ENABLE_STARTTLS=true

# --- Omniauth / Authentik ---
AUTHENTIK_ISSUER=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI=
AUTHENTIK_GROUP_ID=
AUTHENTIK_API_BASE_URL=
AUTHENTIK_API_TOKEN=
AUTHENTIK_WEBHOOK_SECRET=
AUTHENTIK_GROUP_PAGE_SIZE=200

# --- Integrations ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
RECHARGE_API_KEY=
RECHARGE_WEBHOOK_SECRET=
GOOGLE_SHEETS_CREDENTIALS=
GOOGLE_SHEETS_ID=
SLACK_API_TOKEN=
KOFI_VERIFICATION_TOKEN=
ACCESS_WEBHOOK_KEY=

# --- Webhook authentication ---
# AUTHENTIK_WEBHOOK_SECRET, RECHARGE_WEBHOOK_SECRET, KOFI_VERIFICATION_TOKEN, ACCESS_WEBHOOK_KEY,
# and RFID_WEBHOOK_IP_WHITELIST are required here as well as in production: an unset one refuses
# every request to that endpoint rather than accepting them unauthenticated. Set
# ALLOW_UNVERIFIED_WEBHOOKS=true only to deliberately test an endpoint without its secret.
# ALLOW_UNVERIFIED_WEBHOOKS=false

# --- Field encryption (openssl rand -hex 32 per key; see docs/encrypted-fields.md) ---
# Left unset, both are derived from secret_key_base, which works but ties field encryption to
# the rest of the app's secrets. Setting them on a deployment that already has encrypted rows
# means re-encrypting first: neither key can be rotated in place.
DATABASE_FIELD_ENCRYPTION_KEY=
EMAIL_LOOKUP_HMAC_KEY=

# --- Observability ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# --- Misc ---
# APP_VERSION=0.0.0-staging
# SYSLOG_SERVER=
# SYSLOG_PORT=
# ACCESS_LOGS_DIRECTORY=
# RFID_WEBHOOK_IP_WHITELIST=
