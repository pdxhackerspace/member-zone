<%= render 'settings/index_refresh' %>
<% if false %>
<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0">Settings</h1>
</div>

<div class="row g-4">
  <div class="col-md-6 col-lg-4">
    <div class="card shadow-sm border-0 h-100">
      <div class="card-body d-flex flex-column">
        <h5 class="card-title">Application Form</h5>
        <p class="card-text text-muted">Configure the pages and questions for the public membership application form.</p>
        <%= link_to "Manage Application Form", application_form_pages_path, class: "btn btn-primary mt-auto" %>
      </div>
    </div>
  </div>
  <div class="col-md-6 col-lg-4">
    <div class="card shadow-sm border-0 h-100">
      <div class="card-body d-flex flex-column">
        <h5 class="card-title">AI Services</h5>
        <p class="card-text text-muted">Configure service-level model, provider selection, prompts, and health checks.</p>
        <%= link_to "Manage AI Services", ai_ollama_profiles_path, class: "btn btn-primary mt-auto" %>
      </div>
    </div>
  </div>
  <div class="col-md-6 col-lg-4">
    <div class="card shadow-sm border-0 h-100">
      <div class="card-body d-flex flex-column">
        <h5 class="card-title">AI Providers</h5>
        <p class="card-text text-muted">Manage reusable AI providers with URL and optional API keys.</p>
        <%= link_to "Manage AI Providers", ai_providers_path, class: "btn btn-primary mt-auto" %>
      </div>
    </div>
  </div>
  <div class="col-md-6 col-lg-4">
    <div class="card shadow-sm border-0 h-100">
      <div class="card-body d-flex flex-column">
        <h5 class="card-title">Access Controller Types</h5>
        <p class="card-text text-muted">Manage SSH script types and optional ACCESS_TOKEN values.</p>
        <%= link_to "Manage Access Controller Types", access_controller_types_path, class: "btn btn-primary mt-auto" %>
      </div>
    </div>
  </div>
  <div class="col-md-6 col-lg-4">
    <div class="card shadow-sm border-0 h-100">
      <div class="card-body d-flex flex-column">
        <h5 class="card-title">Access Controllers</h5>
        <p class="card-text text-muted">Manage access control devices that receive RFID key updates via SSH.</p>
        <%= link_to "Manage Access Controllers", access_controllers_path, class: "btn btn-primary mt-auto" %>
      </div>
    </div>
  </div>
  <div class="col-md-6 col-lg-4">
    <div class="card shadow-sm border-0 h-100">
      <div class="card-body d-flex flex-column">
        <h5 class="card-title">Core groups and Authentik naming</h5>
        <p class="card-text text-muted">Custom core groups, built-in member groups, and Authentik name prefixes.</p>
        <%= link_to "Manage Defaults", default_settings_path, class: "btn btn-primary mt-auto" %>
      </div>
    </div>
  </div>
  <div class="col-md-6 col-lg-4">
    <div class="card shadow-sm border-0 h-100">
      <div class="card-body d-flex flex-column">
        <h5 class="card-title">Applications</h5>
        <p class="card-text text-muted">Manage applications and their groups, and assign members to application groups.</p>
        <%= link_to "Manage Applications", applications_path, class: "btn btn-primary mt-auto" %>
      </div>
    </div>
  </div>
  <div class="col-md-6 col-lg-4">
    <div class="card shadow-sm border-0 h-100">
      <div class="card-body d-flex flex-column">
        <h5 class="card-title">Authentik Webhooks</h5>
        <p class="card-text text-muted">Configure automatic webhook notifications from Authentik for user and group changes.</p>
        <%= link_to "Manage Authentik Webhooks", authentik_webhooks_path, class: "btn btn-primary mt-auto" %>
      </div>
    </div>
  </div>
  <div class="col-md-6 col-lg-4">
    <div class="card shadow-sm border-0 h-100">
      <div class="card-body d-flex flex-column">
        <h5 class="card-title">Documents</h5>
        <p class="card-text text-muted">Upload documents for all members or associate them with training topics.</p>
        <%= link_to "Manage Documents", documents_path, class: "btn btn-primary mt-auto" %>
      </div>
    </div>
  </div>
  <div class="col-md-6 col-lg-4">
    <div class="card shadow-sm border-0 h-100">
      <div class="card-body d-flex flex-column">
        <h5 class="card-title">Email Templates</h5>
        <p class="card-text text-muted">Customize the email messages sent to members for applications, approvals, payments, and more.</p>
        <%= link_to "Manage Email Templates", email_templates_path, class: "btn btn-primary mt-auto" %>
      </div>
    </div>
  </div>
  <div class="col-md-6 col-lg-4">
    <div class="card shadow-sm border-0 h-100">
      <div class="card-body d-flex flex-column">
        <h5 class="card-title">Interests</h5>
        <p class="card-text text-muted">Manage the list of interests members can select for their profiles. Add, rename, merge, and see who's chosen each one.</p>
        <%= link_to "Manage Interests", interests_path, class: "btn btn-primary mt-auto" %>
      </div>
    </div>
  </div>
  <div class="col-md-6 col-lg-4">
    <div class="card shadow-sm border-0 h-100">
      <div class="card-body d-flex flex-column">
        <h5 class="card-title">Invitations</h5>
        <p class="card-text text-muted">View all membership invitations, their status, and linked member accounts.</p>
        <%= link_to "View Invitations", invitations_path, class: "btn btn-primary mt-auto" %>
      </div>
    </div>
  </div>
  <div class="col-md-6 col-lg-4">
    <div class="card shadow-sm border-0 h-100">
      <div class="card-body d-flex flex-column">
        <h5 class="card-title">Incoming Webhooks</h5>
        <p class="card-text text-muted">View and manage webhook URLs for RFID, Ko-Fi, access logs, and Authentik integrations.</p>
        <%= link_to "Manage Incoming Webhooks", incoming_webhooks_path, class: "btn btn-primary mt-auto" %>
      </div>
    </div>
  </div>
  <div class="col-md-6 col-lg-4">
    <div class="card shadow-sm border-0 h-100">
      <div class="card-body d-flex flex-column">
        <h5 class="card-title">Member Sources</h5>
        <p class="card-text text-muted">Track Authentik, Sheet, and Slack integrations and identify records needing reconciliation.</p>
        <%= link_to "Manage Member Sources", member_sources_path, class: "btn btn-primary mt-auto" %>
      </div>
    </div>
  </div>
  <div class="col-md-6 col-lg-4">
    <div class="card shadow-sm border-0 h-100">
      <div class="card-body d-flex flex-column">
        <h5 class="card-title">Membership Plans</h5>
        <p class="card-text text-muted">Manage membership plans with costs, billing frequencies, and descriptions.</p>
        <%= link_to "Manage Membership Plans", membership_plans_path, class: "btn btn-primary mt-auto" %>
      </div>
    </div>
  </div>
  <div class="col-md-6 col-lg-4">
    <div class="card shadow-sm border-0 h-100">
      <div class="card-body d-flex flex-column">
        <h5 class="card-title">Membership Settings</h5>
        <p class="card-text text-muted">Configure payment grace periods and reactivation windows for memberships.</p>
        <%= link_to "Manage Settings", membership_settings_path, class: "btn btn-primary mt-auto" %>
      </div>
    </div>
  </div>
  <div class="col-md-6 col-lg-4">
    <div class="card shadow-sm border-0 h-100">
      <div class="card-body d-flex flex-column">
        <h5 class="card-title">Payment Processors</h5>
        <p class="card-text text-muted">Monitor and manage PayPal, Recharge, and Ko-Fi payment integrations and sync status.</p>
        <%= link_to "Manage Payment Processors", payment_processors_path, class: "btn btn-primary mt-auto" %>
      </div>
    </div>
  </div>
  <div class="col-md-6 col-lg-4">
    <div class="card shadow-sm border-0 h-100">
      <div class="card-body d-flex flex-column">
        <h5 class="card-title">Rooms</h5>
        <p class="card-text text-muted">Manage the list of rooms and locations used for parking permits and tickets.</p>
        <%= link_to "Manage Rooms", rooms_path, class: "btn btn-primary mt-auto" %>
      </div>
    </div>
  </div>
  <div class="col-md-6 col-lg-4">
    <div class="card shadow-sm border-0 h-100">
      <div class="card-body d-flex flex-column">
        <h5 class="card-title">Printers</h5>
        <p class="card-text text-muted">Configure CUPS printers for printing parking notices, incident reports, and other documents.</p>
        <%= link_to "Manage Printers", printers_path, class: "btn btn-primary mt-auto" %>
      </div>
    </div>
  </div>
  <div class="col-md-6 col-lg-4">
    <div class="card shadow-sm border-0 h-100">
      <div class="card-body d-flex flex-column">
        <h5 class="card-title">RFID Readers</h5>
        <p class="card-text text-muted">Manage RFID readers and their API keys for keyfob authentication.</p>
        <%= link_to "Manage RFID Readers", rfid_readers_path, class: "btn btn-primary mt-auto" %>
      </div>
    </div>
  </div>
  <div class="col-md-6 col-lg-4">
    <div class="card shadow-sm border-0 h-100">
      <div class="card-body d-flex flex-column">
        <h5 class="card-title">Text Fragments</h5>
        <p class="card-text text-muted">Edit HTML content fragments like help text and informational messages shown to members.</p>
        <%= link_to "Manage Text", text_fragments_path, class: "btn btn-primary mt-auto" %>
      </div>
    </div>
  </div>
  <div class="col-md-6 col-lg-4">
    <div class="card shadow-sm border-0 h-100">
      <div class="card-body d-flex flex-column">
        <h5 class="card-title">Training Topics</h5>
        <p class="card-text text-muted">Manage the list of training topics that members can be trained on or can train others in.</p>
        <%= link_to "Manage Training Topics", training_topics_path, class: "btn btn-primary mt-auto" %>
      </div>
    </div>
  </div>
</div>
<% end %>
