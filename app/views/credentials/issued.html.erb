<%# Turbo keeps its own snapshot of pages for back/forward; this one holds a secret. %>
<% content_for :head, tag.meta(name: 'turbo-cache-control', content: 'no-cache') %>

<div class="mb-3">
  <h1 class="h-page-title mb-0">Your new credential</h1>
  <div class="text-13 text-secondary mt-1">
    <%= @credential.credential_provider.schema_display_name %>
    <% if @credential.label.present? %>· <%= @credential.label %><% end %>
    <% if @credential.user != current_user %>· for <%= @credential.user.display_name %><% end %>
  </div>
</div>

<div class="alert alert-warning text-13">
  <strong>Copy this now.</strong> It is shown only once and cannot be recovered. If you lose it, revoke it and request
  a new one.
</div>

<% if @warning.present? %>
  <div class="alert alert-info text-13"><%= @warning %></div>
<% end %>

<div class="card shadow-sm border-0 mb-3">
  <div class="card-body">
    <% @fields.each do |field| %>
      <div class="mb-3" data-controller="copy">
        <label class="form-label" for="credential-field-<%= field['key'] %>">
          <%= field['label'] %>
          <% unless field['secret'] %><span class="text-secondary text-12">(not secret)</span><% end %>
        </label>
        <div class="input-group">
          <input type="text" id="credential-field-<%= field['key'] %>" class="form-control font-monospace"
                 readonly autocomplete="off" value="<%= field['value'] %>" data-copy-target="source">
          <button type="button" class="btn btn-outline-secondary" data-action="copy#copy"
                  data-copy-target="button">Copy</button>
        </div>
      </div>
    <% end %>
    <% if @credential.expires_at %>
      <div class="text-13 text-secondary">Expires <%= l(@credential.expires_at.to_date, format: :long) %>.</div>
    <% end %>
  </div>
</div>

<%= link_to "I've saved this", credentials_path, class: "btn btn-primary btn-sm" %>
