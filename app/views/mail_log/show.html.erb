<% field = ->(label, &block) { render(layout: 'shared/detail_field_row', locals: { label: label }, &block) } %>

<div class="mb-2 text-13">
  <%= link_to mail_log_path, class: 'text-secondary text-decoration-none' do %>
    <i class="bi bi-arrow-left me-1"></i>Mail log
  <% end %>
</div>

<div class="d-flex flex-column flex-md-row align-items-md-end justify-content-between gap-2 mb-3">
  <div>
    <h1 class="h-page-title mb-0 text-break"><%= @log_entry.message_subject.presence || '(no subject)' %></h1>
    <div class="text-13 text-secondary mt-1">
      <%= mail_log_event_cell(@log_entry.event) %>
      <% if @log_entry.created_at %>
        · <%= list_time_tag(@log_entry.created_at) %>
      <% end %>
      <% if (state = mail_log_queue_state(@log_entry.queued_mail)) %>
        · now <%= state.downcase %>
      <% end %>
    </div>
  </div>
  <% if @log_entry.queued_mail && can?(:'queued_mail.view') %>
    <div class="d-flex gap-2 flex-shrink-0">
      <%= link_to 'Queued message', queued_mail_path(@log_entry.queued_mail), class: 'btn btn-outline-secondary btn-sm' %>
    </div>
  <% end %>
</div>

<div class="row g-4">
  <div class="col-lg-4">
    <div class="profile-section-header"><h2 class="h-section-label mb-0">Message</h2></div>
    <div class="profile-field-group mb-4">
      <%= field.call('To') { @log_entry.message_to } %>
      <% if @log_entry.queued_mail&.recipient %>
        <%= field.call('Member') do %>
          <%= link_to @log_entry.queued_mail.recipient.display_name, user_path(@log_entry.queued_mail.recipient),
                      class: 'text-decoration-none' %>
        <% end %>
      <% end %>
      <% if @log_entry.details.present? %>
        <%= field.call('Details') { @log_entry.details } %>
      <% end %>
    </div>

    <div class="profile-section-header"><h2 class="h-section-label mb-0">System</h2></div>
    <div class="profile-field-group profile-field-group-compact text-secondary">
      <%= field.call('Event') { mail_log_event_label(@log_entry.event) } %>
      <% if @log_entry.delivery_mailer.present? %>
        <%= field.call('Mailer') { tag.code("#{@log_entry.delivery_mailer}##{@log_entry.delivery_action}") } %>
      <% end %>
      <%= field.call('By') do %>
        <% if @log_entry.actor %>
          <%= link_to @log_entry.actor.display_name, user_path(@log_entry.actor), class: 'text-secondary' %>
        <% else %>
          System
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="col-lg-8">
    <div class="profile-section-header"><h2 class="h-section-label mb-0">Message sent</h2></div>
    <% if @log_entry.message_body_html.present? %>
      <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-0">
          <iframe id="mail_preview" srcdoc="<%= ERB::Util.html_escape(@log_entry.message_body_html) %>"
                  style="width: 100%; min-height: 400px; border: none;"
                  sandbox="allow-same-origin"></iframe>
        </div>
      </div>
    <% else %>
      <div class="mb-4">
        <%= render 'shared/list_empty', icon: 'envelope-x', message: 'No HTML snapshot was kept for this entry.' %>
      </div>
    <% end %>

    <% if @log_entry.message_body_text.present? %>
      <div class="profile-section-header"><h2 class="h-section-label mb-0">Plain text</h2></div>
      <div class="card shadow-sm border-0">
        <div class="card-body">
          <pre class="mb-0 text-body text-13" style="white-space: pre-wrap;"><%= @log_entry.message_body_text %></pre>
        </div>
      </div>
    <% end %>
  </div>
</div>

<%= render 'shared/mail_preview_resize' %>
