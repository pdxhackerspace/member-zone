<h1>Your parking permit</h1>

<p>Hello <%= @user.display_name %>,</p>

<% if @template_key == 'parking_permit_form_link' %>
  <p>You asked for a parking permit at <%= @device_name %>. Use the link below to fill it in and print it.</p>
  <p><%= link_to 'Fill in your parking permit', @permit_form_url %></p>
<% else %>
  <p>You have a parking permit valid until <%= @permit_expires_at %>. Please record what you parked and where.</p>
  <p><%= link_to 'Fill in your permit online', @permit_form_url %></p>
<% end %>

<p>This link works until <%= @permit_form_expires_at %> and does not sign you in to Member Zone.</p>

<p>Best regards,<br>
The <%= @organization %> Team</p>
