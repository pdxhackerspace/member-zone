<% members_summary = capture do %>
  <span class="text-body"><%= number_with_delimiter(@user_count) %></span> members<%= " (including #{@legacy_count} legacy)" if @include_legacy && @legacy_count.positive? %> ·
  <%= link_to stacking_filter_path(:active, 'true'), class: 'text-decoration-none' do %>
    <span class="text-success"><%= @active_count %></span> active
  <% end %>,
  <%= link_to stacking_filter_path(:active, 'false'), class: 'text-decoration-none' do %>
    <span class="text-secondary"><%= @inactive_count %></span> inactive
  <% end %>
  <% if @filter_active || @include_legacy %>
    <span class="fst-italic">(filtered counts)</span>
  <% end %>
<% end %>

<%= render layout: 'shared/list_page_header', locals: { title: 'Members', summary: members_summary } do %>
  <%# Bulk Authentik operations have no privilege of their own, so the directory is
      readable without them. %>
  <% if current_user_admin? %>
    <% settings = DefaultSetting.instance %>
    <% sync_inactive_as_active = settings.authentik_sync_inactive_as_active? %>
    <%= button_to toggle_authentik_sync_inactive_as_active_users_path, method: :post,
        class: "btn btn-sm #{sync_inactive_as_active ? 'btn-outline-success' : 'btn-outline-secondary'}",
        data: { turbo: false, turbo_confirm: sync_inactive_as_active ? 'Stop keeping inactive members active in Authentik? They will be set inactive there.' : 'Keep inactive members active in Authentik? They will be re-synced as active.' },
        title: sync_inactive_as_active ? 'On — inactive members are kept active in Authentik. Click to turn off.' : 'Off — inactive members are set inactive in Authentik. Click to turn on.' do %>
      <i class="bi bi-<%= sync_inactive_as_active ? 'check-circle-fill' : 'x-circle' %> me-1"></i>
      Inactive synced as active: <span class="fw-medium"><%= sync_inactive_as_active ? 'On' : 'Off' %></span>
    <% end %>
    <% if MemberSource.enabled?('member_zone') %>
      <%= button_to 'Sync to Authentik', sync_all_to_authentik_users_path, method: :post,
                    class: 'btn btn-outline-secondary btn-sm',
                    data: { turbo: false, turbo_confirm: 'This will sync all members, groups, and the active members group to Authentik. Continue?' } %>
    <% else %>
      <button class="btn btn-outline-secondary btn-sm" disabled title="Member Zone source is disabled">
        Sync to Authentik
      </button>
    <% end %>
  <% end %>
<% end %>

<% if @filter_active || @include_legacy %>
  <%
    filter_labels = []
    filter_labels << "Including legacy" if @include_legacy
    filter_labels << "Membership: #{membership_state_label(params[:membership_state])}" if params[:membership_state].present?
    filter_labels << "Membership: #{membership_status_label(params[:membership_status])}" if params[:membership_status].present?
    filter_labels << "Payment: #{params[:payment_type].humanize}" if params[:payment_type].present?
    filter_labels << "Dues: #{params[:dues_status].humanize}" if params[:dues_status].present?
    filter_labels << "Search: #{params[:q]}" if params[:q].present?
    if params[:membership_plan_id].present?
      plan_name = params[:membership_plan_id] == 'none' ? 'No Plan' : MembershipPlan.find_by(id: params[:membership_plan_id])&.name || 'Unknown'
      filter_labels << "Plan: #{plan_name}"
    end
    filter_labels << (params[:active] == 'true' ? 'Active only' : 'Inactive only') if params[:active].present?
    filter_labels << 'Active override' if params[:emergency_active_override] == '1'
    filter_labels << "Missing: #{params[:missing] == 'rfid' ? 'No RFID' : 'No Email'}" if params[:missing].present?
    filter_labels << 'Key access paused' if params[:key_access] == 'paused'
    if params[:account_type].present?
      filter_labels << (params[:account_type] == 'service' ? 'Service Accounts' : 'Members Only')
    end
  %>
  <%= render 'shared/list_filter_banner', label: filter_labels.to_sentence(two_words_connector: ' + ',
                                                                           last_word_connector: ' + '),
             shown: @filtered_count || @users.count, total: @user_count, noun: 'member',
             clear_path: users_path %>
<% end %>

<div class="card shadow-sm border-0 mb-3">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center mb-2">
      <p class="text-13 text-secondary mb-0">
        <% active_filter_count = @filter_params.except(:sort, :direction, :include_legacy).size + (@include_legacy ? 1 : 0) %>
        <%= active_filter_count %> <%= 'filter'.pluralize(active_filter_count) %> active
        <% if active_filter_count.positive? %>
          · <%= link_to 'Clear', users_path, class: 'link-secondary' %>
        <% end %>
      </p>
      <% if @legacy_count.positive? %>
        <div class="form-check mb-0">
          <input class="form-check-input" type="checkbox" id="include_legacy_checkbox"
                 <%= 'checked' if @include_legacy %>
                 onchange="window.location.href='<%= stacking_filter_path(:include_legacy, @include_legacy ? nil : '1') %>'">
          <label class="form-check-label text-13" for="include_legacy_checkbox">
            <i class="bi bi-archive me-1"></i>Include legacy (<%= @legacy_count %>)
          </label>
        </div>
      <% end %>
    </div>

    <%# Every axis here stacks with the others, so each one is a row of chips rather than a
        tile row: tiles say "pick one of these", and that is not what these do. %>
    <% membership_chips = User::MEMBERSHIP_STATE_FILTER_ORDER.filter_map do |state|
         count = @membership_state_counts.fetch(state, 0)
         next if count.zero? && params[:membership_state] != state

         { label: membership_state_label(state), count: count,
           path: stacking_filter_path(:membership_state, state),
           active: params[:membership_state] == state,
           variant: membership_state_filter_chip_class(state).presence }
       end %>
    <%= render 'shared/list_filter_chip_row', label: 'Membership', chips: membership_chips %>

    <%= render 'shared/list_filter_chip_row', label: 'Payment type', chips: %w[unknown sponsored paypal recharge cash].map { |type|
          { label: type.humanize, count: @payment_type_counts.fetch(type, 0),
            path: stacking_filter_path(:payment_type, type), active: params[:payment_type] == type }
        } %>

    <% plan_chips = @plan_counts.filter_map do |plan, count|
         next if count.zero?

         { label: plan.name, count: count, path: stacking_filter_path(:membership_plan_id, plan.id.to_s),
           active: params[:membership_plan_id] == plan.id.to_s }
       end %>
    <% if @no_plan_count.positive? %>
      <% plan_chips << { label: 'No plan', count: @no_plan_count,
                         path: stacking_filter_path(:membership_plan_id, 'none'),
                         active: params[:membership_plan_id] == 'none' } %>
    <% end %>
    <%= render 'shared/list_filter_chip_row', label: 'Payment plan', chips: plan_chips %>

    <%= render 'shared/list_filter_chip_row', label: 'Account', chips: [
          { label: 'Members', count: @member_account_count, path: stacking_filter_path(:account_type, 'member'),
            active: params[:account_type] == 'member' },
          { label: 'Service accounts', count: @service_account_count,
            path: stacking_filter_path(:account_type, 'service'), active: params[:account_type] == 'service' },
          { label: 'Active override', count: @emergency_active_override_count,
            path: stacking_filter_path(:emergency_active_override, '1'),
            active: params[:emergency_active_override] == '1', variant: 'warning' },
          { label: 'Key paused', count: @key_paused_count, path: stacking_filter_path(:key_access, 'paused'),
            active: params[:key_access] == 'paused', variant: 'warning' }
        ] %>

    <%= render 'shared/list_filter_chip_row', label: 'Missing data', chips: [
          { label: 'No RFID', count: @no_rfid_count, path: stacking_filter_path(:missing, 'rfid'),
            active: params[:missing] == 'rfid', variant: 'warning' },
          { label: 'No email', count: @no_email_count, path: stacking_filter_path(:missing, 'email'),
            active: params[:missing] == 'email', variant: 'warning' }
        ] %>
  </div>
</div>

<%= form_with url: users_path, method: :get, local: true,
              data: { controller: "live-filter", live_filter_server_value: true, turbo_frame: "users_results" } do |form| %>
  <% request.query_parameters.except('q', 'page').each do |key, value| %>
    <%= hidden_field_tag key, value %>
  <% end %>
  <div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
      <div class="d-flex gap-2">
        <%= form.text_field :q, value: params[:q], class: "form-control form-control-sm",
                            placeholder: "Search by name, full email, or Authentik ID…",
                            autocomplete: "off", autocorrect: "off", autocapitalize: "off", spellcheck: "false",
                            data: { live_filter_target: "input", action: "input->live-filter#filter" } %>
        <button type="button" class="btn btn-outline-secondary <%= 'd-none' unless params[:q].present? %>"
                data-live-filter-target="clearButton" data-action="click->live-filter#clear">Clear</button>
      </div>
    </div>
  </div>
<% end %>

<%= turbo_frame_tag "users_results" do %>
  <% if @recent_members.any? && !@filter_active && !@include_legacy %>
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-header bg-body-tertiary">
        <h6 class="mb-0"><i class="bi bi-person-plus me-1"></i>New Members This Week (<%= @recent_members.size %>)</h6>
      </div>
      <div class="table-responsive">
          <table class="table table-list mb-0 align-middle">
          <thead>
            <tr>
              <th scope="col" class="avatar-col"></th>
              <th scope="col">Username</th>
              <th scope="col">Name</th>
              <th scope="col">Email</th>
              <th scope="col">Status</th>
              <th scope="col">Joined</th>
            </tr>
          </thead>
          <tbody>
            <% @recent_members.each do |user| %>
              <tr>
                <td>
                  <%= link_to user_path(user, @list_params), data: { turbo_frame: "_top" } do %>
                    <%= render 'shared/user_avatar', user: user %>
                  <% end %>
                </td>
                <td class="small text-monospace text-secondary fw-semibold"><%= link_to user.username, user_path(user, @list_params), class: "text-decoration-none text-secondary", data: { turbo_frame: "_top" } %></td>
                <td class="fw-semibold"><%= link_to user.display_name, user_path(user, @list_params), class: "text-decoration-none", data: { turbo_frame: "_top" } %></td>
                <td>
                  <% if user.email.present? %>
                    <%= mail_to user.email %>
                  <% else %>
                    <span class="text-muted fst-italic">Not provided</span>
                  <% end %>
                </td>
                <td>
                  <span class="badge <%= membership_state_badge_subtle_class(user.membership_state) %>"><%= membership_state_label(user.membership_state) %></span>
                </td>
                <td class="text-muted small"><%= time_ago_in_words(user.created_at) %> ago</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>

  <div class="card shadow-sm border-0">
    <div class="table-responsive">
      <table class="table table-list mb-0 align-middle">
      <thead>
        <tr>
          <th scope="col" class="avatar-col"></th>
          <th scope="col"><%= sortable_column('username', 'Username', @sort_column, @sort_direction) %></th>
          <th scope="col"><%= sortable_column('full_name', 'Name', @sort_column, @sort_direction) %></th>
          <th scope="col">Email</th>
          <th scope="col"><%= sortable_column('membership_state', 'Status', @sort_column, @sort_direction) %></th>
          <th scope="col"><%= sortable_column('payment_type', 'Payment Type', @sort_column, @sort_direction) %></th>
          <th scope="col"><%= sortable_column('last_synced_at', 'Last synced', @sort_column, @sort_direction) %></th>
        </tr>
      </thead>
      <tbody id="users_table_body">
        <% @users.each do |user| %>
          <tr class="user-row"
              data-live-filter-target="item"
              data-search-text="<%= [user.username, user.display_name, user.email, user.authentik_id].compact.join(' ').downcase %>">
            <td>
              <%= link_to user_path(user, @list_params), data: { turbo_frame: "_top" } do %>
                <%= render 'shared/user_avatar', user: user %>
              <% end %>
            </td>
            <td class="small text-monospace text-secondary fw-semibold"><%= link_to user.username, user_path(user, @list_params), class: "text-decoration-none text-secondary", data: { turbo_frame: "_top" } %></td>
            <td class="fw-semibold">
              <%= link_to user.display_name, user_path(user, @list_params), class: "text-decoration-none", data: { turbo_frame: "_top" } %>
              <% if user.is_sponsored? %>
                <span class="badge text-bg-info-subtle ms-1"><i class="bi bi-heart-fill me-1"></i>Sponsored</span>
              <% end %>
              <% if user.service_account? %>
                <span class="badge text-bg-secondary-subtle ms-1"><i class="bi bi-gear-fill me-1"></i>Service</span>
              <% end %>
              <% if user.legacy? %>
                <span class="badge text-bg-secondary-subtle ms-1"><i class="bi bi-archive me-1"></i>Legacy</span>
              <% end %>
            </td>
            <td>
              <% if user.email.present? %>
                <%= mail_to user.email %>
              <% else %>
                <span class="text-muted fst-italic">Not provided</span>
              <% end %>
            </td>
            <td>
              <% if user.service_account? %>
                <span class="text-muted">–</span>
              <% elsif user.current_member? %>
                <span class="status-dot <%= membership_state_dot_class(user.membership_state) %>" title="Current"></span>
              <% else %>
                <span class="badge <%= membership_state_badge_subtle_class(user.membership_state) %>">
                  <%= membership_state_label(user.membership_state) %>
                </span>
              <% end %>
              <% if user.emergency_active_override? %>
                <span class="badge text-bg-warning-subtle ms-1" title="Access forced on by an admin">Override</span>
              <% end %>
            </td>
            <td>
              <% if user.service_account? %>
                <span class="text-muted">–</span>
              <% else %>
                <span class="badge text-bg-secondary-subtle"><%= user.payment_type.humanize %></span>
              <% end %>
            </td>
            <td>
              <% if user.last_synced_at %>
                <span class="text-secondary text-12" title="<%= l(user.last_synced_at, format: :long) %>"><%= time_ago_in_words(user.last_synced_at) %> ago</span>
              <% else %>
                <span class="text-secondary text-12">n/a</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  </div>
  <%= render 'shared/pagination', pagy: @pagy %>
<% end %>

