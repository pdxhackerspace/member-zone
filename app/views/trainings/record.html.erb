<div class="d-flex flex-column">
  <div class="text-12 text-secondary mb-2">
    <%= link_to "&lsaquo; Dashboard".html_safe, root_path, class: "text-decoration-none" %>
  </div>

  <div class="mb-3">
    <h1 class="h-page-title mb-0">Record training</h1>
    <div class="text-13 text-secondary mt-1">
      Pick topics, add members, then record them as trained or make them trainers. Anything already done is
      skipped.
    </div>
  </div>

  <% if @record_topics.empty? %>
    <div class="alert alert-warning text-13">
      No training topics are available for you to record.
    </div>
  <% else %>
    <%= form_with url: record_training_path,
                  method: :post,
                  local: true,
                  id: "record-training-form",
                  data: { controller: "record-training inactive-training-notice",
                          action: "submit->record-training#guard submit->inactive-training-notice#confirm",
                          record_training_initial_trainee_ids_value: @initial_trainee_ids,
                          record_training_initial_topic_ids_value: @initial_topic_ids,
                          record_training_record_as_value: @initial_record_as } do %>
      <div class="form-section mb-2">
        <div class="form-section-header">
          <span class="h-section-label"><span class="step-number">1</span>Topics</span>
          <span class="text-12 text-secondary" data-record-training-target="topicCount">Pick one or more</span>
        </div>
        <div class="d-flex flex-wrap gap-1">
          <% @record_topics.each do |topic| %>
            <button type="button"
                    class="topic-chip"
                    data-record-training-target="topic"
                    data-action="record-training#toggleTopic"
                    data-topic-id="<%= topic.id %>"
                    data-topic-name="<%= topic.name %>"
                    data-can-record="<%= @recordable_topic_ids.include?(topic.id) %>"
                    data-can-appoint="<%= @appointable_topic_ids.include?(topic.id) %>"
                    aria-pressed="false">
              <%= topic.name %>
            </button>
          <% end %>
        </div>
        <div data-record-training-target="topicInputs"></div>
        <div class="text-11 text-secondary mt-2 d-none" data-record-training-target="topicNote"></div>
      </div>

      <div class="form-section mb-2">
        <div class="form-section-header">
          <span class="h-section-label"><span class="step-number">2</span>Members</span>
          <span class="text-12 text-secondary">
            <span data-record-training-target="memberCount">0</span> added
          </span>
        </div>

        <div class="position-relative">
          <div class="member-search-input mb-2">
            <i class="bi bi-search search-icon"></i>
            <input type="text"
                   placeholder="Add by name, email, or username"
                   autocomplete="off"
                   autocorrect="off"
                   autocapitalize="off"
                   spellcheck="false"
                   data-record-training-target="search"
                   data-action="input->record-training#search">
            <a href="#"
               class="paste-list-link"
               data-bs-toggle="modal"
               data-bs-target="#pasteListModal">Paste list</a>
          </div>
          <div class="list-group position-absolute w-100 shadow-sm d-none"
               style="z-index: 1000; max-height: 280px; overflow-y: auto;"
               data-record-training-target="results"></div>
        </div>

        <div class="alert alert-warning py-2 px-3 text-12 d-none" data-record-training-target="unresolved"></div>
        <div class="d-flex flex-column gap-1" data-record-training-target="members"></div>
      </div>

      <div class="form-section mb-3">
        <div class="form-section-header">
          <span class="h-section-label"><span class="step-number">3</span>Record as</span>
        </div>
        <div class="row g-3 align-items-start">
          <div class="col-md-6">
            <% if @appointable_topic_ids.any? %>
              <div class="btn-group btn-group-sm record-mode" role="group" aria-label="Record as">
                <input type="radio" class="btn-check" name="record_as" value="trained" id="record-as-trained"
                       data-record-training-target="mode" data-action="change->record-training#setMode"
                       <%= 'disabled' if @recordable_topic_ids.empty? %>>
                <label class="btn btn-outline-secondary" for="record-as-trained">Trained</label>
                <input type="radio" class="btn-check" name="record_as" value="trainer" id="record-as-trainer"
                       data-record-training-target="mode" data-action="change->record-training#setMode">
                <label class="btn btn-outline-secondary" for="record-as-trainer">Trainer</label>
              </div>
            <% else %>
              <%= hidden_field_tag :record_as, 'trained' %>
            <% end %>
            <div class="text-12 text-secondary mt-2" data-record-training-target="modeHelp"></div>
          </div>
          <div class="col-6 col-md-3">
            <label for="record-trained-at" class="text-12 text-secondary mb-1">Date</label>
            <%= date_field_tag :trained_at, Date.current, class: "form-control form-control-sm", id: "record-trained-at",
                               data: { record_training_target: "date", action: "change->record-training#checkDate" } %>
            <div class="text-11 text-warning mt-1 d-none" data-record-training-target="backdateWarning">
              Over 30 days ago. Make sure this is right.
            </div>
          </div>
          <div class="col-6 col-md-3">
            <label for="record-trainer-id" class="text-12 text-secondary mb-1">Trainer</label>
            <%= select_tag :trainer_id,
                           options_from_collection_for_select(@trainer_options, :id, :display_name, true_user.id),
                           class: "form-select form-select-sm",
                           id: "record-trainer-id" %>
          </div>
        </div>
      </div>

      <div class="form-action-bar">
        <div>
          <div class="form-action-bar-summary" data-record-training-target="summary">Pick a topic to start.</div>
          <div class="form-action-bar-detail d-none" data-record-training-target="detail"></div>
        </div>
        <div class="d-flex gap-2">
          <%= link_to "Cancel", training_catalog_path, class: "btn btn-outline-secondary btn-sm" %>
          <button type="submit" class="btn btn-primary btn-sm fw-medium" data-record-training-target="submit" disabled>
            Record training
          </button>
        </div>
      </div>

      <div class="modal fade" id="pasteListModal" tabindex="-1" aria-labelledby="pasteListModalLabel" aria-hidden="true">
        <div class="modal-dialog">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title" id="pasteListModalLabel">Paste list of members</h5>
              <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <p class="text-13 text-secondary">
                Paste names, emails, or usernames. Use one per line, or separate entries with commas.
              </p>
              <textarea class="form-control" rows="6" data-record-training-target="paste"
                        placeholder="annaroan&#10;kevin@example.com&#10;@liamwatson"></textarea>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
              <button type="button" class="btn btn-primary" data-bs-dismiss="modal"
                      data-action="record-training#processPaste">Add to list</button>
            </div>
          </div>
        </div>
      </div>

      <script type="application/json" data-record-training-target="users"><%= raw json_escape(@recording_users.to_json) %></script>
    <% end %>
  <% end %>
</div>
