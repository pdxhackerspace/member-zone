<div class="d-flex align-items-end justify-content-between mb-3">
  <div>
    <h1 class="h-page-title mb-0">Your API tokens</h1>
    <div class="text-13 text-secondary mt-1">
      Tokens let your own scripts and apps use Member Zone on your behalf. Each lasts up to
      <%= pluralize(@max_lifetime_days, 'day') %>; we'll email you before one expires.
    </div>
  </div>
  <div class="d-flex gap-2">
    <%= link_to "+ New token", new_api_token_path, class: "btn btn-primary btn-sm" %>
    <%= link_to "Back to your profile", user_path(current_user), class: "btn btn-outline-secondary btn-sm" %>
  </div>
</div>

<% if @api_tokens.any? %>
  <div class="card shadow-sm border-0 mb-4">
    <div class="table-responsive">
      <table class="table table-compact mb-0 align-middle">
        <thead>
          <tr>
            <th scope="col">Token</th>
            <th scope="col">Can</th>
            <th scope="col">Status</th>
            <th scope="col">Expires</th>
            <th scope="col">Last used</th>
            <th scope="col" class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @api_tokens.each do |token| %>
            <tr class="<%= 'text-secondary' if token.revoked? %>">
              <td>
                <div class="fw-medium"><%= token.name %></div>
                <div class="text-12 text-secondary">ends <code><%= token.token_hint %></code></div>
              </td>
              <td class="text-12">
                <% if token.scopes.any? %>
                  <%= token.scopes.map { |key| api_token_scope_label(key) }.to_sentence %>
                <% else %>
                  <span class="text-secondary">Only identify you</span>
                <% end %>
              </td>
              <td><%= api_token_state(token) %></td>
              <td><%= api_token_expiry(token) %></td>
              <td class="text-secondary"><%= api_token_last_used(token) %></td>
              <td class="text-end"><%= render 'api_tokens/actions', token: token %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% else %>
  <div class="card shadow-sm border-0 mb-4">
    <div class="card-body text-center py-4 text-secondary">
      You don't have any API tokens. Create one when you have something that needs to talk to Member Zone.
    </div>
  </div>
<% end %>

<% if @contact_tokens.any? %>
  <div class="h-section-label mb-2">Tokens you look after</div>
  <div class="text-13 text-secondary mb-2">
    Service-account tokens you are the contact for. We'll email you before they expire so you can extend them.
  </div>
  <div class="card shadow-sm border-0 mb-4">
    <div class="table-responsive">
      <table class="table table-compact mb-0 align-middle">
        <thead>
          <tr>
            <th scope="col">Token</th>
            <th scope="col">Used by</th>
            <th scope="col">Status</th>
            <th scope="col">Expires</th>
            <th scope="col">Last used</th>
            <th scope="col" class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @contact_tokens.each do |token| %>
            <tr class="<%= 'text-secondary' if token.revoked? %>">
              <td>
                <div class="fw-medium"><%= token.name %></div>
                <div class="text-12 text-secondary">ends <code><%= token.token_hint %></code></div>
              </td>
              <td><%= token.user.display_name %></td>
              <td><%= api_token_state(token) %></td>
              <td><%= api_token_expiry(token) %></td>
              <td class="text-secondary"><%= api_token_last_used(token) %></td>
              <td class="text-end"><%= render 'api_tokens/actions', token: token %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>

<div class="text-13 text-secondary">
  Send a token in the <code>Authorization</code> header: <code>Authorization: Bearer mz_…</code>.
  The <%= link_to "API reference", api_v1_openapi_path %> lists what each scope allows.
</div>
