<%# Inline fixes for whatever the report is flagging. `anchor` is the report key, so the
    POST comes back to the report the admin was looking at. %>
<% confirm_actions = {
     'deactivate' => "Deactivate #{user.display_name}?",
     'activate' => "Activate #{user.display_name}?",
     'ban' => "Ban #{user.display_name}? This sets their membership status to banned and deactivates them.",
     'deceased' => "Mark #{user.display_name} as deceased? This deactivates them."
   } %>

<% action_button = lambda do |action_type, label, css| %>
  <%= form_with url: reports_update_user_path, method: :post, class: "d-inline" do |f| %>
    <%= hidden_field_tag :user_id, user.id %>
    <%= hidden_field_tag :action_type, action_type %>
    <%= hidden_field_tag :anchor, anchor %>
    <%= f.submit label, class: "btn btn-sm #{css}",
                 data: { turbo: false, confirm_message: confirm_actions[action_type] },
                 onclick: confirm_actions[action_type] ? "return confirm(this.dataset.confirmMessage);" : nil %>
  <% end %>
<% end %>

<div class="d-flex flex-wrap gap-1">
  <%= link_to "Edit", edit_user_path(user), class: "btn btn-sm btn-outline-secondary" %>

  <% if user.active? %>
    <%= action_button.call('deactivate', 'Deactivate', 'btn-outline-secondary') %>
  <% else %>
    <%= action_button.call('activate', 'Activate', 'btn-outline-secondary') %>
  <% end %>

  <% if %w[membership-status-unknown dues-status-unknown dues-status-lapsed].include?(anchor) %>
    <%= action_button.call('paying', 'Paying', 'btn-outline-secondary') %>
    <%= action_button.call('sponsored', 'Sponsored', 'btn-outline-secondary') %>
    <%= action_button.call('guest', 'Guest', 'btn-outline-secondary') %>
  <% end %>

  <% if anchor == 'payment-type-unknown' %>
    <%= action_button.call('cash', 'Cash', 'btn-outline-secondary') %>
    <%= action_button.call('paypal', 'PayPal', 'btn-outline-secondary') %>
    <%= action_button.call('recharge', 'Recharge', 'btn-outline-secondary') %>
    <%= action_button.call('guest', 'Guest', 'btn-outline-secondary') %>
    <%= action_button.call('sponsored', 'Sponsored', 'btn-outline-secondary') %>
  <% end %>

  <div class="dropdown d-inline">
    <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="dropdown" data-bs-strategy="fixed"
            aria-expanded="false" aria-label="More actions">
      &hellip;
    </button>
    <div class="dropdown-menu dropdown-menu-end p-2">
      <%= action_button.call('ban', 'Ban', 'btn-outline-danger w-100 mb-1') %>
      <%= action_button.call('deceased', 'Mark deceased', 'btn-outline-danger w-100') %>
    </div>
  </div>
</div>
