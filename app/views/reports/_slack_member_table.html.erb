<%# Members alongside their linked Slack account.
    metadata (optional): user_id => { lapse_date:, last_slack_active: } %>
<% metadata = local_assigns.fetch(:metadata, {}) %>
<% show_lapse_date = local_assigns.fetch(:show_lapse_date, false) %>
<div class="table-responsive">
  <table class="table table-compact mb-0 align-middle">
    <thead>
      <tr>
        <th scope="col">Member</th>
        <th scope="col">Slack handle</th>
        <th scope="col">Slack last active</th>
        <th scope="col">Status</th>
        <% if show_lapse_date %><th scope="col">Lapsed</th><% end %>
      </tr>
    </thead>
    <tbody>
      <% rows.each do |user| %>
        <% slack_user = user.slack_user %>
        <tr>
          <td class="fw-medium">
            <%= link_to user.display_name, user_path(user), class: "text-decoration-none" %>
          </td>
          <td>
            <% if slack_user %>
              <span class="text-secondary">@<%= slack_user.username.presence || slack_user.display_name %></span>
            <% else %>
              <span class="text-secondary">—</span>
            <% end %>
          </td>
          <td>
            <% if slack_user&.last_active_at %>
              <%= time_ago_in_words(slack_user.last_active_at) %> ago
            <% else %>
              <span class="text-secondary">Unknown</span>
            <% end %>
          </td>
          <td>
            <span class="badge <%= membership_state_badge_subtle_class(user.membership_state) %>">
              <%= membership_state_label(user.membership_state) %>
            </span>
            <% if user.legacy? %>
              <span class="badge text-bg-secondary-subtle fw-normal">Legacy</span>
            <% end %>
          </td>
          <% if show_lapse_date %>
            <td>
              <% lapse = metadata.dig(user.id, :lapse_date) || user.membership_ended_date %>
              <% if lapse %>
                <%= lapse.is_a?(Time) ? l(lapse, format: :short) : lapse %>
              <% else %>
                <span class="text-secondary">—</span>
              <% end %>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
