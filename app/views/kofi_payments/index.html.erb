<%= render layout: 'shared/payment_index_header',
           locals: { title: 'Ko-fi payments', count: @payment_count, total_amount: @total_amount } do %>
  <% if can?(:'payments.import_export') %>
    <div class="dropdown">
      <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="dropdown"
              aria-expanded="false" aria-label="More actions">&hellip;</button>
      <ul class="dropdown-menu dropdown-menu-end">
        <li><%= link_to 'Export JSON', export_kofi_payments_path, class: 'dropdown-item', data: { turbo: false } %></li>
        <li>
          <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#importJsonModal">
            Import JSON
          </button>
        </li>
        <li>
          <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#importCsvModal">
            Import CSV
          </button>
        </li>
      </ul>
    </div>
  <% end %>
<% end %>

<% if @filter_active %>
  <% filter_label = { 'yes' => 'Linked', 'no' => 'Unlinked' }[params[:linked]] %>
  <%= render 'shared/payment_filter_banner', label: "#{filter_label || 'Searched'} payments",
             shown: @payment_count, total: @total_count, clear_path: kofi_payments_path %>
<% end %>

<%= render 'shared/payment_filter_tiles', tiles: [
      { label: 'All', count: @total_count, path: kofi_payments_path, active: params[:linked].blank? },
      { label: 'Linked', count: @linked_count, path: kofi_payments_path(linked: 'yes'),
        active: params[:linked] == 'yes' },
      { label: 'Unlinked', count: @unlinked_count, path: kofi_payments_path(linked: 'no'),
        active: params[:linked] == 'no', variant: 'warning' }
    ] %>

<!-- Import JSON Modal -->
<div class="modal fade" id="importJsonModal" tabindex="-1" aria-labelledby="importJsonModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="importJsonModalLabel">Import Ko-Fi Payments from JSON</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <%= form_with url: import_kofi_payments_path, method: :post, multipart: true, local: true do |f| %>
        <div class="modal-body">
          <p class="text-muted">Select a JSON backup file to import. This will update existing payments and create new ones based on <code>kofi_transaction_id</code>.</p>
          <div class="mb-3">
            <%= f.file_field :file, accept: 'application/json', class: "form-control", required: true %>
          </div>
          <div class="alert alert-warning mb-0">
            <strong>Warning:</strong> This operation will modify the database. Existing payments with matching <code>kofi_transaction_id</code> will be updated.
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <%= f.submit "Import", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Import CSV Modal -->
<div class="modal fade" id="importCsvModal" tabindex="-1" aria-labelledby="importCsvModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="importCsvModalLabel">Import Ko-Fi Payments from CSV</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <%= form_with url: import_csv_kofi_payments_path, method: :post, multipart: true, local: true do |f| %>
        <div class="modal-body">
          <p class="text-muted">Select a CSV file exported from Ko-Fi. Expected columns include: Date, From, Type, Amount, Currency, Status, Message, Email, Ko-fi Transaction ID, Tier Name.</p>
          <div class="mb-3">
            <%= f.file_field :file, accept: '.csv,text/csv', class: "form-control", required: true %>
          </div>
          <div class="alert alert-info mb-0">
            <strong>Tip:</strong> Export your payments from <a href="https://ko-fi.com/manage/payments" target="_blank" rel="noopener">Ko-Fi's Payment History</a> page.
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <%= f.submit "Import CSV", class: "btn btn-success" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<%= render 'shared/payment_search', url: kofi_payments_path, frame: 'kofi_payments_results',
           placeholder: 'Search by transaction ID, supporter name, full email, type, or message…' %>

<%= turbo_frame_tag 'kofi_payments_results' do %>
  <% if @payments.any? %>
    <%= render layout: 'shared/payment_table',
               locals: { body_id: 'kofi_payments_table_body',
                         headers: ['Transaction', 'Type', ['Amount', 'num'], 'Member', 'Message', 'Date'] } do %>
      <% @payments.each do |payment| %>
        <% unlinked = payment.user.blank? %>
        <tr class="kofi-payment-row <%= 'row-attention' if unlinked %>"
            data-live-filter-target="item"
            data-search-text="<%= [
              payment.kofi_transaction_id,
              payment.from_name,
              payment.payment_type,
              payment.message,
              payment.tier_name,
              payment.user&.display_name,
              payment.user_id.present? ? 'linked' : 'unlinked'
            ].compact.join(' ').downcase %>">
          <td>
            <%= link_to payment.kofi_transaction_id.to_s.truncate(20), kofi_payment_path(payment),
                        class: 'fw-medium text-decoration-none', data: { turbo_frame: '_top' } %>
          </td>
          <td>
            <span class="badge text-bg-<%= payment_type_badge_class(payment.payment_type) %>-subtle">
              <%= payment.payment_type.presence || 'Unknown' %>
            </span>
            <% if payment.tier_name.present? %>
              <div class="text-secondary text-12"><%= payment.tier_name %></div>
            <% end %>
          </td>
          <td class="num"><%= payment_money_tag(payment.amount, payment.currency) %></td>
          <td class="kofi-payment-supporter">
            <%= render 'shared/payment_member_cell', payment: payment, name: payment.from_name,
                       link_path: kofi_payment_path(payment), unlinked: unlinked,
                       empty_label: 'Unnamed supporter' %>
          </td>
          <td>
            <% if payment.message.present? %>
              <span class="text-secondary cell-truncate"
                    title="<%= payment.message %>"><%= payment.message.truncate(60) %></span>
            <% else %>
              <span class="text-secondary">—</span>
            <% end %>
          </td>
          <td><%= payment_time_tag(payment.timestamp) %></td>
        </tr>
      <% end %>
    <% end %>
  <% else %>
    <%= render 'shared/payment_empty', icon: 'cup-hot',
               message: 'No Ko-fi payments match these filters.' %>
  <% end %>
  <%= render 'shared/pagination', pagy: @pagy %>
<% end %>
