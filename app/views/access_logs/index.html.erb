<% filter_path = ->(value) { access_logs_path(linked: value, q: params[:q].presence) } %>

<%= render layout: 'shared/list_page_header',
           locals: { title: 'Access logs', count: @display_count, noun: 'entry' } do %>
  <%= gate :'access.import_logs' do %>
    <%= button_to 'Sync access logs', import_access_logs_path, method: :post,
                  class: 'btn btn-primary btn-sm', data: { turbo: false } %>
    <button type="button" class="btn btn-outline-secondary btn-sm"
            data-bs-toggle="modal" data-bs-target="#uploadLogModal">Upload log file</button>
  <% end %>
<% end %>

<% if @filter_active %>
  <% labels = [{ 'yes' => 'Linked', 'no' => 'Unlinked (with name)', 'no_name' => 'No name',
                 'service' => 'Service accounts' }[params[:linked]],
               ("Search: #{params[:q]}" if params[:q].present?)].compact %>
  <%= render 'shared/list_filter_banner', label: "#{labels.join(' + ')} entries",
             shown: @display_count, total: @total_count, clear_path: access_logs_path %>
<% end %>

<%= render 'shared/list_filter_tiles', tiles: [
      { label: 'All', count: @total_count, path: filter_path.call(nil), active: params[:linked].blank? },
      { label: 'Linked', count: @linked_count, path: filter_path.call('yes'),
        active: params[:linked] == 'yes' },
      { label: 'Unlinked', count: @unlinked_count, path: filter_path.call('no'),
        active: params[:linked] == 'no', variant: 'warning' },
      { label: 'No name', count: @no_name_count, path: filter_path.call('no_name'),
        active: params[:linked] == 'no_name' },
      { label: 'Service', count: @service_account_count, path: filter_path.call('service'),
        active: params[:linked] == 'service' }
    ] %>

<%= render 'shared/list_search', url: access_logs_path, frame: 'access_logs_results',
           placeholder: 'Search by name, location, or raw text…' %>

<%= turbo_frame_tag 'access_logs_results' do %>
  <% if @access_logs.any? %>
    <%= render layout: 'shared/list_table',
               locals: { body_id: 'access_logs_table_body',
                         headers: ['Time', 'Member', 'Location', 'Action', 'Raw text', ['', 'text-end']] } do %>
      <% @access_logs.each do |log| %>
        <% needs_linking = log.user.blank? && log.name.present? %>
        <tr class="access-log-row <%= 'row-attention' if needs_linking %>">
          <td><%= list_time_tag(log.logged_at, empty: 'Not set') %></td>
          <td class="access-log-member">
            <% if log.user.present? %>
              <%= link_to log.user.display_name, user_path(log.user),
                          class: 'text-decoration-none', data: { turbo_frame: '_top' } %>
              <% if log.user.service_account? %>
                <i class="bi bi-gear-fill text-secondary ms-1" title="Service account"></i>
              <% end %>
            <% elsif log.name.present? %>
              <div class="mb-1"><%= log.name %></div>
              <span class="badge text-bg-warning-subtle">Unlinked</span>
            <% else %>
              <span class="text-secondary fst-italic">Unknown</span>
            <% end %>
          </td>
          <td><span class="text-secondary"><%= log.location.presence || '—' %></span></td>
          <td><span class="text-secondary"><%= log.action.presence || '—' %></span></td>
          <td>
            <% if log.raw_text.present? %>
              <code class="text-12 text-secondary cell-truncate" title="<%= log.raw_text %>">
                <%= truncate(log.raw_text, length: 100) %>
              </code>
            <% else %>
              <span class="text-secondary">—</span>
            <% end %>
          </td>
          <td class="text-end text-nowrap">
            <% if needs_linking %>
              <%= gate :'access.link_logs' do %>
                <button type="button" class="btn btn-sm btn-outline-warning"
                        data-bs-toggle="modal" data-bs-target="#linkUserModal"
                        data-log-id="<%= log.id %>" data-log-name="<%= log.name %>">Link member…</button>
              <% end %>
              <% if current_user_admin? %>
                <%= button_to 'Create member',
                              create_member_access_log_path(log, linked: params[:linked], q: params[:q],
                                                                 page: params[:page]),
                              method: :post, class: 'btn btn-sm btn-outline-secondary',
                              data: { turbo: false, turbo_confirm: "Create a new member '#{log.name}'?" } %>
              <% end %>
            <% end %>
          </td>
        </tr>
      <% end %>
    <% end %>
  <% elsif @filter_active %>
    <%= render 'shared/list_empty', icon: 'door-open', message: 'No access log entries match these filters.' %>
  <% else %>
    <%= render 'shared/list_empty', icon: 'door-open', message: 'No access logs have been imported yet.' %>
  <% end %>
  <%= render 'shared/pagination', pagy: @pagy %>
<% end %>

<!-- Upload Log File Modal -->
<div class="modal fade" id="uploadLogModal" tabindex="-1" aria-labelledby="uploadLogModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="uploadLogModalLabel"><i class="bi bi-upload me-2"></i>Upload Log File</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <%= form_with url: upload_access_logs_path, method: :post, multipart: true, local: true do %>
        <div class="modal-body">
          <p class="text-muted small mb-3">
            Upload a log file in the standard access control format. Duplicate entries are automatically skipped.
          </p>
          <div class="mb-3">
            <label for="log_file_input" class="form-label">Log file</label>
            <input type="file" name="log_file" id="log_file_input" class="form-control" accept=".log,.txt" required>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Upload &amp; Import</button>
        </div>
      <% end %>
    </div>
  </div>
</div>

<% if @all_users.present? %>
<!-- Link User Modal -->
<div class="modal fade" id="linkUserModal" tabindex="-1" aria-labelledby="linkUserModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="linkUserModalLabel">Link Access Log to User</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="linkUserForm" method="post">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
        <input type="hidden" name="linked" value="<%= params[:linked] %>">
        <input type="hidden" name="q" value="<%= params[:q] %>">
        <input type="hidden" name="page" value="<%= @page %>">
        <div class="modal-body">
          <p class="mb-3">Linking access log entry for <strong id="linkLogName"></strong>. Other entries with the same name will also be linked, and the name will be added as an alias if it differs.</p>
          <div class="mb-3">
            <label for="link_user_search" class="form-label">Search Members</label>
            <input type="text" id="link_user_search" class="form-control mb-2" placeholder="Type to search members..." autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false">
          </div>
          <div class="mb-3">
            <label class="form-label">Select Member</label>
            <div id="link_user_list" class="border rounded" style="max-height: 300px; overflow-y: auto;">
              <% @all_users.each do |user| %>
                <div class="link-user-item p-2 border-bottom"
                     data-user-name="<%= user.display_name.downcase %>"
                     data-user-email="<%= user.email.to_s.downcase %>"
                     data-username="<%= user.username.to_s.downcase %>"
                     style="cursor: pointer;">
                  <input type="radio" name="user_id" id="link_user_<%= user.id %>" value="<%= user.id %>" class="form-check-input me-2" required>
                  <label for="link_user_<%= user.id %>" class="form-check-label mb-0" style="cursor: pointer;">
                    <%= user.display_name %>
                    <% if user.email.present? %>
                      <span class="text-muted small ms-1">(<%= user.email %>)</span>
                    <% end %>
                  </label>
                </div>
              <% end %>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Link Member</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  (function() {
    const modal = document.getElementById('linkUserModal');
    if (!modal) return;

    // When the modal is triggered, update the form action and display name
    modal.addEventListener('show.bs.modal', function(event) {
      const button = event.relatedTarget;
      const logId = button.getAttribute('data-log-id');
      const logName = button.getAttribute('data-log-name');

      document.getElementById('linkLogName').textContent = logName;
      document.getElementById('linkUserForm').action = '/access_logs/' + logId + '/link_user';

      // Reset search and selection
      const searchInput = document.getElementById('link_user_search');
      if (searchInput) searchInput.value = '';
      document.querySelectorAll('.link-user-item').forEach(function(item) {
        item.style.display = '';
      });
      const checked = modal.querySelector('input[name="user_id"]:checked');
      if (checked) checked.checked = false;
    });

    // User search filtering
    const searchInput = document.getElementById('link_user_search');
    if (searchInput) {
      searchInput.addEventListener('input', function() {
        const term = this.value.toLowerCase().trim();
        document.querySelectorAll('.link-user-item').forEach(function(item) {
          const name = item.getAttribute('data-user-name') || '';
          const email = item.getAttribute('data-user-email') || '';
          const username = item.getAttribute('data-username') || '';
          const haystack = name + ' ' + email + ' ' + username;
          item.style.display = haystack.includes(term) ? '' : 'none';
        });
      });
    }

    // Click on row selects the radio
    document.querySelectorAll('.link-user-item').forEach(function(item) {
      item.addEventListener('click', function(e) {
        if (e.target.tagName !== 'INPUT') {
          const radio = this.querySelector('input[type="radio"]');
          if (radio) radio.checked = true;
        }
      });
    });
  })();
</script>
<% end %>


