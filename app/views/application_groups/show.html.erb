<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="h3 mb-1"><%= @application_group.name %></h1>
    <p class="text-muted mb-0">Application: <%= link_to @application.name, application_path(@application), class: "text-decoration-none" %></p>
  </div>
  <div class="d-flex gap-2">
    <% if MemberSource.enabled?('member_zone') %>
      <%= button_to "Sync to Authentik", sync_to_authentik_application_application_group_path(@application, @application_group),
          method: :post,
          class: "btn btn-outline-primary",
          data: { turbo_confirm: "Sync this group to Authentik?" } %>
    <% else %>
      <button class="btn btn-outline-secondary" disabled title="Member Zone source is disabled">Sync to Authentik</button>
    <% end %>
    <%= link_to "Edit", edit_application_application_group_path(@application, @application_group), class: "btn btn-outline-secondary" %>
    <%= button_to "Delete", application_application_group_path(@application, @application_group),
        method: :delete,
        class: "btn btn-outline-danger",
        data: { turbo_confirm: "Are you sure you want to delete this group? This will also remove it from Authentik." } %>
    <%= link_to "&larr; Back to application".html_safe, application_path(@application), class: "text-decoration-none ms-2" %>
  </div>
</div>

<div class="card shadow-sm border-0 mb-4">
  <div class="card-body">
    <dl class="row mb-0">
      <dt class="col-sm-3 text-secondary">Name</dt>
      <dd class="col-sm-9"><%= @application_group.name %></dd>

      <dt class="col-sm-3 text-secondary">Authentik Group Name</dt>
      <dd class="col-sm-9"><code><%= @application_group.authentik_name %></code></dd>

      <% if @application_group.manual? %>
        <dt class="col-sm-3 text-secondary">Authentik Group ID</dt>
        <dd class="col-sm-9">
          <% if @application_group.authentik_group_id.present? %>
            <code><%= @application_group.authentik_group_id %></code>
            <span class="badge text-bg-success ms-2">Webhook Sync Enabled</span>
          <% else %>
            <span class="text-muted fst-italic">Not configured</span>
          <% end %>
        </dd>
      <% end %>

      <dt class="col-sm-3 text-secondary">Authentik Policy</dt>
      <dd class="col-sm-9">
        <% if @application_group.authentik_policy_id.present? %>
          <code><%= @application_group.authentik_policy_id %></code>
          <div class="form-text"><code><%= @application_group.policy_name %></code></div>
        <% else %>
          <span class="text-muted fst-italic">Not created yet</span>
        <% end %>
      </dd>

      <dt class="col-sm-3 text-secondary">Member Source</dt>
      <dd class="col-sm-9">
        <% case @application_group.member_source %>
        <% when 'active_members' %>
          <span class="badge text-bg-primary">Active Members</span>
        <% when 'admin_members' %>
          <span class="badge text-bg-primary">Admin Members</span>
        <% when 'unbanned_members' %>
          <span class="badge text-bg-primary">Unbanned Members</span>
        <% when 'all_members' %>
          <span class="badge text-bg-primary">All Members</span>
        <% when 'sync_group' %>
          <span class="badge text-bg-primary">Sync with group</span>
          <% if @application_group.sync_with_group %>
            &mdash; <%= link_to @application_group.sync_with_group.name,
                  group_management_path(@application_group.sync_with_group),
                  class: "text-decoration-none" %>
            (<%= @application_group.sync_with_group.application.name %>)
          <% end %>
        <% when 'can_train' %>
          <span class="badge text-bg-primary">Members who can train</span>
          <% if @application_group.training_topic %>
            &mdash; <%= @application_group.training_topic.name %>
          <% end %>
        <% when 'trained_in' %>
          <span class="badge text-bg-primary">Members trained in</span>
          <% if @application_group.training_topic %>
            &mdash; <%= @application_group.training_topic.name %>
          <% end %>
        <% when 'manual' %>
          <span class="badge text-bg-secondary">Choose members</span>
        <% end %>
      </dd>

      <dt class="col-sm-3 text-secondary">Note</dt>
      <dd class="col-sm-9">
        <%= @application_group.note.presence || content_tag(:span, "No note", class: "text-muted fst-italic") %>
      </dd>

      <dt class="col-sm-3 text-secondary">Members</dt>
      <dd class="col-sm-9">
        <span class="badge text-bg-info"><%= @users.count %> members</span>
        <% syncable_count = @application_group.syncable_members.count %>
        <% if syncable_count < @users.count %>
          <span class="badge text-bg-warning ms-1"><%= syncable_count %> can sync</span>
        <% end %>
      </dd>
    </dl>
  </div>
</div>

<% unless @application_group.manual? %>
  <div class="alert alert-info mb-4">
    <i class="bi bi-info-circle me-2"></i>
    This group uses an Authentik expression policy instead of an Authentik group. Bind this policy to your Authentik application to control access:<br>
    <code class="fs-6"><%= @application_group.policy_name %></code>
  </div>
<% end %>

<%= render 'application_groups/members',
           group: @application_group,
           users: @users,
           all_users: @all_users,
           unsyncable_members: @unsyncable_members %>
