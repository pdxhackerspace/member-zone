<%= form_with model: @announcer do |f| %>
  <% if @announcer.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% @announcer.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: "form-control", required: true, placeholder: "e.g., Post in #at-the-space" %>
    <div class="form-text">Members see this name next to the checkbox on their profile.</div>
  </div>

  <div class="mb-3">
    <%= f.label :description, "Description for members", class: "form-label" %>
    <%= f.text_area :description, class: "form-control", rows: 2,
                    placeholder: "e.g., Posts \"Ada has arrived\" in the #at-the-space Slack channel." %>
    <div class="form-text">Shown under the name, so members know what they're opting in to.</div>
  </div>

  <div class="mb-3">
    <%= f.label :script_path, "Program", class: "form-label" %>
    <%= f.select :script_path, @script_options, { include_blank: "Choose a program" },
                 class: "form-select font-monospace", required: true %>
    <div class="form-text">
      Only executables in the <code>announcers</code> subdirectory under <code>scripts/</code> or
      <code>ACCESS_SCRIPTS_DIR</code> can be chosen. Programs need a shebang line (shell, Python and Ruby all work).
    </div>
  </div>

  <div class="mb-3">
    <%= f.label :script_arguments, "Arguments (optional)", class: "form-label" %>
    <%= f.text_field :script_arguments, class: "form-control", placeholder: "e.g., --channel at-the-space" %>
    <div class="form-text">Passed after <code>announce</code>, split on spaces.</div>
  </div>

  <div class="mb-3">
    <%= f.label :environment_variables, "Environment variables (optional)", class: "form-label" %>
    <%= f.text_area :environment_variables, class: "form-control font-monospace", rows: 4,
                    placeholder: "SLACK_BOT_TOKEN=xoxb-...\nSLACK_CHANNEL=C0123456789" %>
    <div class="form-text">
      One per line as <code>KEY=value</code>; lines starting with <code>#</code> are ignored. Stored encrypted.
      The program is also given <code>ANNOUNCER_NAME</code>, and reads who arrived as JSON on standard input.
    </div>
  </div>

  <div class="row g-3 mb-3">
    <div class="col-md-6">
      <%= f.label :repeat_after_minutes, "Don't announce the same member again for", class: "form-label" %>
      <div class="input-group">
        <%= f.number_field :repeat_after_minutes, class: "form-control", min: 0, step: 1, required: true %>
        <span class="input-group-text">minutes</span>
      </div>
      <div class="form-text">Scans at other outside doors inside this window are ignored. 0 announces every scan.</div>
    </div>
    <div class="col-md-6">
      <%= f.label :display_order, class: "form-label" %>
      <%= f.number_field :display_order, class: "form-control", step: 1 %>
      <div class="form-text">Order on the member's profile; lowest first.</div>
    </div>
  </div>

  <div class="mb-4 form-check">
    <%= f.check_box :enabled, class: "form-check-input" %>
    <%= f.label :enabled, "Enabled", class: "form-check-label" %>
    <div class="form-text">Members only see enabled announcers. A test announcement works either way.</div>
  </div>

  <div class="d-flex gap-2">
    <%= f.submit class: "btn btn-primary btn-sm" %>
    <%= link_to "Cancel", (@announcer.persisted? ? announcer_path(@announcer) : announcers_path),
                class: "btn btn-outline-secondary btn-sm" %>
  </div>
<% end %>
