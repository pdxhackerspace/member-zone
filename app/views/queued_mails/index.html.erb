<div class="d-flex align-items-end justify-content-between mb-3">
  <div>
    <h1 class="h-page-title mb-0">Mail Queue</h1>
    <div class="text-13 text-secondary mt-1">
      Review and approve outgoing mail before it is sent.
      <% if @pending_count > 0 || @failed_count > 0 %>
        ·
        <% if @pending_count > 0 %>
          <span class="text-body"><%= @pending_count %></span> awaiting review
        <% end %>
        <% if @failed_count > 0 %>
          <%= ' · ' if @pending_count > 0 %>
          <%= link_to queued_mails_path(filter: 'failed'), class: "text-danger text-decoration-none" do %>
            <%= @failed_count %> failed to send
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>
  <div>
    <%= link_to "Dashboard", root_path, class: "btn btn-outline-secondary btn-sm" %>
  </div>
</div>

<%= render 'shared/smtp_warning' %>

<ul class="nav nav-tabs mb-4">
  <li class="nav-item">
    <%= link_to queued_mails_path(filter: 'pending'), class: "nav-link #{'active' if @filter == 'pending'}" do %>
      Pending
      <% if @pending_count > 0 %>
        <span class="badge text-bg-warning-subtle ms-1"><%= @pending_count %></span>
      <% end %>
    <% end %>
  </li>
  <li class="nav-item">
    <%= link_to queued_mails_path(filter: 'failed'), class: "nav-link #{'active' if @filter == 'failed'}" do %>
      Failed
      <% if @failed_count > 0 %>
        <span class="badge text-bg-danger-subtle ms-1"><%= @failed_count %></span>
      <% end %>
    <% end %>
  </li>
  <li class="nav-item">
    <%= link_to queued_mails_path(filter: 'approved'), class: "nav-link #{'active' if @filter == 'approved'}" do %>
      Approved
    <% end %>
  </li>
  <li class="nav-item">
    <%= link_to queued_mails_path(filter: 'rejected'), class: "nav-link #{'active' if @filter == 'rejected'}" do %>
      Rejected
    <% end %>
  </li>
  <li class="nav-item">
    <%= link_to queued_mails_path(filter: 'all'), class: "nav-link #{'active' if @filter == 'all'}" do %>
      All
    <% end %>
  </li>
</ul>

<%# Approving or rejecting the whole queue in one click is a different scale from reviewing
    a message, and no catalog key separates them — so it stays with administrators. %>
<% if @filter == 'pending' && @pending_count > 0 && current_user_admin? %>
  <div class="d-flex gap-2 mb-3">
    <% if smtp_configured? %>
      <%= button_to "Approve & Send All", approve_all_queued_mails_path, method: :post,
          class: "btn btn-success",
          data: { turbo_confirm: "This will approve and send all #{@pending_count} pending message#{'s' if @pending_count != 1}. Continue?" } %>
    <% else %>
      <button class="btn btn-success" disabled title="SMTP not configured">Approve & Send All</button>
    <% end %>
    <%= button_to "Reject All", reject_all_queued_mails_path, method: :post,
        class: "btn btn-danger",
        data: { turbo_confirm: "This will reject all #{@pending_count} pending message#{'s' if @pending_count != 1}. Continue?" } %>
  </div>
<% end %>

<% if @queued_mails.any? %>
  <div class="card shadow-sm border-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>To</th>
            <th>Subject</th>
            <th>Reason</th>
            <th>Status</th>
            <th>Created</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @queued_mails.each do |qm| %>
            <tr class="<%= 'table-danger' if qm.delivery_failed? %><%= 'table-success' if qm.sent? %><%= 'table-secondary' if qm.rejected? %>">
              <td>
                <div class="fw-semibold"><%= qm.to %></div>
                <% if qm.recipient %>
                  <div class="text-muted small"><%= link_to qm.recipient.display_name, user_path(qm.recipient), class: "text-decoration-none" %></div>
                <% end %>
              </td>
              <td>
                <span class="text-truncate d-inline-block" style="max-width: 250px;">
                  <%= qm.subject %>
                </span>
              </td>
              <td class="text-muted small"><%= qm.reason %></td>
              <td>
                <% if qm.delivery_failed? %>
                  <span class="badge text-bg-danger-subtle">Send failed</span>
                  <% if qm.retries_exhausted? %>
                    <div class="text-11 text-secondary mt-1">Gave up after <%= qm.send_attempts %> attempts</div>
                  <% elsif qm.next_retry_at&.future? %>
                    <div class="text-11 text-secondary mt-1">
                      Retrying in <%= distance_of_time_in_words_to_now(qm.next_retry_at) %>
                    </div>
                  <% end %>
                <% elsif qm.delivery_pending? %>
                  <span class="badge text-bg-info-subtle">Sending</span>
                <% elsif qm.sent? %>
                  <span class="status-dot status-success" title="Sent <%= qm.sent_at.strftime('%b %d, %Y %l:%M %p') %>"></span>
                <% elsif qm.pending? %>
                  <span class="badge text-bg-warning-subtle">Pending</span>
                <% elsif qm.approved? %>
                  <span class="badge text-bg-success-subtle">Approved</span>
                <% elsif qm.rejected? %>
                  <span class="badge text-bg-secondary-subtle">Rejected</span>
                <% end %>
              </td>
              <td class="text-muted small"><%= time_ago_in_words(qm.created_at) %> ago</td>
              <td class="text-end">
                <div class="btn-group btn-group-sm">
                  <%= link_to "View", queued_mail_path(qm), class: "btn btn-outline-primary" %>
                  <% if qm.delivery_failed? %>
                    <% if current_user_admin? %>
                    <%= button_to "Retry", retry_queued_mail_path(qm), method: :post,
                        class: "btn btn-outline-warning",
                        data: { turbo_confirm: "Retry sending this email to #{qm.to}?" } %>
                    <% end %>
                  <% end %>
                  <% if qm.pending? %>
                    <% if smtp_configured? %>
                      <%= button_to "Approve & Send", approve_queued_mail_path(qm), method: :post,
                          class: "btn btn-outline-success",
                          data: { turbo_confirm: "This will send this email to #{qm.to}. Continue?" } %>
                    <% else %>
                      <button class="btn btn-outline-success" disabled title="SMTP not configured">Approve & Send</button>
                    <% end %>
                    <%= button_to "Reject", reject_queued_mail_path(qm), method: :post,
                        class: "btn btn-outline-danger",
                        data: { turbo_confirm: "Reject this email?" } %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% else %>
  <div class="card shadow-sm border-0">
    <div class="card-body text-center py-5">
      <i class="bi bi-envelope-check display-4 mb-3 d-block text-muted opacity-25"></i>
      <p class="text-muted mb-0">
        <% if @filter == 'pending' %>
          No pending messages. The queue is empty.
        <% elsif @filter == 'failed' %>
          Nothing has failed to send. Messages wait here when the mail server will not take them.
        <% else %>
          No <%= @filter %> messages found.
        <% end %>
      </p>
    </div>
  </div>
<% end %>
