<div class="d-flex align-items-end justify-content-between mb-3">
  <div>
    <h1 class="h-page-title mb-0">Your credentials</h1>
    <div class="text-13 text-secondary mt-1">
      API keys and app passwords issued to you. For your safety we show each secret once, when you request it.
    </div>
  </div>
  <div class="d-flex gap-2">
    <%= link_to "Back to your profile", user_path(current_user), class: "btn btn-outline-secondary btn-sm" %>
  </div>
</div>

<div class="h-section-label mb-2">Issued to you</div>
<% if @credentials.any? %>
  <div class="card shadow-sm border-0 mb-4">
    <div class="table-responsive">
      <table class="table table-compact mb-0 align-middle">
        <thead>
          <tr>
            <th scope="col">Credential</th>
            <th scope="col">What you have</th>
            <th scope="col">Status</th>
            <th scope="col">Expires</th>
            <th scope="col" class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @credentials.each do |credential| %>
            <tr class="<%= 'text-secondary' unless credential.live? %>">
              <td>
                <div class="fw-medium"><%= credential.credential_provider.schema_display_name %></div>
                <% if credential.label.present? %><div class="text-12 text-secondary"><%= credential.label %></div><% end %>
              </td>
              <td>
                <% credential.display_fields.each do |field| %>
                  <div class="text-12"><span class="text-secondary"><%= field[:label] %>:</span>
                    <code><%= field[:display] %></code></div>
                <% end %>
              </td>
              <td>
                <span class="status-dot status-<%= credential.status_dot_class %>"></span>
                <%= credential.status_label %>
                <% if credential.revocation_reason_label.present? && !credential.live? %>
                  <div class="text-12 text-secondary"><%= credential.revocation_reason_label %></div>
                <% end %>
              </td>
              <td class="text-secondary">
                <% if credential.expires_at %>
                  <span class="<%= 'text-warning' if credential.expiring_soon? %>"
                        title="<%= l(credential.expires_at, format: :long) %>"><%= l(credential.expires_at.to_date, format: :long) %></span>
                <% else %>
                  No expiry
                <% end %>
              </td>
              <td class="text-end">
                <div class="d-flex gap-2 justify-content-end">
                  <% if credential.rotatable? && credential.credential_provider.self_service? %>
                    <%= button_to "Replace", rotate_credential_path(credential), method: :post,
                                  params: { request_id: SecureRandom.uuid },
                                  form: { data: { turbo: false } }, class: "btn btn-outline-secondary btn-sm",
                                  data: { confirm: "Issue a new credential and revoke this one? The new secret is shown once." } %>
                  <% end %>
                  <% if credential.revocable? && credential.revoke_failed? == false %>
                    <%= button_to "Revoke", revoke_credential_path(credential), method: :post,
                                  class: "btn btn-outline-danger btn-sm",
                                  data: { turbo_confirm: "Revoke this credential? Anything using it stops working." } %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% else %>
  <div class="card shadow-sm border-0 mb-4">
    <div class="card-body text-center py-4 text-secondary">
      You don't have any credentials yet. Request one below when you need it.
    </div>
  </div>
<% end %>

<div class="h-section-label mb-2">Request a credential</div>
<% if @providers.any? %>
  <div class="row g-2">
    <% @providers.each do |provider| %>
      <% reason = @denials[provider] %>
      <div class="col-md-6">
        <% if reason.nil? %>
          <%= link_to new_credential_path(provider_id: provider.id), class: "action-card" do %>
            <div class="action-card-title"><i class="bi bi-key me-1"></i><%= provider.schema_display_name %></div>
            <div class="action-card-desc"><%= provider.schema&.dig('description').presence || provider.description.presence || 'Request a new credential' %></div>
          <% end %>
        <% else %>
          <div class="action-card disabled text-secondary" aria-disabled="true">
            <div class="action-card-title text-secondary"><i class="bi bi-key me-1"></i><%= provider.schema_display_name %></div>
            <div class="action-card-desc"><%= reason %></div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="card shadow-sm border-0">
    <div class="card-body text-secondary text-13">Nothing is available to request right now.</div>
  </div>
<% end %>
