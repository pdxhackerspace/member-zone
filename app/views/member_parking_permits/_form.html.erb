<%= form_with model: parking_notice,
    url: (parking_notice.persisted? ? member_parking_permit_path(parking_notice) : member_parking_permits_path),
    local: true do |f| %>
  <% if parking_notice.errors.any? %>
    <div class="alert alert-danger">
      <h6><%= pluralize(parking_notice.errors.count, 'error') %> prevented this parking permit from being saved:</h6>
      <ul class="mb-0">
        <% parking_notice.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= render 'parking_notices/member_picker',
        field_name: 'parking_notice[member_ids][]',
        label: 'Who else is on this permit?',
        help_text: "They'll see this permit, can clear it, and get its reminders.",
        required: false,
        member_search_url: member_search_member_parking_permits_path,
        fixed_members: [current_user],
        selected_members: parking_notice.members.reject { |member| member.id == current_user.id } %>
  </div>

  <div class="mb-3">
    <%= f.label :description, class: 'form-label' %>
    <%= f.text_area :description, class: 'form-control', rows: 3, placeholder: 'Describe your project or item...' %>
  </div>

  <div class="row g-3">
    <div class="col-md-6">
      <%= f.label :location, 'Room / Location', class: 'form-label' %>
      <%= f.text_field :location, class: 'form-control', placeholder: 'Example: Woodshop' %>
    </div>
    <div class="col-md-6">
      <%= f.label :location_detail, 'Location detail', class: 'form-label' %>
      <%= f.text_field :location_detail, class: 'form-control', placeholder: 'Example: South wall shelf' %>
    </div>
  </div>

  <% permit_anchor = parking_notice.persisted? ? parking_notice.created_at : Time.current %>
  <% self_service_cap = permit_anchor + MemberParkingPermitsController::MAX_MEMBER_PERMIT_DURATION %>
  <% self_service_cap_value = self_service_cap.strftime('%Y-%m-%dT%H:%M') %>
  <% grandfathered_expiration = parking_notice.persisted? &&
        parking_notice.expires_at.present? &&
        parking_notice.expires_at > self_service_cap %>
  <div class="mt-3 mb-4"
       data-controller="quick-expire"
       data-quick-expire-exact-value="true"
       data-quick-expire-max-at-value="<%= self_service_cap_value %>">
    <%= f.label :expires_at, 'Expiration', class: 'form-label' %>
    <div class="text-12 text-secondary mb-2">Self-service permits cannot exceed 2 weeks.</div>
    <%= render 'expiration_quick_buttons' %>
    <% expires_at_field_options = {
         class: 'form-control',
         required: true,
         include_seconds: false,
         data: { quick_expire_target: 'field' },
         value: parking_notice.expires_at&.strftime('%Y-%m-%dT%H:%M')
       } %>
    <% expires_at_field_options[:max] = self_service_cap_value unless grandfathered_expiration %>
    <%= f.datetime_local_field :expires_at, **expires_at_field_options %>
  </div>

  <div class="d-flex gap-2">
    <%= f.submit(parking_notice.persisted? ? 'Save changes' : 'Create Parking Permit', class: 'btn btn-success') %>
    <%= link_to 'Cancel', user_path(current_user, tab: :parking), class: 'btn btn-outline-secondary' %>
  </div>
<% end %>
