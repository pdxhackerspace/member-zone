<%# Page header shared by the payment index pages: title, the record/total summary line, and
    the page's actions, which the caller supplies as the block body.
    Locals: title, count; optional total_amount, summary (replaces the count line). %>
<div class="d-flex align-items-end justify-content-between mb-3">
  <div>
    <h1 class="h-page-title mb-0"><%= title %></h1>
    <div class="text-13 text-secondary mt-1">
      <% if local_assigns[:summary].present? %>
        <%= summary %>
      <% else %>
        <span class="text-body"><%= number_with_delimiter(count) %></span> <%= 'record'.pluralize(count) %>
        <% if local_assigns.key?(:total_amount) %>
          · Total <span class="text-body">$<%= number_to_currency(total_amount || 0, unit: '') %> USD</span>
        <% end %>
      <% end %>
    </div>
  </div>
  <div class="d-flex gap-2"><%= yield %></div>
</div>
