<% summary = capture do %>
  <span class="text-body"><%= number_with_delimiter(@filter_counts['all']) %></span>
  <%= 'entry'.pluralize(@filter_counts['all']) %> ·
  <span class="<%= @filter_counts['failed'].zero? ? 'text-secondary' : 'text-danger' %>"><%= @filter_counts['failed'] %></span>
  failed
  <% if @failed_in_queue_count > 0 %>
    · <%= link_to "#{@failed_in_queue_count} still waiting in the queue", queued_mails_path(filter: 'failed'),
                  class: 'text-danger text-decoration-none' %>
  <% end %>
<% end %>

<%= render layout: 'shared/list_page_header', locals: { title: 'Mail log', summary: summary } do %>
  <% if can?(:'queued_mail.view') %>
    <%= link_to 'Mail queue', queued_mails_path, class: 'btn btn-outline-secondary btn-sm' %>
  <% end %>
  <%= link_to 'Settings', settings_path, class: 'btn btn-outline-secondary btn-sm' %>
<% end %>

<%= render 'shared/smtp_warning' %>

<% if @state.present? || @search.present? %>
  <% state_label = MailLogHelper::STATE_CHIPS.find { |chip| chip[:state] == @state }&.dig(:label) %>
  <% banner_label = [state_label, (%("#{@search}") if @search.present?)].compact.join(' matching ') %>
  <%= render 'shared/list_filter_banner', label: banner_label, shown: @pagy.count,
             total: @filter_counts['all'], noun: 'entry', clear_path: mail_log_path %>
<% end %>

<%= render 'shared/list_filter_chip_row', label: 'Event', chips: mail_log_filter_chips(@filter_counts) %>

<div class="mt-3">
  <%= render 'shared/list_search', url: mail_log_path, frame: 'mail_log_results',
             placeholder: 'Search by recipient or subject…' %>
</div>

<%= turbo_frame_tag 'mail_log_results' do %>
  <% if @log_entries.any? %>
    <%= render layout: 'shared/list_table',
               locals: { body_id: 'mail_log_table_body',
                         headers: %w[When Event Message Now By Details] } do %>
      <% @log_entries.each do |entry| %>
        <% qm = entry.queued_mail %>
        <tr class="mail-log-row <%= 'row-attention' if entry.event == 'send_failed' && qm&.delivery_failed? %>">
          <td class="text-nowrap">
            <%= list_time_tag(entry.created_at) %>
            <% if entry.wait_duration_in_words %>
              <div class="text-11 text-secondary">after <%= entry.wait_duration_in_words %></div>
            <% end %>
          </td>
          <td class="text-nowrap"><%= mail_log_event_cell(entry.event) %></td>
          <td>
            <%= link_to entry.message_subject.presence || '(no subject)', mail_log_entry_path(entry),
                        class: 'fw-medium text-decoration-none cell-truncate', title: entry.message_subject,
                        data: { turbo_frame: '_top' } %>
            <div class="text-12 text-secondary">
              <%= entry.message_to %>
              <% if qm&.recipient %>
                · <%= link_to qm.recipient.display_name, user_path(qm.recipient), class: 'text-secondary',
                              data: { turbo_frame: '_top' } %>
              <% elsif entry.delivery_mailer.present? %>
                · <%= entry.delivery_mailer %>#<%= entry.delivery_action %>
              <% end %>
            </div>
          </td>
          <td class="text-nowrap">
            <% if (state = mail_log_queue_state(qm)) %>
              <%= link_to state, queued_mail_path(qm),
                          class: "text-13 text-decoration-none #{qm.delivery_failed? ? 'text-danger' : 'text-secondary'}",
                          data: { turbo_frame: '_top' } %>
            <% else %>
              <span class="text-secondary">—</span>
            <% end %>
          </td>
          <td class="text-nowrap text-13">
            <% if entry.actor %>
              <%= link_to entry.actor.display_name, user_path(entry.actor), class: 'text-secondary',
                          data: { turbo_frame: '_top' } %>
            <% else %>
              <span class="text-secondary">System</span>
            <% end %>
          </td>
          <td>
            <% if entry.details.present? %>
              <span class="text-secondary text-13 cell-truncate" title="<%= entry.details %>"><%= entry.details %></span>
            <% else %>
              <span class="text-secondary">—</span>
            <% end %>
          </td>
        </tr>
      <% end %>
    <% end %>
  <% elsif @state.present? || @search.present? %>
    <%= render 'shared/list_empty', icon: 'journal-text', message: 'No entries match these filters.' %>
  <% else %>
    <%= render 'shared/list_empty', icon: 'journal-text',
               message: 'No mail log entries yet. Entries appear when mail is queued, edited, approved, sent, or delivery fails.' %>
  <% end %>
  <%= render 'shared/pagination', pagy: @pagy %>
<% end %>
