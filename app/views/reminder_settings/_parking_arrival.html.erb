<div class="alert alert-secondary text-13 py-2 mb-3">
  This reminder goes out when the member badges in at an outside door, at most once per repeat window.
  It is not part of the daily run, and Send now does not apply. Members hush it from their notification
  preferences; the expiration reminders are a separate switch.
</div>

<div class="card shadow-sm border-0">
  <div class="card-body p-0">
    <% if @parking_arrival_members.any? %>
      <div class="table-responsive">
        <table class="table table-compact mb-0">
          <thead>
            <tr>
              <th>Member</th>
              <th class="num">Open notices</th>
              <th>Last reminder</th>
              <th>Email</th>
            </tr>
          </thead>
          <tbody>
            <% @parking_arrival_members.each do |user| %>
              <% notices = @open_notice_counts[user.id].to_i %>
              <tr>
                <td><%= link_to user.display_name, user_path(user), class: "text-decoration-none fw-medium" %></td>
                <td class="num <%= 'text-secondary' if notices.zero? %>"><%= notices %></td>
                <td><%= admin_profile_time(reminder_last_sent_at(user)) %></td>
                <td class="text-secondary"><%= user.email.presence || '—' %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <% if @pagy.pages > 1 %>
        <div class="p-3 border-top">
          <%== pagy_bootstrap_nav(@pagy) %>
        </div>
      <% end %>
    <% else %>
      <p class="text-secondary text-13 mb-0 p-3">No members have an open permit or ticket right now.</p>
    <% end %>
  </div>
</div>
