<% token = params[:token] %>
<div class="d-flex align-items-end justify-content-between mb-3">
  <div>
    <h1 class="h-page-title mb-0">Parking permit</h1>
    <div class="text-13 text-secondary mt-1">
      For <%= @link.user.display_name %>. This link works until
      <%= @link.expires_at.in_time_zone.strftime('%B %-d at %-l:%M %p') %> and does not sign you in.
    </div>
  </div>
  <% if @link.printable? %>
    <%= link_to parking_permit_form_pdf_path(token: token), class: 'btn btn-outline-secondary', target: '_blank', rel: 'noopener' do %>
      <i class="bi bi-printer me-1"></i> Print permit
    <% end %>
  <% end %>
</div>

<% if @link.editable? %>
  <% if @link.complete_permit? %>
    <p class="text-secondary mb-3">
      Your permit is valid until <strong><%= @parking_notice.expires_at.strftime('%B %d, %Y') %></strong>.
      Tell us what you parked and where, so the space knows whose it is.
    </p>
  <% end %>

  <div class="card shadow-sm border-0">
    <div class="card-body">
      <%= form_with model: @parking_notice, url: parking_permit_form_path(token: token), method: :patch, local: true do |f| %>
        <% if @parking_notice.errors.any? %>
          <div class="alert alert-danger">
            <ul class="mb-0">
              <% @parking_notice.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="mb-3">
          <%= f.label :description, class: 'form-label' %>
          <%= f.text_area :description, class: 'form-control', rows: 3, required: true,
                          placeholder: 'Describe your project or item...' %>
        </div>

        <div class="row g-3">
          <div class="col-md-6">
            <%= f.label :location, 'Room / Location', class: 'form-label' %>
            <%= f.text_field :location, class: 'form-control', required: true, placeholder: 'Example: Woodshop' %>
          </div>
          <div class="col-md-6">
            <%= f.label :location_detail, 'Location detail', class: 'form-label' %>
            <%= f.text_field :location_detail, class: 'form-control', placeholder: 'Example: South wall shelf' %>
          </div>
        </div>

        <% if @link.create_permit? %>
          <div class="mt-3" data-controller="quick-expire">
            <%= f.label :expires_at, 'Expiration', class: 'form-label' %>
            <div class="text-12 text-secondary mb-2">Self-service permits cannot exceed 2 weeks.</div>
            <%= render 'member_parking_permits/expiration_quick_buttons' %>
            <%= f.datetime_local_field :expires_at,
                                       class: 'form-control',
                                       required: true,
                                       max: ParkingNotice::MAX_SELF_SERVICE_DURATION.from_now.strftime('%Y-%m-%dT%H:%M'),
                                       data: { quick_expire_target: 'field' },
                                       value: @parking_notice.expires_at&.strftime('%Y-%m-%dT%H:%M') %>
          </div>
        <% end %>

        <div class="mt-4">
          <%= f.submit(@link.create_permit? ? 'Create parking permit' : 'Save permit details', class: 'btn btn-primary') %>
        </div>
      <% end %>
    </div>
  </div>
<% else %>
  <div class="card shadow-sm border-0">
    <div class="card-body">
      <dl class="row mb-0">
        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9"><%= @parking_notice.status_display %></dd>
        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9"><%= @parking_notice.description.presence || '—' %></dd>
        <dt class="col-sm-3">Location</dt>
        <dd class="col-sm-9"><%= @parking_notice.location_display.presence || '—' %></dd>
        <dt class="col-sm-3">Expires</dt>
        <dd class="col-sm-9"><%= @parking_notice.expires_at.strftime('%B %d, %Y %-l:%M %p') %></dd>
      </dl>
    </div>
  </div>
  <p class="text-13 text-secondary mt-3 mb-0">
    To change this permit later, sign in to Member Zone and open it from the parking tab of your profile.
  </p>
<% end %>
