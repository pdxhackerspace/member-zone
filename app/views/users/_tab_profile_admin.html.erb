<%# Admin Profile Tab %>
<% visibility_label = { 'public' => 'Public', 'members' => 'Other members', 'private' => 'Private' }[user.profile_visibility] || user.profile_visibility.humanize %>
<% trained_topics = user.trainings_as_trainee.map(&:training_topic).uniq.sort_by(&:name) %>
<% trained_topic_ids = trained_topics.map(&:id) %>
<% can_train_topics = user.training_topics.order(:name).to_a %>
<% can_train_topic_ids = can_train_topics.map(&:id) %>
<% all_training_topics = TrainingTopic.order(:name).to_a %>
<% untrained_topics = all_training_topics.reject { |topic| trained_topic_ids.include?(topic.id) } %>
<% grantable_topics = all_training_topics.reject { |topic| can_train_topic_ids.include?(topic.id) } %>
<%# Recording training and appointing trainers are trainers' work, not the profile viewer's.
    These mirror TrainingsController#require_trainer_or_admin at the coarse level; that
    controller still decides topic by topic. %>
<% can_record_training = @profile_caps[:record_training] %>
<% can_grant_trainer = @profile_caps[:grant_trainer] %>

<div <%= 'data-controller=sensitive-reveal'.html_safe if @profile_caps[:view_private_contact] %>>
<% if @profile_caps[:view_private_contact] %>
<div class="alert alert-secondary d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-2 mb-3">
  <p class="mb-0 small">Member email, mailing address, and phone fields are blurred until you show them.</p>
  <button type="button" class="btn btn-sm btn-outline-secondary text-nowrap flex-shrink-0"
          data-action="click->sensitive-reveal#toggle">
    <span data-sensitive-reveal-target="label">Show contact details</span>
  </button>
</div>
<% end %>

<div class="row g-3">
  <div class="col-lg-8">
    <div class="mb-4">
      <div class="profile-section-header">
        <span class="h-section-label">Identity</span>
      </div>
      <div class="profile-field-group">
        <div class="profile-field-row">
          <span class="profile-field-label">Username</span>
          <span class="profile-field-value"><%= user.username.presence || content_tag(:span, "Not provided", class: "empty") %></span>
        </div>

        <div class="profile-field-row">
          <span class="profile-field-label">Full name</span>
          <span class="profile-field-value"><%= user.full_name.presence || content_tag(:span, "Not provided", class: "empty") %></span>
        </div>

        <div class="profile-field-row">
          <span class="profile-field-label">Aliases</span>
          <span class="profile-field-value">
            <% if user.aliases.present? && user.aliases.any? %>
              <% user.aliases.each do |aliaz| %>
                <span class="cert-pill me-1"><%= aliaz %></span>
              <% end %>
            <% else %>
              <span class="empty">None</span>
            <% end %>
          </span>
        </div>

        <div class="profile-field-row">
          <span class="profile-field-label">Email</span>
          <span class="profile-field-value">
            <% if !@profile_caps[:view_private_contact] %>
              <span class="empty">Hidden</span>
            <% elsif user.email.present? %>
              <span data-sensitive-reveal-target="blurred"><%= mail_to(user.email) %></span>
            <% else %>
              <span class="empty">Not provided</span>
            <% end %>
          </span>
        </div>

        <div class="profile-field-row">
          <span class="profile-field-label">Extra emails</span>
          <span class="profile-field-value">
            <% if !@profile_caps[:view_private_contact] %>
              <span class="empty">Hidden</span>
            <% elsif user.extra_emails.present? && user.extra_emails.any? %>
              <span data-sensitive-reveal-target="blurred">
                <%= safe_join(user.extra_emails.map { |email| mail_to(email) }, tag.br) %>
              </span>
            <% else %>
              <span class="empty">None</span>
            <% end %>
          </span>
        </div>

        <div class="profile-field-row">
          <span class="profile-field-label">Mailing address</span>
          <span class="profile-field-value">
            <% if !@profile_caps[:view_private_contact] %>
              <span class="empty">Hidden</span>
            <% elsif user.mailing_address.present? %>
              <span data-sensitive-reveal-target="blurred"><%= simple_format(user.mailing_address, class: "mb-0") %></span>
            <% else %>
              <span class="empty">Not provided</span>
            <% end %>
          </span>
        </div>

        <div class="profile-field-row">
          <span class="profile-field-label">Phone number</span>
          <span class="profile-field-value">
            <% if !@profile_caps[:view_private_contact] %>
              <span class="empty">Hidden</span>
            <% elsif user.phone_number.present? %>
              <span data-sensitive-reveal-target="blurred"><%= user.phone_number %></span>
            <% else %>
              <span class="empty">Not provided</span>
            <% end %>
          </span>
        </div>

        <div class="profile-field-row">
          <span class="profile-field-label">Slack</span>
          <span class="profile-field-value">
            <% if user.slack_user.present? || user.slack_handle.present? || user.slack_id.present? %>
              <% if user.slack_id.present? && user.slack_user&.team_id.present? %>
                <% slack_url = "slack://user?team=#{user.slack_user.team_id}&id=#{user.slack_id}" %>
                <%= link_to(user.slack_handle.present? ? "@#{user.slack_handle}" : user.slack_id, slack_url, target: "_blank", rel: "noopener", class: "text-info-emphasis text-decoration-none") %>
              <% else %>
                <%= user.slack_handle.present? ? "@#{user.slack_handle}" : user.slack_user&.display_name %>
              <% end %>
              <% if user.slack_user.present? %>
                <%= link_to "Slack record", slack_user_path(user.slack_user), class: "text-12 text-info-emphasis ms-2" %>
              <% end %>
            <% else %>
              <span class="empty">Not linked</span>
            <% end %>
          </span>
        </div>
      </div>
    </div>

    <div class="mb-4">
      <div class="profile-section-header">
        <span class="h-section-label">Profile</span>
      </div>
      <div class="profile-field-group">
        <div class="profile-field-row">
          <span class="profile-field-label">About</span>
          <span class="profile-field-value">
            <% if user.bio.present? %>
              <%= sanitize(user.bio, tags: %w[p br strong b em i u s ul ol li a h1 h2 h3 h4 h5 h6 span div], attributes: %w[href target style]) %>
            <% else %>
              <span class="empty">Not provided</span>
            <% end %>
          </span>
        </div>

        <div class="profile-field-row">
          <span class="profile-field-label">Links</span>
          <span class="profile-field-value">
            <% if user.user_links.any? %>
              <% user.user_links.ordered.each do |link| %>
                <%= link_to sanitize_url(link.url), target: "_blank", rel: "noopener", class: "resource-link me-2" do %>
                  <i class="bi <%= link.icon_class %> me-1"></i><%= link.title %>
                <% end %>
              <% end %>
            <% else %>
              <span class="empty">None</span>
            <% end %>
          </span>
        </div>

        <div class="profile-field-row">
          <span class="profile-field-label">Visibility</span>
          <span class="profile-field-value"><%= visibility_label %></span>
        </div>

        <% if @profile_caps[:edit_notes] %>
        <div class="profile-field-row" data-action-key="members.edit_notes">
          <span class="profile-field-label">Notes</span>
          <span class="profile-field-value">
            <% if user.notes.present? %>
              <%= simple_format(user.notes, class: "mb-0") %>
            <% else %>
              <span class="empty">None</span>
            <% end %>
          </span>
        </div>
        <% end %>
      </div>
    </div>

    <div class="mb-4" id="training-access-section">
      <div class="profile-section-header">
        <span class="h-section-label">Training & access</span>
      </div>
      <div class="profile-field-group">
        <div class="profile-field-row">
          <span class="profile-field-label">Trained on</span>
          <div class="d-flex align-items-center gap-1 flex-wrap">
            <% if trained_topics.any? %>
              <% trained_topics.each do |topic| %>
                <span class="cert-pill d-inline-flex align-items-center">
                  <%= topic.name %>
                  <% if can_record_training %><%= button_to remove_training_path(user_id: user.id, topic_id: topic.id, return_to: 'profile'),
                      method: :delete,
                      class: "btn-link-danger ms-1 p-0 border-0 bg-transparent lh-1",
                      title: "Remove #{topic.name} training",
                      form: { class: 'd-inline', data: { turbo: false, turbo_confirm: "Remove #{topic.name} training from #{user.display_name}?" } } do %>
                    <i class="bi bi-x-lg"></i>
                  <% end %><% end %>
                </span>
              <% end %>
            <% else %>
              <span class="profile-field-value empty">None recorded</span>
            <% end %>
            <% if can_record_training && untrained_topics.any? %>
              <div class="dropdown d-inline-block ms-auto">
                <button class="btn-link-add" type="button" data-bs-toggle="dropdown" aria-expanded="false">+ Add training</button>
                <ul class="dropdown-menu dropdown-menu-end" style="max-height: 320px; overflow-y: auto;">
                  <% untrained_topics.each do |topic| %>
                    <li>
                      <%= button_to topic.name,
                          add_training_path(user_id: user.id, topic_id: topic.id, return_to: 'profile'),
                          method: :post,
                          class: "dropdown-item text-13",
                          form: { data: { turbo: false }.merge(inactive_training_notice_data(user)) } %>
                    </li>
                  <% end %>
                </ul>
              </div>
            <% end %>
          </div>
        </div>

        <div class="profile-field-row">
          <span class="profile-field-label">Can train</span>
          <div class="d-flex align-items-center gap-1 flex-wrap">
            <% if can_train_topics.any? %>
              <% can_train_topics.each do |topic| %>
                <span class="cert-pill d-inline-flex align-items-center">
                  <%= topic.name %>
                  <% if can_grant_trainer %><%= button_to remove_trainer_capability_path(user_id: user.id, topic_id: topic.id, return_to: 'profile'),
                      method: :delete,
                      class: "btn-link-danger ms-1 p-0 border-0 bg-transparent lh-1",
                      title: "Revoke #{topic.name} trainer capability",
                      form: { class: 'd-inline', data: { turbo: false, turbo_confirm: "Remove #{topic.name} trainer capability from #{user.display_name}?" } } do %>
                    <i class="bi bi-x-lg"></i>
                  <% end %><% end %>
                </span>
              <% end %>
            <% else %>
              <span class="profile-field-value empty">None</span>
            <% end %>
            <% if can_grant_trainer && grantable_topics.any? %>
              <div class="dropdown d-inline-block ms-auto">
                <button class="btn-link-add" type="button" data-bs-toggle="dropdown" aria-expanded="false">+ Add Can Train</button>
                <ul class="dropdown-menu dropdown-menu-end" style="max-height: 320px; overflow-y: auto;">
                  <% grantable_topics.each do |topic| %>
                    <li>
                      <%= button_to topic.name,
                          add_trainer_capability_path(user_id: user.id, topic_id: topic.id, return_to: 'profile'),
                          method: :post,
                          class: "dropdown-item text-13",
                          form: { data: { turbo: false } } %>
                    </li>
                  <% end %>
                </ul>
              </div>
            <% end %>
          </div>
        </div>

        <div class="profile-field-row">
          <span class="profile-field-label">Application</span>
          <span class="profile-field-value">
            <% if user.membership_applications.any? %>
              <% user.membership_applications.each do |app| %>
                <%= link_to "Application ##{app.id}", membership_application_path(app), class: "text-info-emphasis text-decoration-none me-2" %>
                <span class="badge text-bg-secondary-subtle small fw-normal me-1"><%= app.status.titleize %></span>
              <% end %>
            <% else %>
              <span class="empty">None linked</span>
            <% end %>
          </span>
        </div>

        <%# Seeing which fobs a member holds, issuing or removing one, and pausing access are
            three separate authorities — the Key fob manager role carries all three, but they
            are granted independently. %>
        <% if @profile_caps[:view_rfids] %>
        <div class="profile-field-row admin-rfid-row" data-action-key="access.view_rfids">
          <span class="profile-field-label">RFID keys</span>
          <div class="d-flex align-items-center gap-2 flex-wrap">
            <% if user.rfids.any? %>
              <% user.rfids.each do |rfid_record| %>
                <span class="rfid-key">
                  <span class="font-monospace"><%= rfid_record.rfid %></span>
                  <% if @profile_caps[:manage_rfids] %>
                    <%= button_to "Remove", rfid_path(rfid_record), method: :delete,
                        class: "btn-link-danger ms-1",
                        form: { data: { turbo: false, turbo_confirm: "Remove key fob #{rfid_record.rfid} from #{user.display_name}?" } } %>
                  <% end %>
                </span>
              <% end %>
            <% else %>
              <span class="profile-field-value empty">None</span>
            <% end %>
            <% if user.key_access_paused? %>
              <span class="badge text-bg-warning-subtle" title="<%= user.key_access_paused_at&.strftime('Paused %b %-d, %Y at %-l:%M %p') %>">
                <i class="bi bi-pause-circle me-1"></i>Access paused
              </span>
            <% end %>
            <span class="d-inline-flex align-items-center gap-3 ms-auto">
              <% if @profile_caps[:manage_rfids] %>
                <%= link_to "+ Add key", new_rfid_path(rfid: { user_id: user.id }), class: "btn-link-add",
                    data: { action_key: "access.manage_rfids" } %>
              <% end %>
              <% if @profile_caps[:pause_access] %>
                <% if user.key_access_paused? %>
                  <%= button_to "Resume access", resume_key_access_user_path(user), method: :post,
                      class: "btn-link-action", form: { class: "d-inline" },
                      data: { turbo: false } %>
                <% else %>
                  <%= button_to "Pause access", pause_key_access_user_path(user), method: :post,
                      class: "btn-link-action", form: { class: "d-inline" },
                      data: { turbo: false, turbo_confirm: "Pause RFID key access for #{user.display_name}? Their keys are kept but stop syncing to the access controllers." } %>
                <% end %>
              <% end %>
            </span>
          </div>
        </div>
        <% end %>
      </div>
    </div>

    <div class="mb-4">
      <div class="profile-section-header">
        <span class="h-section-label">System</span>
      </div>
      <div class="profile-field-group profile-field-group-compact">
        <div class="profile-field-row profile-field-row-system">
          <span class="profile-field-label">Authentik ID</span>
          <span class="profile-field-value">
            <% if user.authentik_id.present? %>
              <% if user.authentik_user.present? %>
                <%= link_to user.authentik_id, authentik_user_path(user.authentik_user), class: "font-monospace text-info-emphasis text-decoration-none" %>
              <% else %>
                <span class="font-monospace"><%= user.authentik_id %></span>
              <% end %>
            <% else %>
              <span class="empty">Not linked</span>
            <% end %>
          </span>
          <% if user.authentik_id.present? %>
            <% if @profile_caps[:unlink_sources] %>
              <%= button_to "Disassociate", unlink_authentik_user_path(user), method: :post,
                class: "btn-link-danger",
                form: { data: { turbo: false, turbo_confirm: "Disassociate this Authentik account from #{user.display_name}?" } } %>
            <% end %>
          <% else %>
            <span></span>
          <% end %>
        </div>

        <div class="profile-field-row profile-field-row-system">
          <span class="profile-field-label">Sheet entry</span>
          <span class="profile-field-value">
            <% if user.sheet_entry.present? %>
              <%= link_to user.sheet_entry.name, sheet_entry_path(user.sheet_entry), class: "text-info-emphasis text-decoration-none" %>
            <% else %>
              <span class="empty">Not linked</span>
            <% end %>
          </span>
          <% if user.sheet_entry.present? %>
            <% if @profile_caps[:unlink_sources] %>
              <%= button_to "Disassociate", unlink_sheet_user_path(user), method: :post,
                class: "btn-link-danger",
                form: { data: { turbo: false, turbo_confirm: "Disassociate this sheet entry from #{user.display_name}?" } } %>
            <% end %>
          <% else %>
            <span></span>
          <% end %>
        </div>

        <div class="profile-field-row profile-field-row-system">
          <span class="profile-field-label">Last access</span>
          <% if most_recent_access&.logged_at.present? %>
            <span class="profile-field-value" title="<%= l(most_recent_access.logged_at, format: :long) %>">
              <%= admin_profile_time(most_recent_access.logged_at) %>
              <% if most_recent_access.location.present? %>
                <span class="text-secondary">at <%= most_recent_access.location %></span>
              <% end %>
            </span>
          <% else %>
            <span class="profile-field-value empty">Never</span>
          <% end %>
          <span></span>
        </div>

        <div class="profile-field-row profile-field-row-system">
          <span class="profile-field-label">Last login</span>
          <%= admin_profile_time(user.last_login_at) %>
          <span></span>
        </div>

        <div class="profile-field-row profile-field-row-system">
          <span class="profile-field-label">Last synced</span>
          <%= admin_profile_time(user.last_synced_at) %>
          <span></span>
        </div>

        <div class="profile-field-row profile-field-row-system">
          <span class="profile-field-label">Created</span>
          <%= admin_profile_time(user.created_at) %>
          <span></span>
        </div>

        <div class="profile-field-row profile-field-row-system">
          <span class="profile-field-label">Updated</span>
          <%= admin_profile_time(user.updated_at) %>
          <span></span>
        </div>
      </div>
    </div>
  </div>

  <div class="col-lg-4">
    <%= render 'users/member_membership_card', user: user %>

    <%= render 'users/member_training_card', user: user, show_request_link: false %>

    <%= render 'users/member_resources_card', user: user %>
  </div>
</div>
</div>
