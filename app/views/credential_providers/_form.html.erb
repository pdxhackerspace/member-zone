<%= form_with model: @provider do |f| %>
  <% if @provider.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% @provider.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: "form-control", required: true, placeholder: "e.g., Authentik app passwords" %>
  </div>

  <div class="mb-3">
    <%= f.label :description, class: "form-label" %>
    <%= f.text_area :description, class: "form-control", rows: 2 %>
  </div>

  <div class="mb-3">
    <%= f.label :script_path, "Program", class: "form-label" %>
    <%= f.select :script_path, @script_options, { include_blank: "Choose a program" },
                 class: "form-select font-monospace", required: true %>
    <div class="form-text">
      Only executables in <code>scripts/credentials</code> or <code>CREDENTIAL_SCRIPTS_DIR</code> can be chosen.
      Saving asks the program what it issues.
    </div>
  </div>

  <div class="mb-3">
    <%= f.label :script_arguments, "Arguments (optional)", class: "form-label" %>
    <%= f.text_field :script_arguments, class: "form-control", placeholder: "e.g., --verbose" %>
  </div>

  <div class="mb-3">
    <%= f.label :environment_variables, "Environment variables (optional)", class: "form-label" %>
    <%# Never prefilled: the stored value holds API keys and is not shown back. %>
    <%= f.text_area :environment_variables, value: nil, class: "form-control font-monospace", rows: 4,
                    autocomplete: "off",
                    placeholder: (@provider.persisted? && @provider.environment_variables.present? ? "Stored. Leave blank to keep it, or enter new values to replace it." : "API_TOKEN=secret\nHOST=example.org") %>
    <div class="form-text">
      One per line as <code>KEY=value</code>; lines starting with <code>#</code> are ignored. Stored encrypted and
      never shown again.
      <% if @provider.persisted? && @provider.environment_variables.present? %>
        Currently set: <%= @provider.parsed_environment_variables.keys.join(', ').presence || 'no variables' %>.
      <% end %>
    </div>
    <% if @provider.persisted? && @provider.environment_variables.present? %>
      <div class="form-check mt-1">
        <%= check_box_tag "credential_provider[clear_environment_variables]", "1", false,
                          id: "credential_provider_clear_environment_variables", class: "form-check-input" %>
        <label for="credential_provider_clear_environment_variables" class="form-check-label text-13">
          Remove the stored environment variables
        </label>
      </div>
    <% end %>
  </div>

  <div class="mb-3">
    <%= f.label :required_training_topic_ids, "Required training (optional)", class: "form-label" %>
    <%= f.collection_select :required_training_topic_ids, @training_topics, :id, :name, {},
                            { multiple: true, class: "form-select", size: 6 } %>
    <div class="form-text">A member must hold <em>all</em> the selected topics to be issued a credential.</div>
  </div>

  <div class="row g-3 mb-3">
    <div class="col-md-4">
      <%= f.label :max_per_member, "Most credentials per member", class: "form-label" %>
      <%= f.number_field :max_per_member, class: "form-control", min: 1, max: 100 %>
    </div>
  </div>

  <div class="mb-2 form-check">
    <%= f.check_box :self_service, class: "form-check-input" %>
    <%= f.label :self_service, "Members can request their own credentials", class: "form-check-label" %>
    <div class="form-text">When off, only administrators with permission to issue for members can issue.</div>
  </div>

  <div class="mb-4 form-check">
    <%= f.check_box :enabled, class: "form-check-input" %>
    <%= f.label :enabled, "Enabled", class: "form-check-label" %>
  </div>

  <div class="d-flex gap-2">
    <%= f.submit class: "btn btn-primary btn-sm" %>
    <%= link_to "Cancel", (@provider.persisted? ? credential_provider_path(@provider) : credential_providers_path),
                class: "btn btn-outline-secondary btn-sm" %>
  </div>
<% end %>
