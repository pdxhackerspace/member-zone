<%# Per-bucket counts live on the tiles below; the header carries only the totals that frame them. %>
<% summary = capture do %>
  <span class="text-body"><%= number_with_delimiter(@filter_counts.fetch('all')) %></span>
  <%= 'message'.pluralize(@filter_counts.fetch('all')) %>
  <% if @pending_count > 0 %>
    · <span class="text-warning"><%= @pending_count %></span> awaiting review
  <% end %>
  <% if @failed_count > 0 %>
    · <%= link_to "#{@failed_count} failed to send", queued_mails_path(filter: 'failed'),
                  class: 'text-danger text-decoration-none' %>
  <% end %>
<% end %>

<%# Approving or rejecting the whole queue in one click is a different scale from reviewing a
    message, and no catalog key separates them — so it stays with administrators. %>
<% bulk_actions = @filter == 'pending' && @pending_count > 0 && current_user_admin? %>

<%= render layout: 'shared/list_page_header', locals: { title: 'Mail queue', summary: summary } do %>
  <% if bulk_actions %>
    <%= queued_mail_send_button 'Approve and send all', approve_all_queued_mails_path, primary: true,
                                confirm: "This will approve and send all #{@pending_count} pending message#{'s' if @pending_count != 1}. Continue?" %>
  <% end %>
  <% if can?(:'mail_log.view') %>
    <%= link_to 'Mail log', mail_log_path, class: 'btn btn-outline-secondary btn-sm' %>
  <% end %>
  <% if bulk_actions %>
    <div class="dropdown">
      <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="dropdown"
              aria-expanded="false" aria-label="More actions">&hellip;</button>
      <ul class="dropdown-menu dropdown-menu-end">
        <li>
          <%= button_to 'Reject all pending', reject_all_queued_mails_path, method: :post,
                        class: 'dropdown-item text-danger',
                        data: { turbo_confirm: "This will reject all #{@pending_count} pending message#{'s' if @pending_count != 1}. Continue?" } %>
        </li>
      </ul>
    </div>
  <% end %>
<% end %>

<%= render 'shared/smtp_warning' %>

<%= render 'shared/list_filter_tiles', tiles: queued_mail_filter_tiles(@filter_counts) %>

<% if @queued_mails.any? %>
  <%= render layout: 'shared/list_table',
             locals: { body_id: 'queued_mails_table_body',
                       headers: ['Message', 'Reason', 'Status', 'Queued', ['', 'text-end']] } do %>
    <% @queued_mails.each do |qm| %>
      <tr class="queued-mail-row <%= 'row-attention' if qm.delivery_failed? %>">
        <td>
          <%= link_to qm.subject.presence || '(no subject)', queued_mail_path(qm),
                      class: 'fw-medium text-decoration-none cell-truncate', title: qm.subject %>
          <div class="text-12 text-secondary">
            <%= qm.to %>
            <% if qm.recipient %>
              · <%= link_to qm.recipient.display_name, user_path(qm.recipient), class: 'text-secondary' %>
            <% end %>
          </div>
        </td>
        <td>
          <span class="text-secondary text-13 cell-truncate" title="<%= qm.reason %>"><%= qm.reason %></span>
        </td>
        <td>
          <%= queued_mail_status_cell(qm) %>
          <% if qm.delivery_failed? %>
            <% if qm.retries_exhausted? %>
              <div class="text-11 text-secondary mt-1">Gave up after <%= qm.send_attempts %> attempts</div>
            <% elsif qm.next_retry_at&.future? %>
              <div class="text-11 text-secondary mt-1">
                Retrying in <%= distance_of_time_in_words_to_now(qm.next_retry_at) %>
              </div>
            <% end %>
          <% end %>
        </td>
        <td class="text-nowrap"><%= list_time_tag(qm.created_at) %></td>
        <td class="text-end text-nowrap">
          <% if qm.delivery_failed? && current_user_admin? %>
            <%= button_to 'Retry', retry_queued_mail_path(qm), method: :post,
                          class: 'btn btn-sm btn-outline-secondary',
                          data: { turbo_confirm: "Retry sending this email to #{qm.to}?" } %>
          <% elsif qm.pending? && can?(:'queued_mail.approve') %>
            <div class="d-inline-flex gap-1">
              <%= queued_mail_send_button 'Approve and send', approve_queued_mail_path(qm),
                                          confirm: "This will send this email to #{qm.to}. Continue?" %>
              <div class="dropdown">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="dropdown"
                        aria-expanded="false" aria-label="More actions">&hellip;</button>
                <ul class="dropdown-menu dropdown-menu-end">
                  <li>
                    <%= button_to 'Reject', reject_queued_mail_path(qm), method: :post,
                                  class: 'dropdown-item text-danger',
                                  data: { turbo_confirm: 'Reject this email?' } %>
                  </li>
                </ul>
              </div>
            </div>
          <% end %>
        </td>
      </tr>
    <% end %>
  <% end %>
<% else %>
  <% empty_message = case @filter
                     when 'pending' then 'Nothing is waiting for review.'
                     when 'failed' then 'Nothing has failed to send. Messages wait here when the mail server will not take them.'
                     else "No #{@filter == 'all' ? '' : "#{@filter} "}messages yet."
                     end %>
  <%= render 'shared/list_empty', icon: 'envelope-check', message: empty_message %>
<% end %>

<%= render 'shared/pagination', pagy: @pagy %>
