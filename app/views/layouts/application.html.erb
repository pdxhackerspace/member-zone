<!DOCTYPE html>
<html data-bs-theme="light">
  <head>
    <title>MemberZone</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= yield :head %>
    <%= javascript_importmap_tags %>
    <script src="https://cdn.jsdelivr.net/npm/tinymce@6/tinymce.min.js"></script>
  </head>

  <body class="bg-body min-vh-100">
    <nav class="navbar navbar-expand-lg bg-body border-bottom shadow-sm">
      <div class="container">
        <% if !user_signed_in? || current_user_admin? %>
          <a class="navbar-brand" href="<%= root_path %>" aria-label="Home">
            <i class="bi bi-house"></i>
          </a>
        <% elsif user_signed_in? %>
          <%= link_to user_path(current_user, tab: :dashboard), class: 'navbar-brand', aria: { label: 'Dashboard' }, title: 'Dashboard' do %>
            <i class="bi bi-speedometer2"></i>
          <% end %>
        <% end %>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNav">
          <ul class="navbar-nav me-auto mb-2 mb-lg-0">
            <% if user_signed_in? %>
            <% if privileged_nav_visible? %>
                <%= render "layouts/main_nav" %>
              <% else %>
                <li class="nav-item" data-nav-key="training">
                  <%= link_to "Training", training_catalog_path, class: "nav-link #{controller_name == 'training_catalog' ? 'active' : ''}" %>
                </li>
              <% end %>
              <li class="nav-item dropdown">
                <% help_pages = controller_name == 'pages' && %w[help help_faq help_admin_faq].include?(action_name) %>
                <a class="nav-link dropdown-toggle <%= help_pages ? 'active' : '' %>"
                   href="#"
                   role="button"
                   data-bs-toggle="dropdown"
                   aria-expanded="false">
                  Help
                </a>
                <ul class="dropdown-menu">
                  <li>
                    <%= link_to "General", help_path, class: "dropdown-item #{controller_name == 'pages' && action_name == 'help' ? 'active' : ''}" %>
                  </li>
                  <li>
                    <%= link_to "FAQ", help_faq_path, class: "dropdown-item #{controller_name == 'pages' && action_name == 'help_faq' ? 'active' : ''}" %>
                  </li>
                  <% if can?(:'help.admin_faq') %>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                      <%= link_to "Admin FAQ", help_admin_faq_path, class: "dropdown-item #{controller_name == 'pages' && action_name == 'help_admin_faq' ? 'active' : ''}" %>
                    </li>
                  <% end %>
                </ul>
              </li>
            <% end %>
          </ul>
          <div class="d-flex gap-3 align-items-center">
            <% if user_signed_in? %>
              <%= form_with url: search_path, method: :get, local: true, class: "d-flex" do |f| %>
                <input type="search" name="q" value="<%= params[:q] %>" class="form-control form-control-sm me-2" placeholder="Search…" aria-label="Search" autocorrect="off" autocapitalize="off" spellcheck="false">
              <% end %>
            <% end %>
            <% if user_signed_in? %>
              <%= link_to current_user.display_name, user_path(current_user), class: "text-muted small text-decoration-none" %>
              <%= button_to "Sign out", logout_path, method: :delete, class: "btn btn-outline-secondary btn-sm" %>
            <% else %>
              <%= link_to "Sign in", login_path, class: "btn btn-primary btn-sm" %>
            <% end %>
          </div>
        </div>
      </div>
    </nav>

    <% if impersonating? %>
      <div class="bg-warning text-dark py-2">
        <div class="container d-flex justify-content-between align-items-center">
          <div>
            <i class="bi bi-person-badge me-2"></i>
            <strong>Impersonating:</strong> <%= current_user.display_name %>
            <span class="text-muted ms-2">(You are logged in as <%= true_user.display_name %>)</span>
          </div>
          <%= button_to "Stop Impersonating", stop_impersonation_path, method: :delete, class: "btn btn-dark btn-sm" %>
        </div>
      </div>
    <% end %>

    <% if user_signed_in? %>
      <% motd_content = TextFragment.content_for('motd') %>
      <% if motd_content.present? %>
        <div class="alpha-banner alert alert-info py-1 mb-0 small"
             data-controller="alpha-banner"
             style="border-radius: 0;">
          <div class="container d-flex justify-content-between align-items-center gap-3 px-3">
            <div class="motd-content d-flex align-items-center gap-2">
              <i class="bi bi-megaphone-fill flex-shrink-0" aria-hidden="true"></i>
              <span><%= sanitize(motd_content) %></span>
            </div>
            <button class="btn-close btn-close-white btn-sm flex-shrink-0" type="button" aria-label="Dismiss" data-action="alpha-banner#dismiss"></button>
          </div>
        </div>
      <% end %>
    <% end %>

    <main class="container py-4">
      <% flash.each do |type, message| %>
        <% next if message.blank? %>
        <div class="alert alert-<%= bootstrap_class_for(type) %> alert-dismissible fade show" role="alert">
          <%= message %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% end %>
      <%= yield %>
    </main>
    <footer class="container py-4 text-center text-muted small">
      Version: <span title="<%= AppVersion.current %>"><%= AppVersion.semver %></span>
      <% if (github_url = ENV['GITHUB_REPOSITORY_URL'].presence) %>
        &middot;
        <%= link_to "GitHub", github_url, target: "_blank", rel: "noopener", class: "text-muted" %>
      <% end %>
    </footer>
  </body>
  <script>
    (function() {
      function applyTheme() {
        var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        var theme = prefersDark ? 'dark' : 'light';
        document.documentElement.setAttribute('data-bs-theme', theme);
      }
      applyTheme();
      if (window.matchMedia) {
        var mql = window.matchMedia('(prefers-color-scheme: dark)');
        if (mql.addEventListener) {
          mql.addEventListener('change', applyTheme);
        } else if (mql.addListener) {
          // Safari <14
          mql.addListener(applyTheme);
        }
      }
    })();
  </script>
</html>
