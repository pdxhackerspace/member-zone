#!/usr/bin/env bash
# Restore a production/staging backup into the local dev database.
#
#   bin/dev-db-restore ~/Downloads/backup-mm.sql
#   bin/dev-db-restore --force backup.dump      # skip the confirmation prompt
#
# Accepts pg_dump custom-format archives (regardless of file extension), plain
# SQL, and gzipped plain SQL. Drops and recreates member_zone_development,
# restores, then applies any migrations the backup predates.
set -euo pipefail

COMPOSE_FILE="docker-compose.dev.yml"
DB_NAME="member_zone_development"
DB_USER="postgres"

# Backups are taken with pg_dump 18, whose custom-format archives (v1.16) the
# PostgreSQL 16 server's own pg_restore cannot read. A newer client reading into
# an older server is fine; the reverse is not.
CLIENT_IMAGE="${PG_CLIENT_IMAGE:-postgres:18-alpine}"

force=0
dump_path=""
for arg in "$@"; do
  case "$arg" in
    -f|--force) force=1 ;;
    -h|--help) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) dump_path="$arg" ;;
  esac
done

if [ -z "$dump_path" ]; then
  echo "usage: bin/dev-db-restore [--force] PATH_TO_BACKUP" >&2
  exit 64
fi

if [ ! -r "$dump_path" ]; then
  echo "error: cannot read $dump_path" >&2
  exit 66
fi

dump_path="$(cd "$(dirname "$dump_path")" && pwd)/$(basename "$dump_path")"

cd "$(dirname "$0")/.."

if [ "$force" -ne 1 ]; then
  if [ ! -t 0 ]; then
    echo "error: refusing to drop $DB_NAME without a terminal; pass --force" >&2
    exit 1
  fi
  printf 'This DROPS the local %s database. Continue? [y/N] ' "$DB_NAME"
  read -r reply
  case "$reply" in
    [yY]*) ;;
    *) echo "Aborted."; exit 1 ;;
  esac
fi

compose() { docker compose -f "$COMPOSE_FILE" "$@"; }
psql_dev() { compose exec -T db psql -U "$DB_USER" "$@"; }

echo "==> Starting database"
compose up -d db >/dev/null
until compose exec -T db pg_isready -U "$DB_USER" -q 2>/dev/null; do sleep 1; done

echo "==> Recreating $DB_NAME"
psql_dev -d postgres -q \
  -c "DROP DATABASE IF EXISTS $DB_NAME WITH (FORCE);" \
  -c "CREATE DATABASE $DB_NAME OWNER $DB_USER;"

# pg_dump 18 emits "SET transaction_timeout", which does not exist before
# PostgreSQL 17 and would abort the restore under ON_ERROR_STOP.
strip_incompatible_settings() { sed '/^SET transaction_timeout = /d'; }

read_dump() {
  if [ "$(head -c 5 "$dump_path")" = "PGDMP" ]; then
    docker run --rm -v "$dump_path:/backup.dump:ro" "$CLIENT_IMAGE" \
      pg_restore --no-owner --no-privileges -f - /backup.dump
  elif gzip -t "$dump_path" 2>/dev/null; then
    gzip -dc "$dump_path"
  else
    cat "$dump_path"
  fi
}

echo "==> Restoring $(basename "$dump_path")"
read_dump | strip_incompatible_settings \
  | psql_dev -d "$DB_NAME" -q -v ON_ERROR_STOP=1 >/dev/null

echo "==> Applying migrations newer than the backup"
compose --profile tools run --rm migrate

# Production authenticates through Authentik, so its backups contain no
# local_accounts rows and there is no way to sign in to the restored copy.
echo "==> Ensuring local sign-in account"
compose --profile tools run --rm --no-deps migrate bin/rails runner '
  email = LocalAuthConfig.settings.default_email
  password = LocalAuthConfig.settings.default_password

  if !LocalAuthConfig.enabled?
    puts "LOCAL_AUTH_ENABLED is false; skipping."
  elsif email.blank? || password.blank?
    puts "LOCAL_AUTH_EMAIL/LOCAL_AUTH_PASSWORD not set; skipping."
  else
    account = LocalAccount.provision!(
      email: email,
      password: password,
      full_name: LocalAuthConfig.settings.default_full_name
    )
    puts "Local sign-in ready: #{account.email}"
    puts LocalAuth::UnreadableAccounts.message if LocalAuth::UnreadableAccounts.any?
  end
'

echo "==> Done"
psql_dev -d "$DB_NAME" -c \
  "select (select count(*) from users) as users, (select count(*) from schema_migrations) as migrations;"
