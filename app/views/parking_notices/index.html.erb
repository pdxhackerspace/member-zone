<%# The type row has no All chip, so picking the type already showing clears that axis and
    leaves the status tiles alone. %>
<% status_path = ->(value) { parking_notices_path(status: value, type: params[:type]) } %>
<% type_path = lambda { |value|
     parking_notices_path(status: params[:status], type: (value unless params[:type] == value))
   } %>

<%= render layout: 'shared/list_page_header',
           locals: { title: 'Parking notices', count: @notice_count, noun: 'notice' } do %>
  <%= link_to 'New permit', new_parking_notice_path(type: 'permit'), class: 'btn btn-primary btn-sm' %>
  <%= link_to 'New ticket', new_parking_notice_path(type: 'ticket'), class: 'btn btn-outline-secondary btn-sm' %>
<% end %>

<% if @filter_active %>
  <% labels = [params[:status]&.capitalize, params[:type]&.pluralize&.capitalize].compact %>
  <%= render 'shared/list_filter_banner', label: "#{labels.join(' + ')} notices",
             shown: @notice_count, total: @status_counts[:all], clear_path: parking_notices_path %>
<% end %>

<%= render 'shared/list_filter_tiles', tiles: [
      { label: 'All', count: @status_counts[:all], path: status_path.call(nil),
        active: params[:status].blank? },
      { label: 'Active', count: @status_counts[:active], path: status_path.call('active'),
        active: params[:status] == 'active' },
      { label: 'Expired', count: @status_counts[:expired], path: status_path.call('expired'),
        active: params[:status] == 'expired', variant: 'warning' },
      { label: 'Cleared', count: @status_counts[:cleared], path: status_path.call('cleared'),
        active: params[:status] == 'cleared' }
    ] %>

<%# Permit or ticket is its own axis, so it stacks with the status filter above. %>
<div class="card shadow-sm border-0 mb-3">
  <div class="card-body py-2">
    <%= render 'shared/list_filter_chip_row', label: 'Type', chips: [
          { label: 'Permits', count: @type_counts.fetch('permit', 0), path: type_path.call('permit'),
            active: params[:type] == 'permit' },
          { label: 'Tickets', count: @type_counts.fetch('ticket', 0), path: type_path.call('ticket'),
            active: params[:type] == 'ticket' }
        ] %>
  </div>
</div>

<% if @parking_notices.any? %>
  <%= render layout: 'shared/list_table',
             locals: { body_id: 'parking_notices_table_body',
                       headers: ['Type', 'Members', 'Location', 'Description', 'Expires', 'Status',
                                 ['', 'text-end']] } do %>
    <% @parking_notices.each do |notice| %>
      <% expiring_soon = notice.active? && notice.expires_at <= 2.days.from_now %>
      <tr class="parking-notice-row <%= 'row-attention' if expiring_soon %>">
        <td><span class="text-secondary"><%= notice.notice_type_display %></span></td>
        <td>
          <% if notice.members.any? %>
            <%= parking_notice_members_display(notice, link: true) %>
          <% else %>
            <span class="text-secondary fst-italic">Unknown</span>
          <% end %>
        </td>
        <td><span class="text-secondary"><%= notice.location_display.presence || '—' %></span></td>
        <td>
          <% if notice.description.present? %>
            <span class="text-secondary cell-truncate" title="<%= notice.description %>">
              <%= truncate(notice.description.to_s, length: 50) %>
            </span>
          <% else %>
            <span class="text-secondary">—</span>
          <% end %>
        </td>
        <td>
          <% if expiring_soon %>
            <span class="text-warning fw-medium"
                  title="<%= l(notice.expires_at, format: :long) %>"><%= list_time_label(notice.expires_at) %></span>
          <% else %>
            <%= list_time_tag(notice.expires_at) %>
          <% end %>
        </td>
        <td>
          <span class="badge text-bg-<%= notice.status_badge_color %>-subtle"><%= notice.status_display %></span>
        </td>
        <td class="text-end">
          <div class="d-flex gap-1 justify-content-end align-items-center">
            <%= link_to 'View', parking_notice_path(notice), class: 'btn btn-sm btn-outline-secondary' %>
            <% if notice.active? %>
              <%= render 'shared/printer_print_button',
                         notice: notice, printers: @printers,
                         print_route: :print_notice_parking_notice_path,
                         btn_size: :sm, dropdown_suffix: notice.id %>
            <% end %>
          </div>
        </td>
      </tr>
    <% end %>
  <% end %>
<% elsif @filter_active %>
  <%= render 'shared/list_empty', icon: 'car-front', message: 'No parking notices match these filters.' %>
<% else %>
  <%= render 'shared/list_empty', icon: 'car-front', message: 'No parking notices have been issued yet.' %>
<% end %>

<%= render 'shared/pagination', pagy: @pagy %>
