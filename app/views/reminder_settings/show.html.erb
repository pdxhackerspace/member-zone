<div class="d-flex align-items-end justify-content-between mb-3">
  <div>
    <div class="text-12 text-secondary mb-1">
      <%= link_to "Reminders", reminder_settings_path, class: "text-secondary text-decoration-none" %>
      <span class="mx-1">/</span>
      <%= @reminder_setting.name %>
    </div>
    <h1 class="h-page-title mb-0"><%= @reminder_setting.name %></h1>
    <% if @reminder_setting.key == 'slack_signup' %>
      <div class="text-13 text-secondary mt-1">
        <span class="fw-medium text-body"><%= @slack_due_count %></span> would be emailed on the next run
        <% if @slack_without_slack_count > @slack_due_count %>
          · <span class="text-secondary"><%= @slack_without_slack_count %> active without Slack total</span>
        <% end %>
      </div>
    <% elsif @reminder_setting.key == 'application_link' %>
      <div class="text-13 text-secondary mt-1">
        <span class="fw-medium text-body"><%= @application_link_due_count %></span> would be emailed on the next run
        <% if @application_link_awaiting_count > @application_link_due_count %>
          · <span class="text-secondary"><%= @application_link_awaiting_count %> awaiting application total</span>
        <% end %>
      </div>
    <% elsif @reminder_setting.key == 'payment_overdue' %>
      <div class="text-13 text-secondary mt-1">
        <span class="fw-medium text-body"><%= @payment_overdue_due_count %></span> would be emailed on the next run
        <% if @payment_overdue_total_count > @payment_overdue_due_count %>
          · <span class="text-secondary"><%= @payment_overdue_total_count %> overdue total</span>
        <% end %>
      </div>
    <% elsif @reminder_setting.key == 'orientation' %>
      <div class="text-13 text-secondary mt-1">
        <span class="fw-medium text-body"><%= @orientation_due_count %></span> would be emailed on the next run
        <% if @orientation_awaiting_count > @orientation_due_count %>
          · <span class="text-secondary"><%= @orientation_awaiting_count %> awaiting orientation total</span>
        <% end %>
      </div>
    <% elsif @reminder_setting.key == 'parking_notices' %>
      <div class="text-13 text-secondary mt-1">
        <span class="fw-medium text-body"><%= @parking_due_count %></span> would be emailed on the next run
        <% if @parking_awaiting_count > @parking_due_count %>
          · <span class="text-secondary"><%= @parking_awaiting_count %> active or expired, not cleared</span>
        <% end %>
      </div>
    <% elsif @reminder_setting.key == 'lapsed_access' %>
      <div class="text-13 text-secondary mt-1">
        <span class="fw-medium text-body"><%= @lapsed_access_due_count %></span> would be emailed on the next run
        <% if @lapsed_access_yesterday_count > @lapsed_access_due_count %>
          · <span class="text-secondary"><%= @lapsed_access_yesterday_count %> inactive, accessed yesterday total</span>
        <% end %>
      </div>
    <% end %>
  </div>
  <div class="d-flex gap-2">
    <%= link_to "Back to Reminders", reminder_settings_path, class: "btn btn-outline-secondary btn-sm" %>
  </div>
</div>

<% if @reminder_setting.key == 'slack_signup' %>
  <% unless @slack_source_enabled %>
    <div class="alert alert-secondary text-13 py-2 mb-3">
      Slack member source is disabled, so the daily job will not send until Slack is enabled again.
    </div>
  <% end %>

  <div class="card shadow-sm border-0">
    <div class="card-body p-0">
      <% if @due_users.any? %>
        <div class="table-responsive">
          <table class="table table-compact mb-0">
            <thead>
              <tr>
                <th>Member</th>
                <th>Approved</th>
                <th>Last reminder</th>
                <th>Email</th>
              </tr>
            </thead>
            <tbody>
              <% @due_users.each do |user| %>
                <tr>
                  <td><%= link_to user.display_name, user_path(user), class: "text-decoration-none fw-medium" %></td>
                  <td><%= admin_profile_time(user.membership_approved_at, empty: 'Unknown') %></td>
                  <td><%= admin_profile_time(user.slack_signup_reminder_sent_at) %></td>
                  <td class="text-secondary"><%= user.email %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <% if @pagy.pages > 1 %>
          <div class="p-3 border-top">
            <%== pagy_bootstrap_nav(@pagy) %>
          </div>
        <% end %>
      <% else %>
        <p class="text-secondary text-13 mb-0 p-3">No members are due for this reminder right now.</p>
      <% end %>
    </div>
  </div>
<% elsif @reminder_setting.key == 'application_link' %>
  <div class="card shadow-sm border-0">
    <div class="card-body p-0">
      <% if @due_verifications.any? %>
        <div class="table-responsive">
          <table class="table table-compact mb-0">
            <thead>
              <tr>
                <th>Email</th>
                <th>Link sent</th>
                <th>Last reminder</th>
                <th class="num">Count</th>
                <th>Expires</th>
              </tr>
            </thead>
            <tbody>
              <% @due_verifications.each do |verification| %>
                <tr>
                  <td class="text-secondary"><%= verification.email %></td>
                  <td><%= admin_profile_time(verification.created_at) %></td>
                  <td><%= admin_profile_time(verification.application_link_reminder_sent_at) %></td>
                  <td class="num"><%= verification.application_link_reminder_count %></td>
                  <td><%= admin_profile_time(verification.expires_at) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <% if @pagy.pages > 1 %>
          <div class="p-3 border-top">
            <%== pagy_bootstrap_nav(@pagy) %>
          </div>
        <% end %>
      <% else %>
        <p class="text-secondary text-13 mb-0 p-3">No application links are due for a reminder right now.</p>
      <% end %>
    </div>
  </div>
<% elsif @reminder_setting.key == 'payment_overdue' %>
  <div class="alert alert-secondary text-13 py-2 mb-3">
    Members who have told us they are cancelling are not reminded — they keep access until their paid-through date and
    then become inactive.
  </div>

  <div class="card shadow-sm border-0">
    <div class="card-body p-0">
      <% if @due_users.any? %>
        <div class="table-responsive">
          <table class="table table-compact mb-0">
            <thead>
              <tr>
                <th>Member</th>
                <th>Overdue since</th>
                <th>Last reminder</th>
                <th>Email</th>
              </tr>
            </thead>
            <tbody>
              <% @due_users.each do |user| %>
                <tr>
                  <td><%= link_to user.display_name, user_path(user), class: "text-decoration-none fw-medium" %></td>
                  <td><%= admin_profile_time(user.dues_paid_through_at, empty: 'Unknown') %></td>
                  <td><%= admin_profile_time(user.payment_overdue_reminder_sent_at) %></td>
                  <td class="text-secondary"><%= user.email %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <% if @pagy.pages > 1 %>
          <div class="p-3 border-top">
            <%== pagy_bootstrap_nav(@pagy) %>
          </div>
        <% end %>
      <% else %>
        <p class="text-secondary text-13 mb-0 p-3">No members are due for this reminder right now.</p>
      <% end %>
    </div>
  </div>
<% elsif @reminder_setting.key == 'orientation' %>
  <% unless @building_access_topic %>
    <div class="alert alert-warning text-13 py-2 mb-3">
      No building access training topic is set, so every new member counts as un-oriented.
      <%= link_to "Set one in Membership settings", membership_settings_path, class: "alert-link" %>.
    </div>
  <% end %>

  <div class="card shadow-sm border-0">
    <div class="card-body p-0">
      <% if @due_users.any? %>
        <div class="table-responsive">
          <table class="table table-compact mb-0">
            <thead>
              <tr>
                <th>Member</th>
                <th>Accepted</th>
                <th>Last reminder</th>
                <th>Email</th>
              </tr>
            </thead>
            <tbody>
              <% @due_users.each do |user| %>
                <tr>
                  <td><%= link_to user.display_name, user_path(user), class: "text-decoration-none fw-medium" %></td>
                  <td><%= admin_profile_time(user.membership_approved_at, empty: 'Unknown') %></td>
                  <td><%= admin_profile_time(user.orientation_reminder_sent_at) %></td>
                  <td class="text-secondary"><%= user.email %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <% if @pagy.pages > 1 %>
          <div class="p-3 border-top">
            <%== pagy_bootstrap_nav(@pagy) %>
          </div>
        <% end %>
      <% else %>
        <p class="text-secondary text-13 mb-0 p-3">No members are due for this reminder right now.</p>
      <% end %>
    </div>
  </div>
<% elsif @reminder_setting.key == 'parking_notices' %>
  <div class="alert alert-secondary text-13 py-2 mb-3">
    Cleared notices are not reminded. Issued emails on creation are always sent separately from this reminder.
  </div>

  <div class="card shadow-sm border-0">
    <div class="card-body p-0">
      <% if @due_notices.any? %>
        <div class="table-responsive">
          <table class="table table-compact mb-0">
            <thead>
              <tr>
                <th>Member</th>
                <th>Type</th>
                <th>Location</th>
                <th>Expires</th>
                <th>Due</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @due_notices.each do |notice| %>
                <% phase = Reminders::ParkingNoticeEligibility.due_phase(notice) %>
                <tr>
                  <td>
                    <% if notice.user %>
                      <%= link_to notice.user.display_name, user_path(notice.user), class: "text-decoration-none fw-medium" %>
                    <% else %>
                      <span class="text-secondary">—</span>
                    <% end %>
                  </td>
                  <td><%= notice.notice_type_display %></td>
                  <td class="text-secondary"><%= notice.location_display.presence || '—' %></td>
                  <td><%= admin_profile_time(notice.expires_at) %></td>
                  <td><%= parking_reminder_phase_label(phase) %></td>
                  <td class="text-end">
                    <div class="d-inline-flex gap-2">
                      <%= link_to "View", parking_notice_path(notice), class: "btn btn-outline-secondary btn-sm" %>
                      <% if notice.clearable_by?(current_user) %>
                        <%= button_to "Clear", clear_parking_notice_path(notice, return_to: reminder_setting_path(@reminder_setting.key)),
                            method: :post,
                            class: "btn btn-outline-secondary btn-sm",
                            data: { turbo_confirm: "Clear this parking #{notice.notice_type}?" } %>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <% if @pagy.pages > 1 %>
          <div class="p-3 border-top">
            <%== pagy_bootstrap_nav(@pagy) %>
          </div>
        <% end %>
      <% else %>
        <p class="text-secondary text-13 mb-0 p-3">No parking notices are due for a reminder right now.</p>
      <% end %>
    </div>
  </div>
<% elsif @reminder_setting.key == 'lapsed_access' %>
  <div class="alert alert-secondary text-13 py-2 mb-3">
    Only members in the inactive state are reminded. Members who cancelled are excluded.
    The job scans access logs from yesterday each morning.
  </div>

  <div class="card shadow-sm border-0">
    <div class="card-body p-0">
      <% if @due_users.any? %>
        <div class="table-responsive">
          <table class="table table-compact mb-0">
            <thead>
              <tr>
                <th>Member</th>
                <th>Lapsed</th>
                <th>Last reminder</th>
                <th>Email</th>
              </tr>
            </thead>
            <tbody>
              <% @due_users.each do |user| %>
                <tr>
                  <td><%= link_to user.display_name, user_path(user), class: "text-decoration-none fw-medium" %></td>
                  <td><%= admin_profile_time(user.membership_state_entered_at, empty: 'Unknown') %></td>
                  <td><%= admin_profile_time(user.lapsed_access_reminder_sent_at) %></td>
                  <td class="text-secondary"><%= user.email %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <% if @pagy.pages > 1 %>
          <div class="p-3 border-top">
            <%== pagy_bootstrap_nav(@pagy) %>
          </div>
        <% end %>
      <% else %>
        <p class="text-secondary text-13 mb-0 p-3">No inactive members are due for this reminder right now.</p>
      <% end %>
    </div>
  </div>
<% end %>
