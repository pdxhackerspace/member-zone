<div class="d-flex align-items-end justify-content-between mb-3">
  <div>
    <h1 class="h-page-title mb-0">Mail Log</h1>
    <div class="text-13 text-secondary mt-1">
      <span class="text-body"><%= @filter_counts['all'] %></span> entries ·
      <span class="<%= @filter_counts['failed'].zero? ? 'text-secondary' : 'text-danger' %>">
        <%= @filter_counts['failed'] %>
      </span> failed
      <% if @failed_in_queue_count > 0 %>
        ·
        <%= link_to queued_mails_path(filter: 'failed'), class: "text-danger text-decoration-none" do %>
          <%= @failed_in_queue_count %> still waiting in the queue
        <% end %>
      <% end %>
    </div>
  </div>
  <div class="d-flex gap-2">
    <%= link_to "Mail Queue", queued_mails_path, class: "btn btn-outline-secondary btn-sm" %>
    <%= link_to "Back to Settings", settings_path, class: "btn btn-outline-secondary btn-sm" %>
  </div>
</div>

<%= render 'shared/smtp_warning' %>

<div class="d-flex flex-wrap align-items-center gap-2 mb-2">
  <% MailLogHelper::STATE_CHIPS.each do |chip| %>
    <%= render 'shared/filter_chip',
               label: chip[:label],
               variant: chip[:variant],
               count: @filter_counts.fetch(chip[:state] || 'all', 0),
               path: mail_log_path(state: chip[:state], q: @search.presence),
               active: mail_log_chip_active?(chip[:state]) %>
  <% end %>

  <%= form_with url: mail_log_path, method: :get, class: "d-flex gap-1 ms-auto" do |f| %>
    <%= f.hidden_field :state, value: @state %>
    <%= f.search_field :q, value: @search, placeholder: "Recipient or subject",
          class: "form-control form-control-sm", style: "width: 220px;" %>
    <%= f.submit "Search", class: "btn btn-outline-secondary btn-sm" %>
  <% end %>
</div>

<% if @state.present? || @search.present? %>
  <div class="text-12 text-secondary mb-3">
    <%= pluralize([@state, @search.presence].compact.size, 'filter') %> active ·
    <%= link_to "Clear", mail_log_path, class: "text-decoration-none" %>
  </div>
<% end %>

<% if @log_entries.any? %>
  <div class="card shadow-sm border-0">
    <div class="table-responsive">
      <table class="table table-compact table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th style="width: 150px;">When</th>
            <th style="width: 110px;">Event</th>
            <th>Message</th>
            <th style="width: 130px;">Now</th>
            <th style="width: 130px;">By</th>
            <th>Details</th>
          </tr>
        </thead>
        <tbody>
          <% @log_entries.each do |entry| %>
            <% qm = entry.queued_mail %>
            <tr>
              <td class="text-secondary text-nowrap" title="<%= entry.created_at.strftime('%b %d, %Y %l:%M:%S %p') %>">
                <%= entry.created_at.strftime('%b %d, %l:%M %p') %>
                <% if entry.wait_duration_in_words %>
                  <div class="text-11 text-secondary">after <%= entry.wait_duration_in_words %></div>
                <% end %>
              </td>
              <td>
                <span class="badge <%= mail_log_event_badge_class(entry.event) %>">
                  <%= mail_log_event_label(entry.event) %>
                </span>
              </td>
              <td>
                <div class="fw-medium">
                  <%= link_to truncate(entry.message_subject.to_s, length: 60).presence || '(no subject)',
                        mail_log_entry_path(entry), class: "text-decoration-none" %>
                </div>
                <div class="text-11 text-secondary">
                  <%= entry.message_to %>
                  <% if qm&.recipient %>
                    (<%= link_to qm.recipient.display_name, user_path(qm.recipient), class: "text-decoration-none" %>)
                  <% elsif entry.delivery_mailer.present? %>
                    · <%= entry.delivery_mailer %>#<%= entry.delivery_action %>
                  <% end %>
                </div>
              </td>
              <td class="text-nowrap">
                <% state = mail_log_queue_state(qm) %>
                <% if state %>
                  <%= link_to state, queued_mail_path(qm),
                        class: "text-12 text-decoration-none #{qm.delivery_failed? ? 'text-danger' : 'text-secondary'}" %>
                <% else %>
                  <span class="text-secondary">—</span>
                <% end %>
              </td>
              <td class="text-nowrap text-12">
                <% if entry.actor %>
                  <%= link_to entry.actor.display_name, user_path(entry.actor), class: "text-decoration-none" %>
                <% else %>
                  <span class="text-secondary">System</span>
                <% end %>
              </td>
              <td class="text-secondary text-12"><%= entry.details %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <% if @pagy.pages > 1 %>
    <div class="d-flex align-items-center justify-content-between mt-3">
      <div class="text-12 text-secondary">
        <%= @pagy.from %>–<%= @pagy.to %> of <%= @pagy.count %>
      </div>
      <%== pagy_bootstrap_nav(@pagy) %>
    </div>
  <% end %>
<% else %>
  <div class="card shadow-sm border-0">
    <div class="card-body text-center py-5">
      <i class="bi bi-journal-text display-4 mb-3 d-block text-muted opacity-25"></i>
      <p class="text-muted mb-0">
        <% if @state.present? || @search.present? %>
          No entries match these filters.
        <% else %>
          No mail log entries yet. Entries appear when mail is queued, edited, approved, sent, or delivery fails.
        <% end %>
      </p>
    </div>
  </div>
<% end %>
