<%= form_with model: @webhook_device, local: true do |f| %>
  <% if @webhook_device.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% @webhook_device.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: "form-control", required: true, placeholder: "e.g., Front door kiosk" %>
    <div class="form-text">Shown to members in permit emails ("You asked for a parking permit at …").</div>
  </div>

  <div class="mb-3">
    <%= f.label :description, "Description (optional)", class: "form-label" %>
    <%= f.text_area :description, class: "form-control", rows: 2 %>
  </div>

  <div class="form-check mb-4">
    <%= f.check_box :enabled, class: "form-check-input" %>
    <%= f.label :enabled, "Enabled — the device's token is accepted", class: "form-check-label" %>
  </div>

  <div class="d-flex gap-2">
    <%= f.submit(@webhook_device.persisted? ? "Save changes" : "Create device and issue token", class: "btn btn-primary") %>
    <%= link_to "Cancel", @webhook_device.persisted? ? webhook_device_path(@webhook_device) : webhook_devices_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
