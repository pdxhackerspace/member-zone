<% ma_nav = { q: params[:q].presence }.compact %>
<% mask_contact = membership_application_mask_contact_pii? %>

<div class="d-flex align-items-end justify-content-between mb-3">
  <div>
    <h1 class="h-page-title mb-0">Membership Applications</h1>
    <div class="text-13 text-secondary mt-1">
      <% if @processing_time_stats[:count].positive? %>
        Average processing time (last month):
        <span class="text-body"><%= @processing_time_stats[:average_label] %></span>
        <span class="text-secondary"> · <%= @processing_time_stats[:count] %> approved or rejected</span>
      <% else %>
        <span class="text-secondary">No applications approved or rejected in the last month</span>
      <% end %>
    </div>
  </div>
  <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#importApplicationsCsvModal">Import CSV</button>
</div>

<div class="modal fade" id="importApplicationsCsvModal" tabindex="-1" aria-labelledby="importApplicationsCsvModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="importApplicationsCsvModalLabel">Import membership applications from CSV</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <%= form_with url: import_membership_applications_path, method: :post, multipart: true, local: true do |f| %>
        <div class="modal-body">
          <p class="text-muted small mb-2">
            Columns <strong>Approved</strong>, <strong>Timestamp</strong>, and <strong>Email Address</strong> are required metadata.
            All other columns must match form question labels exactly (as in your export). Rows without an email are skipped.
          </p>
          <p class="text-muted small mb-3">
            Import does not send email and does not run the normal submit/approve workflow.
          </p>
          <div class="mb-3">
            <%= f.file_field :file, accept: 'text/csv,.csv', class: "form-control", required: true %>
          </div>
          <div class="alert alert-warning mb-0 small">
            <strong>Tip:</strong> Columns that do not match any question are appended to Admin notes on each application.
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <%= f.submit "Import", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<%= turbo_frame_tag 'membership_applications_table', data: { turbo_action: 'advance' } do %>
  <ul class="nav nav-tabs mb-3">
    <li class="nav-item">
      <%= link_to membership_applications_path(ma_nav.merge(status: 'submitted')),
          class: "nav-link #{@current_status == 'submitted' ? 'active' : ''}" do %>
        Open <span class="badge bg-primary"><%= @status_counts[:submitted] %></span>
      <% end %>
    </li>
    <li class="nav-item">
      <%= link_to membership_applications_path(ma_nav.merge(status: 'under_review')),
          class: "nav-link #{@current_status == 'under_review' ? 'active' : ''}" do %>
        Under Review <span class="badge bg-warning text-dark"><%= @status_counts[:under_review] %></span>
      <% end %>
    </li>
    <li class="nav-item">
      <%= link_to membership_applications_path(ma_nav.merge(status: 'approved')),
          class: "nav-link #{@current_status == 'approved' ? 'active' : ''}" do %>
        Approved <span class="badge bg-success"><%= @status_counts[:approved] %></span>
      <% end %>
    </li>
    <li class="nav-item">
      <%= link_to membership_applications_path(ma_nav.merge(status: 'rejected')),
          class: "nav-link #{@current_status == 'rejected' ? 'active' : ''}" do %>
        Rejected <span class="badge bg-danger"><%= @status_counts[:rejected] %></span>
      <% end %>
    </li>
    <li class="nav-item">
      <%= link_to membership_applications_path(ma_nav.merge(status: 'initiated')),
          class: "nav-link #{@current_status == 'initiated' ? 'active' : ''}" do %>
        Initiated <span class="badge bg-secondary"><%= @status_counts[:initiated] %></span>
      <% end %>
    </li>
    <li class="nav-item">
      <%= link_to membership_applications_path(ma_nav.merge(status: 'unlinked')),
          class: "nav-link #{@current_status == 'unlinked' ? 'active' : ''}" do %>
        Unlinked <span class="badge bg-warning text-dark"><%= @status_counts[:unlinked] %></span>
      <% end %>
    </li>
    <li class="nav-item">
      <%= link_to membership_applications_path(ma_nav.merge(status: 'all')),
          class: "nav-link #{@current_status == 'all' ? 'active' : ''}" do %>
        All <span class="badge bg-secondary"><%= @status_counts[:all] %></span>
      <% end %>
    </li>
  </ul>

  <div class="card shadow-sm border-0 mb-3">
    <div class="card-body py-2">
      <%= form_with url: membership_applications_path, method: :get, data: { controller: 'debounced-submit' } do %>
        <%= hidden_field_tag :status, params[:status] if params[:status].present? %>
        <%= hidden_field_tag :age, @current_age if @current_age %>
        <div class="d-flex gap-2 align-items-center">
          <%= search_field_tag :q, params[:q],
              class: 'form-control',
              placeholder: 'Search by name, full email, or any answer…',
              autocomplete: 'off', autocorrect: 'off', autocapitalize: 'off', spellcheck: 'false',
              aria: { label: 'Search applications' },
              data: {
                debounced_submit_target: 'input',
                action: 'input->debounced-submit#schedule'
              } %>
          <button type="button" class="btn btn-outline-secondary <%= 'd-none' if params[:q].blank? %>"
                  data-debounced-submit-target="clearButton"
                  data-action="click->debounced-submit#clear">
            Clear
          </button>
        </div>
      <% end %>
    </div>
  </div>

  <% if @current_age %>
    <% overdue_days = MembershipSetting.application_backlog_overdue_days %>
    <div class="d-flex align-items-center gap-2 mb-3 text-13">
      <span class="filter-chip active <%= 'danger' if @current_age == 'overdue' %>">
        <%= @current_age == 'overdue' ? 'Waiting more than' : 'Waiting' %>
        <%= overdue_days %> <%= 'day'.pluralize(overdue_days) %><%= ' or fewer' if @current_age == 'recent' %>
      </span>
      <%= link_to 'Show all open', membership_applications_path(ma_nav.merge(status: 'submitted')), class: 'text-secondary' %>
    </div>
  <% end %>

<% if @current_status == 'initiated' %>
  <% if @application_verifications.any? %>
    <div class="card shadow-sm border-0">
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th>Email</th>
              <th>Status</th>
              <th>Initiated</th>
              <th>Expires</th>
              <th>Received application</th>
              <th>Mail</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @application_verifications.each do |verification| %>
              <% received_apps = @received_applications_by_email.fetch(verification.email.downcase, []) %>
              <% mail_logs = @verification_mail_logs_by_email.fetch(verification.email.downcase, []) %>
              <tr>
                <td>
                  <%= membership_application_masked_contact_capture do %>
                    <code><%= verification.email %></code>
                  <% end %>
                </td>
                <td>
                  <% if verification.expired? %>
                    <span class="badge text-bg-danger">Expired</span>
                  <% elsif verification.email_verified? %>
                    <span class="badge text-bg-success">Verified</span>
                  <% else %>
                    <span class="badge text-bg-secondary">Email sent</span>
                  <% end %>
                </td>
                <td class="text-muted small"><%= verification.created_at.strftime('%b %d, %Y') %></td>
                <td class="text-muted small">
                  <%= verification.expires_at.strftime('%b %d, %Y %l:%M %p') %>
                </td>
                <td>
                  <% if received_apps.any? %>
                    <% received_apps.first(2).each do |app| %>
                      <div>
                        <%= link_to app.status_display, membership_application_path(app),
                            class: 'text-decoration-none',
                            data: { turbo_frame: '_top' } %>
                        <span class="text-muted small"><%= app.submitted_at&.strftime('%b %d, %Y') || app.created_at.strftime('%b %d, %Y') %></span>
                      </div>
                    <% end %>
                    <% if received_apps.size > 2 %>
                      <div class="text-muted small">and <%= received_apps.size - 2 %> more</div>
                    <% end %>
                  <% else %>
                    <span class="text-muted">—</span>
                  <% end %>
                </td>
                <td>
                  <% if mail_logs.any? %>
                    <% last_log = mail_logs.first %>
                    <%= link_to last_log.event.humanize, mail_log_entry_path(last_log),
                        class: "text-decoration-none #{'text-danger' if last_log.event == 'send_failed'}",
                        data: { turbo_frame: '_top' } %>
                  <% else %>
                    <span class="text-muted">—</span>
                  <% end %>
                </td>
                <td class="text-end text-nowrap">
                  <% if verification.awaiting_application? %>
                    <%= button_to "Re-send",
                        resend_initiated_membership_applications_path(verification),
                        method: :post,
                        class: "btn btn-sm btn-outline-secondary",
                        form: { class: 'd-inline-block' } %>
                    <%= button_to "+1 day",
                        extend_initiated_membership_applications_path(verification, duration: 'day'),
                        method: :post,
                        class: "btn btn-sm btn-outline-secondary",
                        form: { class: 'd-inline-block' } %>
                    <%= button_to "+1 week",
                        extend_initiated_membership_applications_path(verification, duration: 'week'),
                        method: :post,
                        class: "btn btn-sm btn-outline-secondary",
                        form: { class: 'd-inline-block' } %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="mt-3">
      <%== @pagy.series_nav(:bootstrap) if @pagy.pages > 1 %>
    </div>
  <% else %>
    <div class="text-center text-muted py-5">
      <i class="bi bi-inbox fs-1 d-block mb-2"></i>
      <p><%= params[:q].present? ? 'No initiated applications match your search.' : 'No initiated applications found.' %></p>
    </div>
  <% end %>
<% elsif @applications.any? %>
  <% show_link_actions = @applications.any?(&:linkable_to_member?) %>
  <div class="card shadow-sm border-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th>Name</th>
            <th>Status</th>
            <th>Submitted</th>
            <th>AI</th>
            <th>Admin votes</th>
            <th>Reviewed by</th>
            <th>Linked member</th>
            <% if show_link_actions %>
              <th class="text-end">Actions</th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% @applications.each do |app| %>
            <tr>
              <td>
                <%= link_to app.applicant_display_name(name_question_id: @applicant_name_question_id),
                            membership_application_path(app),
                            class: 'text-decoration-none fw-semibold',
                            data: { turbo_frame: '_top' } %>
              </td>
              <td>
                <span class="badge bg-<%= app.status_badge_color %><%= ' text-dark' if app.in_review? %>"><%= app.status_display %></span>
                <% if membership_application_applicant_status_path(app) %>
                  <div class="mt-1">
                    <%= render 'applicant_status_link',
                        application: app,
                        label: 'Applicant view',
                        btn_class: 'text-12 text-decoration-none' %>
                  </div>
                <% end %>
              </td>
              <td><%= app.submitted_at&.strftime('%b %d, %Y') || '—' %></td>
              <td class="text-nowrap">
                <% if app.ai_feedback_processed? %>
                  <span class="badge bg-dark"><%= app.ai_feedback_score.nil? ? '—' : app.ai_feedback_score %></span>
                  <% if app.ai_feedback_recommendation.present? %>
                    <span class="badge bg-<%= app.ai_feedback_recommendation_badge_color %>"><%= app.ai_feedback_recommendation.to_s.truncate(14) %></span>
                  <% end %>
                <% elsif app.ai_feedback_last_error.present? %>
                  <span class="badge bg-danger" title="<%= h app.ai_feedback_last_error %>">AI error</span>
                <% else %>
                  <span class="text-muted small">Pending</span>
                <% end %>
              </td>
              <td class="text-nowrap small">
                <% av_accept = app.acceptance_votes.count { |v| v.decision == 'accept' } %>
                <% av_reject = app.acceptance_votes.count { |v| v.decision == 'reject' } %>
                <% if av_accept.zero? && av_reject.zero? %>
                  <span class="text-muted">—</span>
                <% else %>
                  <span class="badge bg-success"><%= av_accept %></span>
                  <span class="text-muted">/</span>
                  <span class="badge bg-danger"><%= av_reject %></span>
                <% end %>
              </td>
              <td><%= app.reviewed_by&.display_name || '—' %></td>
              <td>
                <% if app.user %>
                  <%= link_to app.user.display_name, user_path(app.user),
                      class: "text-decoration-none",
                      data: { turbo_frame: '_top' } %>
                <% else %>
                  <span class="text-muted">—</span>
                <% end %>
              </td>
              <% if show_link_actions %>
                <td class="text-end text-nowrap">
                  <% if app.linkable_to_member? %>
                    <button type="button" class="btn btn-sm btn-primary"
                            data-bs-toggle="modal" data-bs-target="#maLinkMemberModal"
                            data-ma-link-action="<%= link_user_membership_application_path(app) %>"
                            <%# Withheld without applications.view_pii — this attribute put the
                                address in the page for every reviewer who could load the list. %>
                            <% unless membership_application_mask_contact_pii? %>
                              data-application-email="<%= h(app.email) %>"
                            <% end %>>
                      Link member
                    </button>
                  <% end %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="mt-3">
    <%== @pagy.series_nav(:bootstrap) if @pagy.pages > 1 %>
  </div>
<% else %>
  <div class="text-center text-muted py-5">
    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
    <p><%= params[:q].present? ? 'No applications match your search.' : 'No applications found.' %></p>
  </div>
<% end %>
<% end %><%# turbo_frame_tag membership_applications_table %>

<% if @users_for_application_link.any? %>
  <%= render 'link_member_modal', users: @users_for_application_link, dynamic: true, application_email: '', mask_contact: mask_contact %>
<% end %>
