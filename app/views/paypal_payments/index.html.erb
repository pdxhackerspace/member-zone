<%= render layout: 'shared/list_page_header',
           locals: { title: 'PayPal payments', count: @payment_count, total_amount: @total_amount } do %>
  <% if can?(:'payments.sync') %>
    <%= button_to 'Sync now', sync_paypal_payments_path, method: :post,
                  class: 'btn btn-primary btn-sm', data: { turbo: false } %>
  <% end %>
  <%# The kebab always opens: reading the unique subjects is part of payments.view, which
      everyone on this page holds, so it must not hide behind the import/export keys. %>
  <div class="dropdown">
    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="dropdown"
            aria-expanded="false" aria-label="More actions">&hellip;</button>
    <ul class="dropdown-menu dropdown-menu-end">
      <li><%= link_to 'View unique subjects', unmatched_subjects_paypal_payments_path, class: 'dropdown-item' %></li>
      <% if can?(:'payments.import_export') %>
        <li><%= link_to 'Export JSON', export_paypal_payments_path, class: 'dropdown-item', data: { turbo: false } %></li>
        <li>
          <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#importModal">
            Import JSON
          </button>
        </li>
      <% end %>
      <% if current_user_admin? %>
        <li><%= link_to 'Test', test_paypal_payments_path, class: 'dropdown-item' %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<% if @filter_active || @show_unmatched %>
  <% filter_labels = [(@show_unmatched ? 'Unmatched subjects' : nil),
                      { 'yes' => 'Linked', 'no' => 'Unlinked', 'dont_link' => "Don't link" }[params[:linked]]].compact %>
  <%= render 'shared/list_filter_banner',
             label: "#{filter_labels.presence&.join(' / ') || 'Searched'} payments",
             shown: @payment_count, total: PaypalPayment.count, clear_path: paypal_payments_path %>
<% end %>

<% unmatched_param = @show_unmatched ? { show_unmatched: 'true' } : {} %>
<%= render 'shared/list_filter_tiles', tiles: [
      { label: 'All', count: @total_count, path: paypal_payments_path(unmatched_param),
        active: params[:linked].blank? },
      { label: 'Linked', count: @linked_count, path: paypal_payments_path(unmatched_param.merge(linked: 'yes')),
        active: params[:linked] == 'yes' },
      { label: 'Unlinked', count: @unlinked_count, path: paypal_payments_path(unmatched_param.merge(linked: 'no')),
        active: params[:linked] == 'no', variant: 'warning' },
      { label: "Don't link", count: @dont_link_count,
        path: paypal_payments_path(unmatched_param.merge(linked: 'dont_link')),
        active: params[:linked] == 'dont_link' }
    ] %>

<div class="d-flex flex-wrap gap-2 mb-3">
  <%= render 'shared/filter_chip', label: 'Matching a plan', count: @matched_plan_count,
             path: paypal_payments_path, active: !@show_unmatched %>
  <%= render 'shared/filter_chip', label: 'Unmatched subjects', count: @unmatched_plan_count,
             path: paypal_payments_path(show_unmatched: 'true'), active: @show_unmatched, variant: 'danger' %>
</div>

<!-- Import Modal -->
<div class="modal fade" id="importModal" tabindex="-1" aria-labelledby="importModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="importModalLabel">Import PayPal Payments from JSON</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <%= form_with url: import_paypal_payments_path, method: :post, multipart: true, local: true do |f| %>
        <div class="modal-body">
          <p class="text-muted">Select a JSON backup file to import. This will update existing payments and create new ones based on <code>paypal_id</code>.</p>
          <div class="mb-3">
            <%= f.file_field :file, accept: 'application/json', class: "form-control", required: true %>
          </div>
          <div class="alert alert-warning mb-0">
            <strong>Warning:</strong> This operation will modify the database. Existing payments with matching <code>paypal_id</code> will be updated.
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <%= f.submit "Import", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<%= render 'shared/list_search', url: paypal_payments_path, frame: 'paypal_payments_results',
           placeholder: 'Search by transaction ID, payer name, full email, or status…' %>

<%= turbo_frame_tag 'paypal_payments_results' do %>
  <% if @payments.any? %>
    <%= render layout: 'shared/list_table',
               locals: { body_id: 'paypal_payments_table_body',
                         headers: ['Transaction', 'Status', ['Amount', 'num'], 'Payer', 'Time'] } do %>
      <% @payments.each do |payment| %>
        <% unlinked = payment.user.blank? && !payment.dont_link? %>
        <tr class="paypal-payment-row <%= 'row-attention' if unlinked %>"
            data-live-filter-target="item"
            data-search-text="<%= [
              payment.paypal_id,
              payment.payer_name,
              payment.status.presence || 'unknown',
              payment.amount_with_currency,
              payment.user&.display_name,
              payment.user_id.present? ? 'linked' : 'unlinked'
            ].compact.join(' ').downcase %>">
          <td>
            <%= link_to payment.paypal_id, paypal_payment_path(payment),
                        class: 'fw-medium text-decoration-none', data: { turbo_frame: '_top' } %>
          </td>
          <td><%= list_status_cell(payment.status) %></td>
          <td class="num"><%= list_money_tag(payment.amount, payment.currency) %></td>
          <td class="paypal-payment-payer">
            <%= render 'shared/payment_member_cell', payment: payment, name: payment.payer_name,
                       link_path: paypal_payment_path(payment), unlinked: unlinked %>
          </td>
          <td><%= list_time_tag(payment.transaction_time) %></td>
        </tr>
      <% end %>
    <% end %>
  <% elsif @filter_active || @show_unmatched %>
    <%= render 'shared/list_empty', icon: 'paypal', message: 'No PayPal payments match these filters.' %>
  <% elsif @unmatched_plan_count.positive? %>
    <%# The default list is the payments matching a plan, so an empty one with unmatched
        payments waiting means the subjects need plans, not that the sync found nothing. %>
    <%# Breaks out of the results frame: it changes which payments the whole page is about,
        so the header, tiles and chips have to be redrawn with it. %>
    <% unmatched_action = link_to 'View unmatched subjects', paypal_payments_path(show_unmatched: 'true'),
                                  class: 'btn btn-outline-secondary btn-sm',
                                  data: { turbo_frame: '_top' } %>
    <% waiting = pluralize(@unmatched_plan_count, 'payment') %>
    <%= render 'shared/list_empty', icon: 'paypal', action: unmatched_action,
               message: "No PayPal payment matches a membership plan yet — #{waiting} waiting on a subject no plan claims." %>
  <% else %>
    <%= render 'shared/list_empty', icon: 'paypal',
               message: 'No PayPal payments have been synced yet.' %>
  <% end %>
  <%= render 'shared/pagination', pagy: @pagy %>
<% end %>
