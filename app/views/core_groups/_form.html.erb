<%= form_with model: @core_group, scope: :core_group,
      url: @core_group.persisted? ? default_settings_core_group_path(@core_group) : default_settings_core_groups_path,
      local: true do |f| %>
  <% if @core_group.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% @core_group.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :name, class: 'form-label' %>
    <%= f.text_field :name, class: 'form-control', required: true, id: 'core_group_name' %>
  </div>

  <div class="mb-3">
    <%= f.label :authentik_name, 'Authentik group name', class: 'form-label' %>
    <%= f.text_field :authentik_name, class: 'form-control', required: true, id: 'core_group_authentik_name' %>
    <div class="form-text">The name of this group in Authentik. Filled in from the name, under the members prefix.</div>
  </div>

  <div class="mb-3">
    <%= f.label :note, class: 'form-label' %>
    <%= f.text_area :note, class: 'form-control', rows: 3 %>
  </div>

  <div class="d-flex gap-2">
    <%= f.submit @core_group.persisted? ? 'Update group' : 'Create group', class: 'btn btn-primary' %>
    <%= link_to 'Cancel', @core_group.persisted? ? default_settings_core_group_path(@core_group) : default_settings_path,
                class: 'btn btn-outline-secondary' %>
  </div>
<% end %>

<script>
(function() {
  const nameField = document.getElementById('core_group_name');
  const authentikNameField = document.getElementById('core_group_authentik_name');
  if (!nameField || !authentikNameField) return;

  const initialValue = authentikNameField.value || '';
  const lastColon = initialValue.lastIndexOf(':');
  const prefix = lastColon >= 0 ? initialValue.substring(0, lastColon + 1) : initialValue;

  function slugify(text) {
    return text.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
  }

  nameField.addEventListener('input', function() {
    const slug = slugify(nameField.value);
    authentikNameField.value = slug ? prefix + slug : prefix;
  });
})();
</script>
