<%= render layout: 'shared/payment_index_header',
           locals: { title: 'Cash payments', count: @payment_count, total_amount: @total_amount } do %>
  <%= gate :'payments.manage_cash' do %>
    <%= link_to 'Record payment', new_cash_payment_path, class: 'btn btn-primary btn-sm' %>
  <% end %>
<% end %>

<% if @filter_active %>
  <% filter_label = { 'month' => 'This month', 'year' => 'This year' }[params[:period]] %>
  <%= render 'shared/payment_filter_banner', label: "#{filter_label || 'Searched'} payments",
             shown: @payment_count, total: @total_count, clear_path: cash_payments_path %>
<% end %>

<%= render 'shared/payment_filter_tiles', tiles: [
      { label: 'All', count: @total_count, path: cash_payments_path, active: params[:period].blank? },
      { label: 'This month', count: @month_count, path: cash_payments_path(period: 'month'),
        active: params[:period] == 'month' },
      { label: 'This year', count: @year_count, path: cash_payments_path(period: 'year'),
        active: params[:period] == 'year' }
    ] %>

<%= render 'shared/payment_search', url: cash_payments_path, frame: 'cash_payments_results',
           placeholder: 'Search by member name, full email, plan, or notes…' %>

<%= turbo_frame_tag 'cash_payments_results' do %>
  <% if @cash_payments.any? %>
    <%= render layout: 'shared/payment_table',
               locals: { body_id: 'cash_payments_table_body',
                         headers: ['Member', 'Plan', ['Amount', 'num'], 'Date', 'Notes', 'Recorded by',
                                   ['', 'text-end']] } do %>
      <% @cash_payments.each do |payment| %>
        <tr class="cash-payment-row"
            data-live-filter-target="item"
            data-search-text="<%= [
              payment.user.display_name,
              payment.membership_plan&.name,
              payment.notes,
              payment.recorded_by&.display_name
            ].compact.join(' ').downcase %>">
          <td class="cash-payment-member">
            <%= link_to payment.user.display_name, cash_payment_path(payment),
                        class: 'fw-medium text-decoration-none', data: { turbo_frame: '_top' } %>
          </td>
          <td><span class="text-secondary"><%= payment.membership_plan&.name %></span></td>
          <td class="num"><%= payment_money_tag(payment.amount, 'USD') %></td>
          <td><%= payment_time_tag(payment.paid_on) %></td>
          <td>
            <% if payment.notes.present? %>
              <span class="text-secondary cell-truncate" title="<%= payment.notes %>">
                <%= truncate(payment.notes, length: 60) %>
              </span>
            <% else %>
              <span class="text-secondary">—</span>
            <% end %>
          </td>
          <td>
            <% if payment.recorded_by.present? %>
              <span class="text-secondary"><%= payment.recorded_by.display_name %></span>
            <% else %>
              <span class="text-secondary">—</span>
            <% end %>
          </td>
          <td class="text-end">
            <%= gate :'payments.manage_cash' do %>
              <%= link_to 'Edit', edit_cash_payment_path(payment), class: 'btn btn-sm btn-outline-secondary',
                          data: { turbo_frame: '_top' } %>
            <% end %>
          </td>
        </tr>
      <% end %>
    <% end %>
  <% elsif @filter_active %>
    <%= render 'shared/payment_empty', icon: 'cash-coin', message: 'No cash payments match these filters.' %>
  <% else %>
    <% first_payment_action = gate :'payments.manage_cash' do %>
      <%= link_to 'Record first payment', new_cash_payment_path, class: 'btn btn-primary btn-sm' %>
    <% end %>
    <%= render 'shared/payment_empty', icon: 'cash-coin', action: first_payment_action,
               message: 'No cash payments have been recorded yet.' %>
  <% end %>
  <%= render 'shared/pagination', pagy: @pagy %>
<% end %>
