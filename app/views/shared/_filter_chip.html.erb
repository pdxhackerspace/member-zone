<%# One filter chip, as a link unless its bucket is empty — a chip showing 0 has nothing to open.
    Locals: label, count, path, active, and optional variant ('warning' / 'danger') and data (link
    data attributes, e.g. { turbo_frame: '_top' } for a chip inside a frame that must leave it). %>
<% classes = filter_chip_class(active: active, count: count, variant: local_assigns[:variant]) %>
<% if count.zero? %>
  <span class="<%= classes %>" aria-disabled="true">
    <%= label %> <span class="count"><%= count %></span>
  </span>
<% else %>
  <%= link_to path, class: classes, data: local_assigns[:data] do %>
    <%= label %> <span class="count"><%= count %></span>
  <% end %>
<% end %>
