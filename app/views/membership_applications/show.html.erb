<% mask_contact = membership_application_mask_contact_pii? %>
<div class="membership-application-show">
<% if mask_contact %>
  <div class="alert alert-secondary mb-3">
    <p class="mb-0 small">Applicant email, mailing address, phone, and referring member contact
    details are hidden. Reviewing them needs the applicant contact details privilege.</p>
  </div>
<% end %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0">
    Application #<%= @application.id %>
    <span class="badge bg-<%= @application.status_badge_color %><%= ' text-dark' if @application.in_review? %>"><%= @application.status_display %></span>
  </h1>
  <div class="d-flex gap-2">
    <%= render 'applicant_status_link', application: @application %>
    <%= link_to membership_applications_path, class: "btn btn-outline-secondary btn-sm" do %>
      <i class="bi bi-arrow-left me-1"></i> Back
    <% end %>
  </div>
</div>

<div class="card shadow-sm border-0 mb-4">
  <div class="card-body">
    <div class="row">
      <div class="col-md-6">
        <dl>
          <div class="rounded border border-secondary-subtle bg-body-tertiary p-3 mb-2">
            <dt>Email</dt>
            <dd class="mb-0">
              <%= membership_application_masked_contact_capture do %>
                <%= @application.email %>
              <% end %>
            </dd>
          </div>

          <div class="rounded border border-secondary-subtle bg-body-tertiary p-3 mb-2">
            <dt>Status</dt>
            <dd class="mb-0"><span class="badge bg-<%= @application.status_badge_color %><%= ' text-dark' if @application.in_review? %>"><%= @application.status_display %></span></dd>
          </div>

          <div class="rounded border border-secondary-subtle bg-body-tertiary p-3 mb-2">
            <dt>Submitted</dt>
            <dd class="mb-0"><%= @application.submitted_at&.strftime('%B %d, %Y at %l:%M %p') || 'Not yet submitted' %></dd>
          </div>

          <div class="rounded border border-secondary-subtle bg-body-tertiary p-3 mb-0">
            <dt>Linked Member</dt>
            <dd class="mb-0 d-flex flex-wrap align-items-center gap-2">
              <% if @application.user %>
                <%= link_to @application.user.display_name, user_path(@application.user), class: "text-decoration-none" %>
                <%= button_to 'Unlink', unlink_user_membership_application_path(@application),
                              method: :post,
                              class: 'btn btn-sm btn-outline-warning',
                              form: { data: { turbo_confirm: 'Remove the member link from this application?' } } %>
              <% else %>
                <span class="text-muted">Not linked</span>
                <% if @application.linkable_to_member? && @users_for_application_link.any? %>
                  <button type="button" class="btn btn-sm btn-primary"
                          data-bs-toggle="modal" data-bs-target="#maLinkMemberModal">
                    Link member
                  </button>
                <% end %>
              <% end %>
            </dd>
          </div>
        </dl>
      </div>
      <div class="col-md-6">
        <dl>
          <% if @application.reviewed_by.present? %>
            <div class="rounded border border-secondary-subtle bg-body-tertiary p-3 mb-2">
              <dt>Reviewed By</dt>
              <dd class="mb-0"><%= link_to @application.reviewed_by.display_name, user_path(@application.reviewed_by) %></dd>
            </div>
          <% end %>

          <% if @application.reviewed_at.present? %>
            <div class="rounded border border-secondary-subtle bg-body-tertiary p-3 mb-2">
              <dt>Reviewed On</dt>
              <dd class="mb-0"><%= @application.reviewed_at.strftime('%B %d, %Y at %l:%M %p') %></dd>
            </div>
          <% end %>

          <% if @application.admin_notes.present? %>
            <div class="rounded border border-secondary-subtle bg-body-tertiary p-3 mb-0">
              <dt>Admin Notes</dt>
              <dd class="mb-0"><%= simple_format(@application.admin_notes) %></dd>
            </div>
          <% end %>
        </dl>
      </div>
    </div>
  </div>
</div>

<% unless @application.draft? %>
  <%= render 'ai_feedback_card', application: @application, current_ai_feedback_vote: @current_ai_feedback_vote %>
  <%= render 'tour_feedback_card', application: @application, current_tour_feedback: @current_tour_feedback %>
<% end %>

<% if @application.linkable_to_member? && @users_for_application_link.any? %>
  <%= render 'link_member_modal',
             users: @users_for_application_link,
             form_url: link_user_membership_application_path(@application),
             application_email: @application.email,
             mask_contact: mask_contact %>
<% end %>

<% @pages_with_answers.each do |entry| %>
  <% page = entry[:page] %>
  <% questions = entry[:questions] %>
  <div class="card shadow-sm border-0 mb-3">
    <div class="card-header bg-body-secondary">
      <h5 class="mb-0"><%= page.title.to_s.titleize %></h5>
      <% if page.description.present? %>
        <small class="text-body-secondary"><%= page.description %></small>
      <% end %>
    </div>
    <div class="card-body">
      <div class="rounded border border-secondary-subtle bg-body-tertiary p-3">
        <% questions.each_with_index do |qa, idx| %>
          <div class="<%= 'border-bottom border-secondary-subtle pb-3 mb-3' if idx < questions.length - 1 %>">
            <div class="text-muted small fw-semibold mb-1"><%= qa[:question].label.to_s.titleize %></div>
            <div class="mb-0">
              <% if qa[:answer]&.value.present? %>
                <% if membership_application_sensitive_answer_label?(qa[:question].label) %>
                  <%= membership_application_masked_contact_capture do %>
                    <%= simple_format(qa[:answer].value) %>
                  <% end %>
                <% else %>
                  <%= simple_format(qa[:answer].value) %>
                <% end %>
              <% else %>
                <span class="text-muted fst-italic">No answer</span>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<% unless @application.draft? || @application.needs_review? %>
  <%= render 'acceptance_votes_card', application: @application, current_acceptance_vote: @current_acceptance_vote %>
<% end %>

<%# Each verb carries its own privilege, so the buttons are offered one by one: a reviewer may
    hold reject or park without approve, and vice versa. %>
<% can_approve = can?(:'applications.approve') %>
<% can_reject = can?(:'applications.reject') %>
<% can_park = can?(:'applications.park_review') && @application.submitted? %>
<% can_decide = can_approve || can_reject || can_park %>

<% unless @application.approved? || @application.rejected? %>
  <div id="review-section" class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-body-secondary">
      <h5 class="mb-0">Final Decision</h5>
    </div>
    <div class="card-body">
      <% if can_decide %>
        <div class="mb-3">
          <label for="admin_notes" class="form-label">Notes for the record <span class="text-muted small">(optional)</span></label>
          <textarea id="admin_notes" class="form-control" rows="3"
                    placeholder="Reason for approval or rejection…"><%= @application.admin_notes %></textarea>
        </div>
        <div class="d-flex flex-wrap gap-2">
          <% if can_approve %>
            <%# An admin holding no role that grants applications.approve is seeing this button on the
                is_admin bypass alone. They keep it — the organization must never be unable to accept a
                member — but they get an acknowledgement instead of the one-click confirm. %>
            <% approve_on_bypass = admin_bypass_only?(:'applications.approve') %>
            <%= form_with url: approve_membership_application_path(@application), method: :post, local: true,
                          data: (approve_on_bypass ? approve_override_confirm_data : {}) do %>
              <input type="hidden" name="admin_notes" id="approve_admin_notes" value="">
              <%= button_tag type: :submit, class: 'btn btn-success review-btn',
                             data: (approve_on_bypass ? {} : { turbo_confirm: 'Approve this application?' }) do %>
                <i class="bi bi-check-circle me-1"></i> Approve
              <% end %>
            <% end %>
          <% end %>
          <% if can_reject %>
            <%= form_with url: reject_membership_application_path(@application), method: :post, local: true do %>
              <input type="hidden" name="admin_notes" id="reject_admin_notes" value="">
              <button type="submit" class="btn btn-danger review-btn"
                      data-turbo-confirm="Reject this application?">
                <i class="bi bi-x-circle me-1"></i> Reject
              </button>
            <% end %>
          <% end %>
          <% if can_park %>
            <%= form_with url: delay_for_review_membership_application_path(@application), method: :post, local: true do %>
              <input type="hidden" name="admin_notes" id="delay_admin_notes" value="">
              <button type="submit" class="btn btn-outline-warning review-btn"
                      data-turbo-confirm="Mark this application as under review?">
                <i class="bi bi-hourglass-split me-1"></i> Delay for review
              </button>
            <% end %>
            <%= form_with url: mark_needs_review_membership_application_path(@application), method: :post, local: true do %>
              <input type="hidden" name="admin_notes" id="needs_review_admin_notes" value="">
              <button type="submit" class="btn btn-outline-secondary review-btn"
                      data-turbo-confirm="Park this application as needs review? It will not trigger reminders or acceptance votes.">
                <i class="bi bi-pause-circle me-1"></i> Needs review
              </button>
            <% end %>
          <% end %>
        </div>
        <% if @application.needs_review? %>
          <p class="text-muted small mb-0 mt-3">
            Parked as needs review. This application will not appear in stale reminders or acceptance votes until you approve or reject it.
          </p>
        <% end %>
      <% else %>
        <p class="text-muted mb-0">
          You do not have permission to approve, reject, or park applications.
          Use admin acceptance votes above to record your recommendation.
        </p>
      <% end %>
    </div>
  </div>

  <% if can_decide %>
    <script>
      (function() {
        function initReviewForm() {
          var notes = document.getElementById('admin_notes');
          if (!notes) return;
          document.querySelectorAll('.review-btn').forEach(function(btn) {
            btn.addEventListener('click', function() {
              var form = btn.closest('form');
              var hidden = form.querySelector('input[name="admin_notes"]');
              if (hidden) hidden.value = notes.value;
            });
          });
        }
        document.addEventListener('DOMContentLoaded', initReviewForm);
        document.addEventListener('turbo:load', initReviewForm);
      })();
    </script>
  <% end %>
<% end %>

</div><%# .membership-application-show %>
